<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>CANCHERO</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#baff00">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Canchero">
    <link rel="apple-touch-icon" href="logo.png">
    <link rel="apple-touch-icon" sizes="152x152" href="logo.png">
    <link rel="apple-touch-icon" sizes="180x180" href="logo.png">
    <link rel="apple-touch-startup-image" href="logo.png">
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js');
        }
    </script>

    <link rel="stylesheet" href="style.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>

<body class="is-home">
    <nav class="navbar fs-style" id="main-nav">
        <div class="nav-left">
            <div class="nav-brand" onclick="navigate('home')" style="cursor:pointer;"><img src="logo-oficial.png" onerror="this.src='logo.png'" style="height: 54px; object-fit: contain;"></div>
            <ul class="nav-menu">
                <li><a href="#" class="nav-link active" onclick="navigate('home')">INICIO</a></li>
                <li id="nav-mi-panel" style="display:none;"><a href="#" class="nav-link" onclick="navigatePanel()">MI PANEL</a></li>
                <li class="nav-directory"><a href="#" class="nav-link" onclick="openDirectorioModal('complejos')">COMPLEJOS</a></li>
                <li class="nav-directory"><a href="#" class="nav-link" onclick="openDirectorioModal('jugadores')">JUGADORES</a></li>
                <li class="nav-directory"><a href="#" class="nav-link" onclick="openDirectorioModal('servicios')">SERVICIOS</a></li>
                <li class="nav-directory"><a href="#" class="nav-link" onclick="openDirectorioModal('eventos')">EVENTOS</a></li>
                <li class="nav-directory"><a href="#" class="nav-link" onclick="openDirectorioModal('tienda')">TIENDA</a></li>
            </ul>
        </div>
        <div class="nav-actions">
            <!-- Notification bell (visible when logged in) -->
            <div id="notif-bell-wrap" style="display:none; position:relative;">
                <button id="notif-bell-btn" onclick="notif.togglePanel()" style="background:none;border:none;cursor:pointer;color:#fff;padding:6px;position:relative;font-size:22px;display:flex;align-items:center;">
                    <i class='bx bx-bell' id="notif-bell-icon"></i>
                    <span id="notif-badge" style="display:none;position:absolute;top:2px;right:2px;background:#ff4444;color:#fff;font-size:9px;font-weight:900;width:16px;height:16px;border-radius:50%;display:none;align-items:center;justify-content:center;line-height:1;">0</span>
                </button>
                <div id="notif-panel" style="display:none;position:absolute;right:0;top:48px;width:320px;max-height:420px;background:var(--bg2,#0f110f);border:1px solid var(--border-color,#1e201e);border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,0.5);z-index:9999;overflow:hidden;flex-direction:column;">
                    <div style="padding:14px 16px;border-bottom:1px solid var(--border-color,#1e201e);display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-weight:700;font-size:13px;">Notificaciones</span>
                        <button onclick="notif.markAllRead()" style="background:none;border:none;color:#baff00;cursor:pointer;font-size:11px;font-weight:700;">Marcar todo leÃ­do</button>
                    </div>
                    <div id="notif-list" style="overflow-y:auto;max-height:340px;"></div>
                </div>
            </div>
            <button id="btn-nav-login" class="btn btn-fs-login" onclick="openEntrarModal()">ENTRAR</button>
            <button id="btn-nav-register" class="btn btn-fs-register" onclick="openRegistrarseModal()">REGISTRO</button>
            <button id="btn-download-app" class="btn btn-fs-register" style="background:#baff00;color:#000;display:inline-flex;align-items:center;gap:5px;border:none;cursor:pointer;font-weight:900;" onclick="smartDownload()"><i class='bx bxl-android' id="download-icon" style="margin:0!important;"></i> <span id="download-label">DESCARGAR</span></button>
            <button id="btn-hamburger" class="btn btn-fs-login" style="display:none; padding: 6px !important;" onclick="toggleMobileMenu()"><i class='bx bx-menu' style="font-size:24px; margin:0 !important;"></i></button>
        </div>

    </nav>
    <!-- ==================== VIEW: HOME ==================== -->
    <section id="view-home" class="view-section">
      <div class="home-viewport-wrap">
        <div class="landing-hero-full">
            <div class="fs-hero-container" style="position:relative;">

                <!-- HERO CTA â€” izquierda-centro, parte baja -->
                <div class="hero-cta-wrap">
                    <div class="fs-side-actions" style="gap:14px;">
                        <!-- JUGADOR -->
                        <button id="hero-btn-jugador" class="btn-fs-action" style="border:none;cursor:pointer;text-align:left;">
                            <i class='bx bx-run'></i>
                            <div class="fs-btn-text">
                                <div class="fs-btn-subtitle">ENTRÃ COMO</div>
                                <div class="fs-btn-title">JUGADOR</div>
                            </div>
                        </button>
                        <!-- NEGOCIO -->
                        <button id="hero-btn-negocio" class="btn-fs-action" style="border:none;cursor:pointer;text-align:left;">
                            <i class='bx bx-buildings'></i>
                            <div class="fs-btn-text">
                                <div class="fs-btn-subtitle">ACCEDÃ‰ COMO</div>
                                <div class="fs-btn-title">NEGOCIO</div>
                            </div>
                        </button>
                    </div>
                </div>
                </div>

            </div>
        </div>

        <!-- SPONSORS BAND â€” visible sin scrollear -->
        <div class="home-sponsors-band">
            <div class="sponsors-band-inner">
                <div class="sponsors-band-slots">
                    <div class="sponsor-slot-sm"><i class='bx bx-plus'></i><span>Tu marca</span></div>
                    <div class="sponsor-slot-sm"><i class='bx bx-plus'></i><span>Tu marca</span></div>
                    <div class="sponsor-slot-sm"><i class='bx bx-plus'></i><span>Tu marca</span></div>
                </div>
                <div class="sponsors-band-cta">
                    <div class="sponsors-band-text">
                        <span class="sbt-tag">SPONSORS &amp; PARTNERS</span>
                        <span class="sbt-title">LlegÃ¡ a miles de jugadores uruguayos</span>
                    </div>
                    <a href="#" class="sbt-btn"><i class='bx bx-envelope'></i> QUIERO SER SPONSOR</a>
                </div>
            </div>
        </div>
      </div>
    </section>

    <!-- ==================== DIRECTORIO MODAL ==================== -->
    <div id="directorio-modal" style="display:none;position:fixed;inset:0;z-index:8000;background:#070907;flex-direction:column;">
        <div class="dir-modal-nav">
            <button onclick="closeDirectorioModal()" style="background:none;border:none;color:#fff;cursor:pointer;font-size:22px;padding:4px;"><i class='bx bx-arrow-back'></i></button>
            <div id="dir-breadcrumb" style="font-size:13px;color:#888;display:flex;align-items:center;gap:6px;"></div>
            <div style="width:30px;"></div>
        </div>
        <div id="dir-modal-body" style="flex:1;overflow:hidden;display:flex;flex-direction:column;"></div>
    </div>

    <!-- ==================== VIEW: LOGIN ==================== -->
    <section id="view-login" class="view-section" style="display: none;">
        <div class="landing-hero-full">
            <div class="fs-form-card">
                <h2 class="fs-form-title">INICIAR SESIÃ“N</h2>

                <button class="btn-google" onclick="handleGoogleAuth()">
                    <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    CONTINUAR CON GOOGLE
                </button>

                <div class="auth-divider">O CON EMAIL</div>

                <div class="form-group">
                    <label class="form-label">CORREO ELECTRÃ“NICO</label>
                    <input type="email" class="form-control fs-input" id="login-email" placeholder="ejemplo@canchero.com">
                </div>
                <div class="form-group">
                    <label class="form-label">CONTRASEÃ‘A</label>
                    <input type="password" class="form-control fs-input" id="login-pass" placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢">
                </div>
                <button class="btn-fs-login" style="width: 100%; margin-top: 20px;" onclick="handleLogin()">ENTRAR</button>
                <p style="text-align: center; margin-top: 15px; font-size: 12px;">Â¿No tienes cuenta? <a href="#" onclick="navigate('register')">REGÃSTRATE AQUÃ</a></p>
            </div>
        </div>
    </section>

    <!-- ==================== VIEW: REGISTER (ONBOARDING) ==================== -->
    <section id="view-register" class="view-section" style="display: none;">
        <div class="landing-hero-full">
            <div class="fs-form-card register-card">
                <div class="onboarding-progress">
                    <div class="progress-bar" id="reg-progress" style="width: 20%;"></div>
                </div>
                
                <h2 class="fs-form-title" id="reg-step-title">PASO 1: CUENTA</h2>
                
                <!-- STEP 1: ACCOUNT -->
                <div class="reg-step active" id="reg-step-1">
                    <!-- Google quick register -->
                    <button class="btn-google" onclick="handleGoogleAuth()" style="margin-bottom:16px;">
                        <svg viewBox="0 0 24 24" style="width:18px;height:18px;"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        REGISTRARSE CON GOOGLE
                    </button>
                    <div class="auth-divider">O CON EMAIL</div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label class="form-label">Â¿CÃ“MO VAS A USAR CANCHERO?</label>
                        <div class="type-grid" id="reg-type-grid">
                            <div class="type-card active" onclick="setRegRole('jugador', this)" data-role="jugador">
                                <i class='bx bx-run'></i>
                                <span class="type-label">Jugador</span>
                                <span class="type-sublabel">Gratis</span>
                            </div>
                            <div class="type-card" onclick="setRegRole('club', this)" data-role="club">
                                <i class='bx bx-building-house'></i>
                                <span class="type-label">Complejo</span>
                                <span class="type-sublabel">Pago</span>
                            </div>
                            <div class="type-card" onclick="setRegRole('profesional', this)" data-role="profesional">
                                <i class='bx bx-id-card'></i>
                                <span class="type-label">Profesional</span>
                                <span class="type-sublabel">Pago</span>
                            </div>
                            <div class="type-card" onclick="setRegRole('organizacion', this)" data-role="organizacion">
                                <i class='bx bx-shield'></i>
                                <span class="type-label">OrganizaciÃ³n</span>
                                <span class="type-sublabel">Pago</span>
                            </div>
                            <div class="type-card" onclick="setRegRole('tienda', this)" data-role="tienda">
                                <i class='bx bx-store'></i>
                                <span class="type-label">Tienda</span>
                                <span class="type-sublabel">Pago</span>
                            </div>
                            <div class="type-card" onclick="setRegRole('sponsor', this)" data-role="sponsor">
                                <i class='bx bx-dollar-circle'></i>
                                <span class="type-label">Sponsor</span>
                                <span class="type-sublabel">Pago</span>
                            </div>
                        </div>
                        <p id="reg-role-info" style="font-size:11px; color:#888; margin-top:6px;">Los jugadores pueden acceder gratis. El resto requiere aprobaciÃ³n y suscripciÃ³n.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" id="label-reg-name">NOMBRE COMPLETO</label>
                        <input type="text" class="form-control fs-input" id="reg-name" placeholder="Ej: Juan PÃ©rez">
                    </div>
                    <!-- Profesional sub-type -->
                    <div class="form-group" id="reg-prof-type-group" style="display:none;">
                        <label class="form-label">ROL PROFESIONAL</label>
                        <div class="prof-type-selector">
                            <div class="prof-type-btn active" onclick="setRegProfType('arbitro', this)"><i class='bx bx-flag'></i> Ãrbitro</div>
                            <div class="prof-type-btn" onclick="setRegProfType('tecnico', this)"><i class='bx bx-chalkboard'></i> TÃ©cnico/DT</div>
                            <div class="prof-type-btn" onclick="setRegProfType('preparador', this)"><i class='bx bx-dumbbell'></i> Prep. FÃ­sico</div>
                            <div class="prof-type-btn" onclick="setRegProfType('nutricionista', this)"><i class='bx bx-leaf'></i> Nutricionista</div>
                            <div class="prof-type-btn" onclick="setRegProfType('medico', this)"><i class='bx bx-plus-medical'></i> MÃ©dico</div>
                            <div class="prof-type-btn" onclick="setRegProfType('scout', this)"><i class='bx bx-search'></i> Ojeador</div>
                        </div>
                    </div>
                    <!-- Org sub-type -->
                    <div class="form-group" id="reg-org-type-group" style="display:none;">
                        <label class="form-label">TIPO DE ORGANIZACIÃ“N</label>
                        <div class="prof-type-selector">
                            <div class="prof-type-btn active" onclick="setRegOrgType('club', this)"><i class='bx bx-shield'></i> Club Deportivo</div>
                            <div class="prof-type-btn" onclick="setRegOrgType('liga', this)"><i class='bx bx-trophy'></i> Liga / AsociaciÃ³n</div>
                            <div class="prof-type-btn" onclick="setRegOrgType('escuela', this)"><i class='bx bx-graduation'></i> Escuela FÃºtbol</div>
                            <div class="prof-type-btn" onclick="setRegOrgType('eventos', this)"><i class='bx bx-calendar-event'></i> Organiz. Eventos</div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">CORREO ELECTRÃ“NICO</label>
                        <input type="email" class="form-control fs-input" id="reg-email" placeholder="email@ejemplo.com">
                    </div>
                    <div class="form-group">
                        <label class="form-label">CONTRASEÃ‘A</label>
                        <input type="password" class="form-control fs-input" id="reg-pass" placeholder="â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢">
                    </div>
                </div>

                <!-- STEP 2: PERSONAL INFO -->
                <div class="reg-step" id="reg-step-2" style="display:none;">
                    <div class="form-group player-only">
                        <label class="form-label">FECHA DE NACIMIENTO</label>
                        <div style="display: flex; gap: 10px;">
                            <select class="form-control fs-input" id="reg-birth-day" style="flex: 1; min-width: 60px;"></select>
                            <select class="form-control fs-input" id="reg-birth-month" style="flex: 1.5; min-width: 90px;"></select>
                            <select class="form-control fs-input" id="reg-birth-year" style="flex: 1.2; min-width: 80px;"></select>
                        </div>
                    </div>
                    <div class="form-group player-only">
                        <label class="form-label">GÃ‰NERO</label>
                        <div class="gender-selector">
                            <button type="button" class="btn btn-glass active" onclick="setGender('Masculino', this)">MASCULINO</button>
                            <button type="button" class="btn btn-glass" onclick="setGender('Femenino', this)">FEMENINO</button>
                            <button type="button" class="btn btn-glass" onclick="setGender('Otro', this)">OTRO</button>
                        </div>
                    </div>
                    <div class="form-group player-only">
                        <label class="form-label">CÃ‰DULA DE IDENTIDAD</label>
                        <input type="text" class="form-control fs-input" id="reg-id" placeholder="1.234.567-8">
                    </div>
                    
                    <!-- CLUB/COMPLEX ONLY FIELDS -->
                    <div class="form-group club-only" style="display:none;">
                        <label class="form-label">NOMBRE DEL PROPIETARIO</label>
                        <input type="text" class="form-control fs-input" id="reg-complex-owner" placeholder="Ej: Carlos Silva">
                    </div>
                    <div class="form-group club-only" style="display:none;">
                        <label class="form-label">NOMBRE DEL COMPLEJO</label>
                        <input type="text" class="form-control fs-input" id="reg-complex-name" placeholder="Ej: MaracanÃ¡ FÃºtbol 5">
                    </div>
                    <div class="form-group club-only" style="display:none;">
                        <label class="form-label">RUT / NÃšMERO DE REGISTRO COMERCIAL</label>
                        <input type="text" class="form-control fs-input" id="reg-complex-rut" placeholder="Ej: 219999990012">
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">CELULAR DE CONTACTO</label>
                        <input type="tel" class="form-control fs-input" id="reg-phone" placeholder="099 123 456">
                    </div>
                </div>

                <!-- STEP 3: SPORTS PROFILE (OR COMPLEX INFO) -->
                <div class="reg-step" id="reg-step-3" style="display:none;">
                    <!-- PLAYER ONLY FIELDS -->
                    <div class="fs-form-grid player-only">
                        <div class="form-group">
                            <label class="form-label">POSICIÃ“N PRINCIPAL</label>
                            <select class="form-control fs-input" id="reg-pos">
                                <option value="Arquero">ARQUERO</option>
                                <option value="Defensa">DEFENSA</option>
                                <option value="Mediocampo">MEDIOCAMPO</option>
                                <option value="Delantero">DELANTERO</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">PIERNA HÃBIL</label>
                            <select class="form-control fs-input" id="reg-foot">
                                <option value="Derecha">DERECHA</option>
                                <option value="Izquierda">IZQUIERDA</option>
                                <option value="Ambidiestro">AMBIDIESTRO</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- CLUB/COMPLEX ONLY FIELDS -->
                    <div class="fs-form-grid club-only" style="display:none;">
                        <div class="form-group">
                            <label class="form-label">DIRECCIÃ“N DEL COMPLEJO</label>
                            <input type="text" class="form-control fs-input" id="reg-complex-address" placeholder="Ej: Av. Italia 1234">
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label class="form-label">CANTIDAD DE CANCHAS POR TIPO</label>
                            <div style="display:flex; gap:10px;">
                                <input type="number" class="form-control fs-input" id="reg-complex-f5" placeholder="F5" min="0" title="Canchas de FÃºtbol 5">
                                <input type="number" class="form-control fs-input" id="reg-complex-f7" placeholder="F7" min="0" title="Canchas de FÃºtbol 7">
                                <input type="number" class="form-control fs-input" id="reg-complex-f11" placeholder="F11" min="0" title="Canchas de FÃºtbol 11">
                            </div>
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label class="form-label">REDES SOCIALES (Instagram / Web)</label>
                            <input type="text" class="form-control fs-input" id="reg-complex-social" placeholder="Ej: @tu_complejo o tuweb.com">
                        </div>
                    </div>

                    <div class="fs-form-grid">
                        <div class="form-group">
                            <label class="form-label">PAÃS</label>
                            <select class="form-control fs-input" id="reg-nat" onchange="updateCityOptions()">
                                <option value="Uruguay">URUGUAY</option>
                                <option value="Argentina">ARGENTINA</option>
                                <option value="Brasil">BRASIL</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">DEPARTAMENTO</label>
                            <select class="form-control fs-input" id="reg-city"></select>
                        </div>
                    </div>
                    
                    <div class="form-group player-only" style="margin-top:15px;">
                        <label class="form-label">MODALIDAD PREFERIDA</label>
                        <div class="type-selector" id="reg-f-type">
                            <div class="type-btn active" onclick="toggleFType('F5', this)">F5</div>
                            <div class="type-btn" onclick="toggleFType('F7', this)">F7</div>
                            <div class="type-btn" onclick="toggleFType('F11', this)">F11</div>
                        </div>
                    </div>
                    
                    <div class="form-group club-only" style="margin-top:15px; display:none;">
                        <label class="form-label">SERVICIOS ADICIONALES</label>
                        <div style="display:flex; gap:15px; flex-wrap:wrap; background: rgba(0,0,0,0.2); padding: 10px; border-radius: 6px;">
                            <label style="display:flex; align-items:center; gap:8px; font-size:12px; cursor:pointer;"><input type="checkbox" id="srv-vestuario" style="accent-color: var(--accent);"> Vestuarios</label>
                            <label style="display:flex; align-items:center; gap:8px; font-size:12px; cursor:pointer;"><input type="checkbox" id="srv-cantina" style="accent-color: var(--accent);"> Cantina</label>
                            <label style="display:flex; align-items:center; gap:8px; font-size:12px; cursor:pointer;"><input type="checkbox" id="srv-parking" style="accent-color: var(--accent);"> Estacionamiento</label>
