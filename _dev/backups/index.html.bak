                <h2 class="fs-form-title" style="margin:0; font-size:24px;">SUBIR HISTORIA</h2>
                <button class="btn-glass" onclick="closeStoryModal()" style="width:40px; height:40px; border-radius:50%; padding:0;"><i class='bx bx-x'></i></button>
            </div>

            <div id="story-preview-container" style="width:100%; max-width:280px; aspect-ratio:9/16; background:#000; border-radius:12px; overflow:hidden; position:relative; border:2px solid var(--accent); margin: 0 auto;">
                <video id="story-camera-stream" autoplay playsinline style="width:100%; height:100%; object-fit:cover; display:none;"></video>
                <canvas id="story-capture-canvas" style="display:none;"></canvas>
                <img id="story-image-preview" style="width:100%; height:100%; object-fit:cover; display:none;">
                <div id="story-text-overlay" style="position:absolute; top:20%; left:50%; transform:translate(-50%, -50%) scale(1); width:90%; text-align:center; font-size:18px; font-weight:900; color:#fff; text-shadow: 2px 2px 10px rgba(0,0,0,0.8); cursor:grab; pointer-events:auto;" onmousedown="dragStoryText(event)" ontouchstart="dragStoryText(event)"></div>
                
                <div id="story-placeholder" style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:var(--text-muted);">
                    <i class='bx bx-camera' style="font-size:48px; margin-bottom:10px;"></i>
                    <p style="font-size:12px;">Captura o selecciona</p>
                </div>

                <!-- Zoom controls -->
                <div id="story-zoom-controls" style="display:none; position:absolute; bottom:10px; right:10px; z-index:10; display:none; flex-direction:column; gap:5px;">
                    <button onclick="zoomStoryMedia(0.2)" style="width:32px; height:32px; border-radius:50%; border:1px solid var(--accent); background:rgba(0,0,0,0.7); color:var(--accent); font-size:18px; cursor:pointer; font-weight:900;">+</button>
                    <button onclick="zoomStoryMedia(-0.2)" style="width:32px; height:32px; border-radius:50%; border:1px solid var(--accent); background:rgba(0,0,0,0.7); color:var(--accent); font-size:18px; cursor:pointer; font-weight:900;">âˆ’</button>
                    <button onclick="resetStoryMediaZoom()" style="width:32px; height:32px; border-radius:50%; border:1px solid #555; background:rgba(0,0,0,0.7); color:#fff; font-size:12px; cursor:pointer; font-weight:700;">R</button>
                </div>
            </div>

            <div class="form-group" style="margin-top:15px;">
                <label class="form-label">TEXTO DE LA HISTORIA</label>
                <input type="text" class="form-control fs-input" id="story-text-input" placeholder="Escribe algo..." oninput="updateStoryText()" style="font-weight:700;">
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:20px;">
                <button class="btn btn-glass" onclick="startStoryCamera()"><i class='bx bx-camera'></i> ABRIR CÃMARA</button>
                <button class="btn btn-glass" onclick="document.getElementById('story-file-upload').click()"><i class='bx bx-upload'></i> SUBIR ARCHIVO</button>
                <input type="file" id="story-file-upload" style="display:none;" accept="image/*,video/*" onchange="const file = this.files[0]; if(file){ const reader = new FileReader(); reader.onload = (e) => { const img = document.getElementById('story-image-preview'); img.src = e.target.result; img.style.display = 'block'; document.getElementById('story-placeholder').style.display = 'none'; document.getElementById('story-camera-controls').style.display = 'flex'; document.getElementById('story-zoom-controls').style.display = 'flex'; document.getElementById('story-publish-btn').style.display = 'block'; initStoryInteractions(); }; reader.readAsDataURL(file); }">
            </div>

            <div id="story-camera-controls" style="display:none; margin-top:15px; flex-direction:column; gap:10px;">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <button class="btn btn-primary" onclick="captureStoryPhoto()"><i class='bx bx-camera'></i> TOMAR FOTO</button>
                    <button id="story-record-btn" class="btn btn-glass" style="color:#ff4d4d;" onclick="toggleStoryVideo()"><i class='bx bx-video-recording'></i> GRABAR VIDEO</button>
                </div>
                <div id="recording-indicator" style="display:none; align-items:center; justify-content:center; gap:8px; color:#ff4d4d; font-weight:bold; font-size:12px;">
                    <span style="width:10px; height:10px; background:#ff4d4d; border-radius:50%; animation: pulse 1s infinite;"></span> GRABANDO... <span id="recording-timer">0s</span>
                </div>
            </div>

            <button id="story-publish-btn" class="btn btn-primary" style="width:100%; margin-top:20px; display:none; height:50px; font-weight:900;" onclick="publishStory()">PUBLICAR EN HISTORIA</button>
        </div>
    </div>

