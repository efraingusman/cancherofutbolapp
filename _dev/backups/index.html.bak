    </div>

    <!-- ==================== MODAL: SOLICITUD ENVIADA / PENDIENTE ==================== -->
    <div id="pending-modal" class="terms-modal-overlay" style="display:none;">
        <div class="terms-modal-card" style="max-height: none;">
            <div style="padding:30px 24px; text-align:center;">
                <div style="width:70px;height:70px;background:rgba(255,180,0,0.1);border:2px solid #ffb400;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                    <i class='bx bx-time' style="font-size:32px; color:#ffb400;"></i>
                </div>
                <h2 style="font-family:var(--font-display); color:#ffb400; margin-bottom:10px;">SOLICITUD ENVIADA</h2>
                <p style="color:#bbb; font-size:13px; line-height:1.7; margin-bottom:20px;">
                    Tu solicitud fue recibida. El equipo de Canchero la revisarÃ¡ en un plazo de <strong style="color:#fff;">24-48 horas hÃ¡biles</strong>.<br><br>
                    Cuando sea aprobada, recibirÃ¡s un email con los prÃ³ximos pasos para activar tu cuenta y comenzar tus <strong style="color:var(--accent);">7 dÃ­as de prueba gratuita</strong>.
                </p>
                <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:15px; margin-bottom:20px; text-align:left;">
                    <div style="font-size:11px; color:#888; margin-bottom:8px; font-weight:700; text-transform:uppercase;">RESUMEN DE TU SOLICITUD</div>
                    <div id="pending-summary" style="font-size:12px; color:#ccc; line-height:1.8;"></div>
                </div>
                <button class="btn btn-primary" style="width:100%;" onclick="document.getElementById('pending-modal').style.display='none'; navigate('home');">
                    ENTENDIDO, VOLVER AL INICIO
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL: GOOGLE â€” ELEGIR ROL ==================== -->
    <div id="google-role-modal" class="terms-modal-overlay" style="display:none;">
        <div class="terms-modal-card" style="max-height:none;">
            <div style="padding:24px;">
                <h2 style="font-family:var(--font-display); color:var(--accent); text-align:center; margin-bottom:6px;">Â¡BIENVENIDO A CANCHERO!</h2>
                <p style="text-align:center; color:#888; font-size:12px; margin-bottom:20px;">ElegÃ­ cÃ³mo vas a usar la plataforma para personalizar tu experiencia:</p>
                <div class="type-grid" id="google-role-grid">
                    <div class="type-card active" onclick="selectGoogleRole('jugador', this)">
                        <i class='bx bx-run'></i>
                        <span class="type-label">Jugador</span>
                        <span class="type-sublabel">Gratis</span>
                    </div>
                    <div class="type-card" onclick="selectGoogleRole('club', this)">
                        <i class='bx bx-building-house'></i>
                        <span class="type-label">Complejo</span>
                        <span class="type-sublabel">Pago</span>
                    </div>
                    <div class="type-card" onclick="selectGoogleRole('profesional', this)">
                        <i class='bx bx-id-card'></i>
                        <span class="type-label">Profesional</span>
                        <span class="type-sublabel">Pago</span>
                    </div>
                    <div class="type-card" onclick="selectGoogleRole('organizacion', this)">
                        <i class='bx bx-shield'></i>
                        <span class="type-label">OrganizaciÃ³n</span>
                        <span class="type-sublabel">Pago</span>
                    </div>
                    <div class="type-card" onclick="selectGoogleRole('tienda', this)">
                        <i class='bx bx-store'></i>
                        <span class="type-label">Tienda</span>
                        <span class="type-sublabel">Pago</span>
                    </div>
                    <div class="type-card" onclick="selectGoogleRole('sponsor', this)">
                        <i class='bx bx-dollar-circle'></i>
                        <span class="type-label">Sponsor</span>
                        <span class="type-sublabel">Pago</span>
                    </div>
                </div>
                <button class="btn btn-primary" style="width:100%; margin-top:20px;" onclick="confirmGoogleRole()">
                    <i class='bx bx-check'></i> CONFIRMAR Y ENTRAR
                </button>
            </div>
        </div>
    </div>

    <script src="script.js" charset="utf-8"></script>
    <script src="canchero-plus.js" charset="utf-8"></script>
    <script src="canchero-features.js" charset="utf-8"></script>
    <script>
    (function() {
        function showView(viewId) {
            try {
                document.querySelectorAll('.view-section').forEach(function(v){ v.style.display='none'; });
                var t = document.getElementById('view-'+viewId);
                if(t) t.style.display='block';
                window.location.hash = viewId;
                window.scrollTo(0,0);
                if(typeof window.navigate==='function') { try { window.navigate(viewId); } catch(e){} }
            } catch(e){ console.error('showView error:',e); }
        }

        // Open NEGOCIO dropdown â€” pure HTML, no JS modal dependency
        function openNegocioInline() {
            var existing = document.getElementById('negocio-inline-modal');
            if(existing) { existing.remove(); return; }
            var modal = document.createElement('div');
            modal.id = 'negocio-inline-modal';
            modal.style.cssText='position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.88);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:18px;';
            modal.innerHTML='<div style="background:#0f110f;border:1px solid rgba(186,255,0,0.2);border-radius:18px;width:100%;max-width:460px;overflow:hidden;">'+
              '<div style="padding:20px 22px 6px;display:flex;justify-content:space-between;align-items:flex-start;">'+
                '<div><div style="font-size:10px;letter-spacing:2px;color:#baff00;font-weight:800;">ACCESO NEGOCIOS</div>'+
                '<div style="font-size:18px;font-weight:900;color:#fff;font-family:Outfit,sans-serif;margin-top:4px;">Â¿QuÃ© tipo de negocio sos?</div></div>'+
                '<button id="neg-close" style="background:rgba(255,255,255,0.06);border:none;color:#fff;width:30px;height:30px;border-radius:50%;cursor:pointer;font-size:18px;">&times;</button>'+
              '</div>'+
              '<div style="padding:14px 22px 22px;display:flex;flex-direction:column;gap:9px;">'+
                bizItem('complejo','bx-building-house','Complejo','Canchas, reservas, calendario','club')+
                bizItem('profesional','bx-id-card','Profesional','DT, Ã¡rbitro, preparador...','profesional')+
                bizItem('organizacion','bx-trophy','OrganizaciÃ³n','Club, liga, escuela...','organizacion')+
                bizItem('tienda','bx-store','Tienda','Productos deportivos','tienda')+
                '<div style="border-top:1px solid #1a1a1a;padding-top:12px;margin-top:4px;display:flex;flex-direction:column;gap:8px;">'+
                  '<button data-action="login-biz" style="background:transparent;border:1px solid rgba(186,255,0,0.25);color:#baff00;padding:11px;border-radius:12px;font-weight:800;font-size:12px;cursor:pointer;">YA TENGO CUENTA â†’ INICIAR SESIÃ“N</button>'+
                '</div>'+
              '</div></div>';
            document.body.appendChild(modal);

            modal.addEventListener('click', function(e){
                if(e.target === modal || e.target.id==='neg-close') { modal.remove(); return; }
                var role = e.target.closest('[data-role]');
                if(role) {
                    var r = role.getAttribute('data-role');
                    modal.remove();
                    showView('register');
                    setTimeout(function(){
                        if(typeof window.setRegRole === 'function') {
                            var card = document.querySelector('.type-card[data-role="'+r+'"]');
                            if(card) window.setRegRole(r, card);
                        }
                    }, 100);
                    return;
                }
                if(e.target.closest('[data-action="login-biz"]')) {
                    modal.remove();
                    showView('login');
                }
            });
        }
        function bizItem(id, icon, label, sub, role) {
            return '<button data-role="'+role+'" style="display:flex;align-items:center;gap:13px;background:rgba(255,255,255,0.03);border:1px solid #1e201e;border-radius:12px;padding:13px 16px;cursor:pointer;color:#fff;text-align:left;width:100%;font-family:inherit;">'+
              '<div style="width:38px;height:38px;background:rgba(186,255,0,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bx '+icon+'" style="font-size:19px;color:#baff00;"></i></div>'+
              '<div style="flex:1;"><div style="font-weight:800;font-size:14px;font-family:Outfit,sans-serif;">'+label+'</div><div style="font-size:10px;color:#666;margin-top:1px;">'+sub+'</div></div>'+
              '<i class="bx bx-chevron-right" style="color:#444;font-size:18px;pointer-events:none;"></i>'+
            '</button>';
        }

        function wireBtn(id, fn) {
            var el = document.getElementById(id);
            if (el) { el.addEventListener('click', fn); el.style.cursor='pointer'; }
        }

        wireBtn('hero-btn-jugador', function(e){ e.preventDefault(); showView('login'); });
        wireBtn('hero-btn-negocio', function(e){ e.preventDefault(); openNegocioInline(); });
        wireBtn('hero-btn-sponsor', function(e){ e.preventDefault(); openSponsorSurvey(); });
        wireBtn('btn-download-app', function(e){ e.preventDefault(); try{ window.smartDownload && window.smartDownload(); }catch(err){} });

        // â”€â”€ SPONSOR SURVEY (envÃ­a a email + Supabase) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        function openSponsorSurvey() {
            var existing = document.getElementById('sponsor-survey-modal');
            if(existing) { existing.remove(); return; }
            var modal = document.createElement('div');
            modal.id = 'sponsor-survey-modal';
            modal.style.cssText='position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.92);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;padding:14px;overflow-y:auto;';
            modal.innerHTML =
              '<div style="background:#0f110f;border:1px solid rgba(186,255,0,0.3);border-radius:18px;width:100%;max-width:520px;max-height:92vh;overflow-y:auto;">'+
                '<div style="background:linear-gradient(135deg,rgba(186,255,0,0.12),rgba(186,255,0,0.02));padding:22px 22px 16px;display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #1e201e;">'+
                  '<div>'+
                    '<div style="font-size:10px;letter-spacing:2px;color:#baff00;font-weight:800;">PROMOCIONÃ TU MARCA</div>'+
                    '<div style="font-size:20px;font-weight:900;color:#fff;font-family:Outfit,sans-serif;margin-top:5px;line-height:1.2;">LlegÃ¡ a miles de<br>jugadores uruguayos ðŸ‡ºðŸ‡¾</div>'+
                    '<div style="font-size:11px;color:#888;margin-top:8px;line-height:1.5;">CompletÃ¡ el formulario y nuestro equipo te contacta en menos de 24hs con propuestas a medida.</div>'+
                  '</div>'+
                  '<button id="spnclose" style="background:rgba(255,255,255,0.06);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:20px;flex-shrink:0;">&times;</button>'+
                '</div>'+
                '<form id="sponsor-survey-form" style="padding:18px 22px 22px;display:flex;flex-direction:column;gap:12px;">'+
                  field('Empresa / Marca *','company','text','Ej: Mi Marca S.A.',true)+
                  field('Persona de contacto','contact','text','Tu nombre',false)+
                  field('Email *','email','email','tu@empresa.com',true)+
                  field('TelÃ©fono / WhatsApp','phone','tel','+598 99 123 456',false)+
                  selectField('Tipo de campaÃ±a','type',['Banner en la app','PublicaciÃ³n patrocinada','Sponsor de torneo/evento','ActivaciÃ³n en complejos','Combo personalizado']) +
                  selectField('Presupuesto aproximado (USD)','budget',['Menos de 200','200 - 500','500 - 1.500','1.500 - 5.000','MÃ¡s de 5.000','Quiero asesoramiento']) +
                  '<div><label style="font-size:10px;color:#888;font-weight:800;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px;">Contanos quÃ© buscÃ¡s</label>'+
                  '<textarea name="message" rows="3" placeholder="QuerÃ©s llegar a jugadores de cierta zona, ligas amateurs, etc..." style="width:100%;background:#0a0a0a;border:1px solid #222;border-radius:10px;color:#fff;padding:11px 13px;font-size:13px;outline:none;font-family:inherit;resize:vertical;"></textarea></div>'+
                  '<button type="submit" style="margin-top:6px;background:linear-gradient(135deg,#baff00,#7ace00);color:#000;border:none;padding:14px;border-radius:12px;font-weight:900;font-size:13px;letter-spacing:1px;cursor:pointer;box-shadow:0 4px 18px rgba(186,255,0,0.3);">ðŸ“¨ ENVIAR SOLICITUD</button>'+
                  '<div style="text-align:center;font-size:10px;color:#666;margin-top:4px;">O escribinos directo por WhatsApp <a href="https://wa.me/59896528701" target="_blank" style="color:#baff00;text-decoration:none;font-weight:800;">+598 96 528 701</a></div>'+
                '</form>'+
              '</div>';
            document.body.appendChild(modal);

            modal.addEventListener('click', function(e){
                if(e.target === modal || e.target.id === 'spnclose') modal.remove();
            });
            document.getElementById('sponsor-survey-form').addEventListener('submit', async function(e){
                e.preventDefault();
                var fd = new FormData(e.target);
                var payload = {};
                fd.forEach(function(v,k){ payload[k]=v; });
                var btn = e.target.querySelector('button[type=submit]');
                btn.disabled = true; btn.innerHTML = 'â³ ENVIANDO...';
                try {
                    var r = await fetch('/api/sponsor-submit', {
                        method:'POST',
                        headers:{'Content-Type':'application/json'},
                        body: JSON.stringify(payload)
                    });
                    var data = await r.json();
                    // Save to Supabase too (admin dashboard)
                    try {
                        var sb = window.supabase && window.supabase.createClient('https://dofbxgqzcvfjpnvcvdjb.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzOTE5NTAsImV4cCI6MjA5NDk2Nzk1MH0.K3jSbS4vHdTglael23Tb8EqdLxC-_zJ-85nK2jT_0YQ');
                        if(sb) await sb.from('sponsor_requests').insert(Object.assign({}, payload, {created_at: new Date().toISOString()}));
                    } catch(supaErr) {}
                    if(r.ok || data.ok) {
                        modal.innerHTML='<div style="background:#0f110f;border:1px solid rgba(186,255,0,0.3);border-radius:18px;padding:40px 26px;max-width:420px;text-align:center;">'+
                          '<div style="font-size:50px;margin-bottom:12px;">âœ…</div>'+
                          '<div style="font-size:18px;font-weight:900;color:#baff00;margin-bottom:8px;">Â¡Solicitud enviada!</div>'+
                          '<div style="font-size:13px;color:#aaa;margin-bottom:18px;line-height:1.6;">Nuestro equipo te contacta a <strong style="color:#fff;">'+payload.email+'</strong> en menos de 24 horas.</div>'+
                          '<button onclick="document.getElementById(\'sponsor-survey-modal\').remove()" style="background:#baff00;color:#000;border:none;padding:11px 28px;border-radius:24px;font-weight:900;font-size:12px;cursor:pointer;">CERRAR</button></div>';
                    } else {
                        btn.disabled = false; btn.innerHTML = 'ðŸ“¨ ENVIAR SOLICITUD';
                        alert('Error al enviar: ' + (data.error || 'IntentÃ¡ de nuevo'));
                    }
                } catch(err) {
                    btn.disabled = false; btn.innerHTML = 'ðŸ“¨ ENVIAR SOLICITUD';
                    alert('Error de red: ' + err.message);
                }
            });
        }
        window.openSponsorSurvey = openSponsorSurvey;
        function field(label, name, type, ph, req) {
            return '<div><label style="font-size:10px;color:#888;font-weight:800;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px;">'+label+'</label>'+
              '<input '+(req?'required':'')+' type="'+type+'" name="'+name+'" placeholder="'+ph+'" style="width:100%;background:#0a0a0a;border:1px solid #222;border-radius:10px;color:#fff;padding:11px 13px;font-size:13px;outline:none;"></div>';
        }
        function selectField(label, name, options) {
            return '<div><label style="font-size:10px;color:#888;font-weight:800;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:5px;">'+label+'</label>'+
              '<select name="'+name+'" style="width:100%;background:#0a0a0a;border:1px solid #222;border-radius:10px;color:#fff;padding:11px 13px;font-size:13px;outline:none;">'+
                '<option value="">Seleccionar...</option>'+
                options.map(function(o){return '<option value="'+o+'">'+o+'</option>';}).join('')+
              '</select></div>';
        }

        // Wire sponsor band button (PC) and any [data-sponsor] elements to the same survey
        function wireSponsorLinks() {
            document.querySelectorAll('.sbt-btn, .sponsors-cta, [data-sponsor]').forEach(function(el){
                if(el._sponsorWired) return; el._sponsorWired = true;
                el.addEventListener('click', function(e){ e.preventDefault(); openSponsorSurvey(); });
            });
        }
        wireSponsorLinks();
        setInterval(wireSponsorLinks, 2000);

        // Add back button to login/register views
        function addBackBtn(viewId) {
            var view = document.getElementById('view-'+viewId);
            if(!view || view.querySelector('.view-back-btn')) return;
            var btn = document.createElement('button');
            btn.className = 'view-back-btn';
            btn.innerHTML = '<i class="bx bx-arrow-back"></i> VOLVER';
            btn.onclick = function(e){ e.preventDefault(); showView('home'); };
            view.appendChild(btn);
        }
        ['login','register'].forEach(addBackBtn);

        // Wire INICIO link + logo to navigate home
        function wireHomeLinks() {
            document.querySelectorAll('.nav-link, .nav-brand').forEach(function(el){
                var oc = el.getAttribute('onclick')||'';
                if(oc.indexOf("navigate('home')") > -1 || el.classList.contains('nav-brand')) {
                    if(el._homeWired) return;
                    el._homeWired = true;
                    el.addEventListener('click', function(e){
                        e.preventDefault();
                        showView('home');
                    });
                }
            });
        }
        wireHomeLinks();
        setInterval(wireHomeLinks, 1500);

        // Wire register role cards directly via JS (in case onclick fails)
        function wireRoleCards() {
            document.querySelectorAll('.type-card[data-role]').forEach(function(card){
                if(card._wired) return;
                card._wired = true;
                card.addEventListener('click', function(e){
                    e.preventDefault();
                    var role = card.getAttribute('data-role');
                    if(typeof window.setRegRole === 'function') {
                        try { window.setRegRole(role, card); } catch(err){ console.error('setRegRole:',err); }
                    } else {
                        // Fallback: visual selection only
                        document.querySelectorAll('.type-card').forEach(function(c){ c.classList.remove('active'); });
                        card.classList.add('active');
                    }
                });
            });
        }
        wireRoleCards();
        // Also wire when register view shows
        setInterval(wireRoleCards, 1000);

        // Navbar buttons
        function wireNav() {
            ['btn-nav-login','btn-nav-register'].forEach(function(id){
                var el = document.getElementById(id);
                if(el && !el._wired) {
                    el._wired = true;
                    var isReg = id === 'btn-nav-register';
                    el.onclick = function(e){
                        e.preventDefault();
                        try { isReg ? window.openRegistrarseModal() : window.openEntrarModal(); }
                        catch(err){ showView(isReg?'register':'login'); }
                    };
                }
            });
        }
        wireNav();
        setInterval(wireNav, 1500);
    })();
    </script>
</body>

</html>

