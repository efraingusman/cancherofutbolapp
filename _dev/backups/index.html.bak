                <div style="font-size:24px; font-weight:bold; color:var(--text-muted);">VS</div>
                <div style="text-align:center;">
                    <div style="font-size:10px; color:var(--text-muted); margin-bottom:5px;">RIVAL</div>
                    <input type="number" id="report-score-op" class="fs-input" style="width:60px; text-align:center; font-size:24px; font-weight:bold;" value="0">
