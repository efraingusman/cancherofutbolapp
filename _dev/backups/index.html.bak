                                                    <div class="shape-opt" onclick="setShieldShape('shield-manutd', this)" title="Estilo ManUtd" style="font-size:18px;"><svg viewBox="0 0 100 100"><path d="M10 20 C10 10 25 5 50 12 C75 5 90 10 90 20 V70 L50 95 L10 70 Z" fill="currentColor"/></svg></div>
                                                    <div class="shape-opt" onclick="setShieldShape('shield-penarol', this)" title="Estilo PeÃ±arol" style="font-size:18px;"><svg viewBox="0 0 100 100"><path d="M10 5 H90 V60 L50 95 L10 60 Z" fill="currentColor"/></svg></div>
                                                    <div class="shape-opt" onclick="setShieldShape('shield-nacional', this)" title="Estilo Nacional" style="font-size:18px;"><svg viewBox="0 0 100 100"><path d="M15 5 H85 V80 Q85 95 50 95 Q15 95 15 80 Z" fill="currentColor"/></svg></div>
