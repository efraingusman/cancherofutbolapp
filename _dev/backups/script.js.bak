// ============================================================
// LIVESTREAM SIMULATOR FOR COMPLEXES
// ============================================================
let isStreaming = false;
let streamInterval = null;
let streamTimerInterval = null;
let mediaStreamObj = null;
let streamSeconds = 0;

const mockChatComments = [
    "¡Qué golazo carajo!",
    "Falta clarísima, era roja juez",
    "El 10 de ellos es un crack",
    "¡Casi gol! Pegó en el palo",
    "Qué bien que está jugando la 10 FC",
    "Ese golero no saca ni una",
    "Uff qué patada le dieron",
    "¡Vamos Los del Barrio que lo damos vuelta!",
    "Qué nivel de transmisión, impecable la cámara",
    "¿Cuánto falta para terminar?",
    "¡Tremenda tapada!",
    "Penalazo penalazo",
    "Juegue juez, no fue nada"
];

const mockChatAuthors = [
    "Juan_F5", "Seba_Mdeo", "Gaston_LaTeja", "Canchero_99", "Martu_B", "Diego_Al", "Facu_Pell", "Nico_FC"
];

window.toggleLivestream = function() {
    const btn = document.getElementById('btn-toggle-stream');
    const fallback = document.getElementById('stream-fallback');
    const video = document.getElementById('stream-video');
    const liveInd = document.getElementById('live-indicator');
    const liveTimer = document.getElementById('live-timer');
    const scoreOverlay = document.getElementById('live-scoreboard-overlay');
    const scoreCtrl = document.getElementById('scoreboard-controller');
    const chatContainer = document.getElementById('stream-chat-container');
    
    if (!btn) return;
    
    if (!isStreaming) {
        // Start streaming
        isStreaming = true;
        btn.innerHTML = "<i class='bx bx-stop-circle'></i> DETENER TRANSMISIÓN";
        btn.style.background = "#ff4d4d";
        btn.style.borderColor = "#ff4d4d";
        btn.style.color = "#fff";
        
        liveInd.style.display = 'block';
        liveTimer.style.display = 'block';
        scoreOverlay.style.display = 'flex';
        scoreCtrl.style.display = 'block';
        chatContainer.innerHTML = '';
        
        // Reset scores
        document.getElementById('ctrl-score-a').innerText = '0';
        document.getElementById('ctrl-score-b').innerText = '0';
        document.getElementById('live-score-a').innerText = '0';
        document.getElementById('live-score-b').innerText = '0';
        
        // Try getting user camera
        navigator.mediaDevices.getUserMedia({ video: { aspectRatio: 16/9 }, audio: false })
            .then(stream => {
                mediaStreamObj = stream;
                if (video) {
                    video.srcObject = stream;
                    video.style.display = 'block';
                }
                fallback.style.display = 'none';
            })
            .catch(err => {
                console.log("Camera access not available, starting simulation", err);
                fallback.style.display = 'block';
                if (video) video.style.display = 'none';
                fallback.innerHTML = `
                    <div style="animation: pulse 1s infinite; margin-bottom: 10px;"><i class='bx bx-football' style="font-size:48px; color:var(--accent);"></i></div>
                    <p style="font-size:12px; font-weight:bold; color:var(--accent); text-transform:uppercase;">TRANSMISIÓN EN VIVO ACTIVA</p>
                    <p style="font-size:9px; color:#888;">(Cámara física no disponible - Simulando feed Cancha 1)</p>
                `;
            });
            
        // Timer
        streamSeconds = 0;
        liveTimer.innerText = "00:00:00";
        streamTimerInterval = setInterval(() => {
            streamSeconds++;
            const h = String(Math.floor(streamSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((streamSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(streamSeconds % 60).padStart(2, '0');
            liveTimer.innerText = `${h}:${m}:${s}`;
        }, 1000);
        
        // Live Chat simulation
        streamInterval = setInterval(() => {
            const author = mockChatAuthors[Math.floor(Math.random() * mockChatAuthors.length)];
            const text = mockChatComments[Math.floor(Math.random() * mockChatComments.length)];
            const bubble = document.createElement('div');
            bubble.style = 'background:rgba(255,255,255,0.03); border-left:2px solid var(--accent); padding:5px 8px; border-radius:4px; margin-bottom:5px;';
            bubble.innerHTML = `<strong style="color:var(--accent); font-size:10px;">@${author}:</strong> <span style="color:#eee;">${text}</span>`;
            chatContainer.appendChild(bubble);
            chatContainer.scrollTop = chatContainer.scrollHeight;
            
            // Randomly auto-increase a score just for a fun simulation if they don't click!
            if (Math.random() < 0.05) {
                const team = Math.random() < 0.5 ? 'a' : 'b';
                const elCtrl = document.getElementById(`ctrl-score-${team}`);
                const elLive = document.getElementById(`live-score-${team}`);
                if (elCtrl && elLive) {
                    const nextVal = parseInt(elCtrl.innerText) + 1;
                    elCtrl.innerText = nextVal;
                    elLive.innerText = nextVal;
                    
                    const scoreToast = document.createElement('div');
                    scoreToast.style = 'background:rgba(255,255,255,0.05); border-left:2px solid #55ff55; padding:5px 8px; border-radius:4px; margin-bottom:5px; font-weight:bold;';
                    scoreToast.innerHTML = `<span style="color:#55ff55;"><i class='bx bx-football'></i> ¡GOL SIMULADO EN LA TRANSMISIÓN!</span>`;
                    chatContainer.appendChild(scoreToast);
                    chatContainer.scrollTop = chatContainer.scrollHeight;
                }
            }
        }, 3000);
        
    } else {
        // Stop streaming
        isStreaming = false;
        btn.innerHTML = "<i class='bx bx-broadcast'></i> INICIAR TRANSMISIÓN";
        btn.style.background = "var(--accent)";
        btn.style.borderColor = "var(--accent)";
        btn.style.color = "#000";
        
        liveInd.style.display = 'none';
        liveTimer.style.display = 'none';
        scoreOverlay.style.display = 'none';
        scoreCtrl.style.display = 'none';
        
        // Stop camera tracks
        if (mediaStreamObj) {
            mediaStreamObj.getTracks().forEach(track => track.stop());
            mediaStreamObj = null;
        }
        
        if (video) {
            video.srcObject = null;
            video.style.display = 'none';
        }
        
        fallback.style.display = 'block';
        fallback.innerHTML = `
            <i class='bx bx-broadcast' style="font-size:64px; color:var(--accent); display:block; margin-bottom:15px; animation: pulse 1.5s infinite;"></i>
            <p style="font-size:14px; font-weight:bold;">LA CÁMARA ESTÁ APAGADA</p>
            <p style="font-size:11px; color:#888;">Haz clic en "Iniciar Transmisión" para activar tu cámara en vivo en las canchas.</p>
        `;
        
        clearInterval(streamTimerInterval);
        clearInterval(streamInterval);
        
        chatContainer.innerHTML = '<div style="color:var(--accent); text-align:center; padding:10px; font-weight:bold;"><i class=\'bx bx-check-circle\'></i> Directo finalizado. Resumen de estadísticas guardado en el ERP.</div>';
    }
};

window.toggleCameraInput = function() {
    if (!isStreaming) {
        alert("Inicia la transmisión en vivo primero.");
        return;
    }
    alert("Cambiando ángulo de cámara... (Simulación: Cambiando de Cancha 1 a Cámara Aérea en Cancha 2)");
};

window.adjustLiveScore = function(team, val) {
    const elCtrl = document.getElementById(`ctrl-score-${team}`);
    const elLive = document.getElementById(`live-score-${team}`);
    if (elCtrl && elLive) {
        let current = parseInt(elCtrl.innerText) || 0;
        current = Math.max(0, current + val);
        elCtrl.innerText = current;
        elLive.innerText = current;
    }
};


// ============================================================
// ADMIN CRM LOGIC
// ============================================================
window.switchAdminTab = function(tabId, el) {
    const section = document.getElementById('view-admin');
    if(!section) return;

    section.querySelectorAll('.admin-tab-content').forEach(tab => {
        tab.style.display = 'none';
    });

    const target = document.getElementById('admin-' + tabId);
    if(target) target.style.display = 'block';

    if (el) {
        section.querySelectorAll('.sidebar-menu .menu-item').forEach(item => item.classList.remove('active'));
        el.classList.add('active');
    }
};

let adminRevenueChartInstance = null;

window.renderAdminDashboard = function() {
    let allComplexes = [];
    try { allComplexes = JSON.parse(localStorage.getItem('canchero_complexes') || '[]'); } catch(e) {}
    
    document.getElementById('admin-stat-comp').innerText = allComplexes.filter(c => c.status === 'PAGADO').length;
    document.getElementById('admin-stat-jug').innerText = "0"; // Replace with real player count later
    
    const mrr = allComplexes.filter(c => c.status === 'PAGADO').length * 1500;
    document.getElementById('admin-stat-mrr').innerText = "$" + mrr;

    const compList = document.getElementById('admin-complex-list');
    if(compList) {
        if(allComplexes.length === 0) {
            compList.innerHTML = '<p style="color:#888;">No hay complejos registrados.</p>';
        } else {
            compList.innerHTML = allComplexes.map(c => `
                <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h4 style="margin:0; color:var(--accent);">${c.name} <span style="font-size:10px; background:white; color:black; padding:2px 5px; border-radius:3px;">${c.status}</span></h4>
                        <span style="font-size:12px; color:#888;">Dueño: ${c.owner} - Tel: ${c.phone} - Email: ${c.email}</span>
                    </div>
                    <div>
                        <button class="btn btn-primary btn-sm" onclick="alert('Funcionalidad para aprobar complejo.')">APROBAR</button>
                        <button class="btn btn-glass btn-sm" style="color:#ff4444; border-color:#ff4444;">RECHAZAR</button>
                    </div>
                </div>
            `).join('');
        }
    }

    // Chart.js
    const ctx = document.getElementById('adminRevenueChart');
    if(ctx) {
        if(adminRevenueChartInstance) adminRevenueChartInstance.destroy();
        adminRevenueChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                datasets: [{
                    label: 'Ingresos MRR ($)',
                    data: [200, 400, 800, 1000, 1200, 1500],
                    borderColor: '#baff00',
                    backgroundColor: 'rgba(186, 255, 0, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { 
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' } },
                    x: { grid: { color: 'rgba(255,255,255,0.05)' } }
                }
            }
        });
    }
};

window.toggleSidebar = function() {
    const sidebar = document.querySelector('.sidebar');
    if (sidebar) {
        sidebar.classList.toggle('active');
    }
};

// ============================================================
// MÓDULO SOCIAL — Posts, Stories, Likes, Comments, Reports
// ============================================================
const social = (() => {
    const SUPABASE_URL = 'https://dofbxgqzcvfjpnvcvdjb.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc';
    let sb = null;
    try { sb = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY) : null; } catch(e) {}

    function getUser() {
        const u = window.userData || {};
        return {
            email: u.email || localStorage.getItem('canchero_email') || 'anonimo@canchero.uy',
            name:  u.name  || localStorage.getItem('canchero_name')  || 'Jugador',
            role:  u.role  || localStorage.getItem('canchero_role')  || 'jugador',
            avatar: u.photo || null,
        };
    }

    function timeAgoStr(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr), now = new Date();
        const s = Math.floor((now - d) / 1000);
        if (s < 60) return 'Hace un momento';
        if (s < 3600) return `Hace ${Math.floor(s/60)} min`;
        if (s < 86400) return `Hace ${Math.floor(s/3600)}h`;
        return `Hace ${Math.floor(s/86400)}d`;
    }

    function avatarEl(name, photoUrl, size = 42) {
        const letter = (name || '?')[0].toUpperCase();
        if (photoUrl && !photoUrl.includes('randomuser')) {
            return `<div style="width:${size}px;height:${size}px;border-radius:50%;background-image:url('${photoUrl}');background-size:cover;background-position:center;flex-shrink:0;border:2px solid var(--border);"></div>`;
        }
        return `<div style="width:${size}px;height:${size}px;border-radius:50%;background:var(--accent);color:#000;font-weight:900;font-size:${Math.floor(size*0.35)}px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${letter}</div>`;
    }

    function roleBadge(role) {
        const map = { club:'Complejo', profesional:'Profesional', organizacion:'Organización', tienda:'Tienda', sponsor:'Sponsor' };
        if (!map[role]) return '';
        return `<span style="font-size:9px;background:rgba(186,255,0,0.15);color:var(--accent);padding:1px 6px;border-radius:4px;margin-left:6px;font-weight:700;text-transform:uppercase;">${map[role]}</span>`;
    }

    function postCardHTML(p, likedByMe, isFollowing, isMe) {
        const liked = likedByMe;
        const hasMedia = p.media_url && p.media_type !== 'text';
        const isVideo = p.media_type === 'video';
        const safeUserName = (p.user_name||'').replace(/'/g,"\\'");
        const followBtn = isMe ? '' : `<button onclick="social.toggleFollow(this,'${p.user_email}','${safeUserName}')" data-following="${isFollowing?'true':'false'}" style="background:${isFollowing?'transparent':'rgba(186,255,0,0.12)'};color:${isFollowing?'#555':'var(--accent)'};border:1px solid ${isFollowing?'#333':'rgba(186,255,0,0.4)'};font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;cursor:pointer;white-space:nowrap;transition:.15s;">${isFollowing?'Siguiendo':'+ Seguir'}</button>`;
        return `
        <div class="post-card" data-post-id="${p.id}" style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
            ${avatarEl(p.user_name, p.user_avatar)}
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;font-size:13px;display:flex;align-items:center;flex-wrap:wrap;gap:4px;">
                ${(p.user_name||'Jugador').toUpperCase()}${roleBadge(p.user_role)}
              </div>
              <div style="font-size:11px;color:#666;">${timeAgoStr(p.created_at)}</div>
            </div>
            <div style="display:flex;align-items:center;gap:4px;">${followBtn}<button onclick="social.reportPost('${p.id}')" style="background:none;border:none;color:#333;cursor:pointer;padding:4px;font-size:16px;" title="Reportar"><i class='bx bx-flag'></i></button></div>
          </div>
          ${p.content ? `<p style="font-size:13px;line-height:1.55;margin:0 0 12px;word-break:break-word;">${escapeHtml(p.content)}</p>` : ''}
          ${(p.tags && p.tags.length && window.cancheroFeatures) ? window.cancheroFeatures.tags.renderTagsHtml(p.tags, p.id) : ''}
          ${hasMedia ? (isVideo
            ? `<video src="${p.media_url}" controls style="width:100%;max-height:320px;border-radius:10px;margin-bottom:12px;"></video>`
            : `<img src="${p.media_url}" style="width:100%;max-height:360px;object-fit:cover;border-radius:10px;margin-bottom:12px;" onerror="this.style.display='none'">`) : ''}
          <div style="display:flex;gap:6px;border-top:1px solid var(--border);padding-top:10px;">
            <button class="post-action-btn ${liked?'liked':''}" onclick="social.toggleLike(this)" data-post-id="${p.id}" style="flex:1;background:none;border:none;color:${liked?'var(--accent)':'#666'};cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;padding:6px;border-radius:8px;font-size:12px;font-weight:600;transition:.15s;">
              <i class='bx ${liked?'bxs-heart':'bx-heart'}'></i> <span class="like-count">${p.likes_count||0}</span>
            </button>
            <button onclick="social.openComments('${p.id}')" style="flex:1;background:none;border:none;color:#666;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;padding:6px;border-radius:8px;font-size:12px;font-weight:600;transition:.15s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#666'">
              <i class='bx bx-comment'></i> <span>${p.comments_count||0}</span>
            </button>
            <button onclick="social.sharePost('${p.id}','${(p.user_name||'').replace(/'/g,'')}')" style="flex:1;background:none;border:none;color:#666;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;padding:6px;border-radius:8px;font-size:12px;font-weight:600;transition:.15s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#666'">
              <i class='bx bx-share-alt'></i> Compartir
            </button>
          </div>
        </div>`;
    }

    function escapeHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── LOAD FEED ─────────────────────────────────────────────
    async function loadFeed(containerId = 'amigos-feed', followingOnly = false) {
        const el = document.getElementById(containerId);
        if (!el) return;
        el.innerHTML = `<div style="text-align:center;padding:30px;color:#555;"><i class='bx bx-loader-alt bx-spin' style="font-size:24px;"></i></div>`;

        if (!sb) {
            el.innerHTML = `<div class="post-card" style="background:var(--bg2);border:1px solid var(--border);border-radius:14px;padding:24px;text-align:center;color:#555;">Sin conexión a Supabase.</div>`;
            return;
        }

        try {
            const me = getUser();
            let followingEmails = new Set();
            try {
                const { data: myFollowing } = await sb.from('follows').select('following_email').eq('follower_email', me.email);
                (myFollowing || []).forEach(f => followingEmails.add(f.following_email));
            } catch(e) { /* tabla follows aún no creada */ }

            if (followingOnly && followingEmails.size === 0) {
                el.innerHTML = `<div style="text-align:center;padding:40px;color:#555;"><i class='bx bx-user-plus' style="font-size:36px;margin-bottom:10px;display:block;"></i><p>Aún no seguís a nadie.<br><span style="font-size:12px;">Explorá el feed general y seguí jugadores.</span></p></div>`;
                return;
            }

            let query = sb.from('posts').select('*').order('created_at', { ascending: false }).limit(30);
            if (followingOnly) query = query.in('user_email', [...followingEmails]);

            const { data: posts, error } = await query;
            if (error) throw error;

            let likedIds = new Set();
            if (posts && posts.length) {
                const { data: myLikes } = await sb.from('post_likes').select('post_id').eq('user_email', me.email).in('post_id', posts.map(p => p.id));
                (myLikes || []).forEach(l => likedIds.add(l.post_id));
            }

            if (!posts || posts.length === 0) {
                el.innerHTML = `<div style="text-align:center;padding:40px;color:#555;"><i class='bx bx-message-square-detail' style="font-size:36px;margin-bottom:10px;display:block;"></i><p>${followingOnly ? 'Los jugadores que seguís aún no publicaron nada.' : 'Sé el primero en publicar algo.'}</p></div>`;
                return;
            }
            el.innerHTML = posts.map(p => postCardHTML(p, likedIds.has(p.id), followingEmails.has(p.user_email), p.user_email === me.email)).join('');
        } catch(e) {
            el.innerHTML = `<div style="text-align:center;padding:24px;color:#f44;font-size:12px;">Error cargando el feed: ${e.message}</div>`;
        }
    }

    // ── CREATE POST ───────────────────────────────────────────
    async function createPost(role) {
        const textEl = document.getElementById(role === 'jugador' ? 'player-post-text' : 'club-post-text');
        const mediaInput = document.getElementById(role === 'jugador' ? 'player-post-media' : 'club-post-media');
        if (!textEl) return;
        const text = textEl.value.trim();
        const file = mediaInput && mediaInput.files && mediaInput.files[0];
        if (!text && !file) { showToast('Escribí algo antes de publicar.', 'error'); return; }

        const btn = document.querySelector('.btn-post');
        if (btn) { btn.disabled = true; btn.textContent = 'Publicando...'; }

        const me = getUser();
        let mediaUrl = null, mediaType = 'text';

        if (file && sb) {
            try {
                const ext = file.name.split('.').pop();
                const path = `posts/${Date.now()}_${me.email.replace('@','_')}.${ext}`;
                const { data: upData, error: upErr } = await sb.storage.from('media').upload(path, file, { cacheControl: '3600', upsert: false });
                if (!upErr) {
                    const { data: urlData } = sb.storage.from('media').getPublicUrl(path);
                    mediaUrl = urlData.publicUrl;
                    mediaType = file.type.startsWith('video') ? 'video' : 'image';
                }
            } catch(e) {}
        }

        // Check for URL in media input (text-based URL input)
        const mediaUrlInput = document.getElementById(role === 'jugador' ? 'player-post-mediaurl' : 'club-post-mediaurl');
        if (!mediaUrl && mediaUrlInput && mediaUrlInput.value.trim()) {
            mediaUrl = mediaUrlInput.value.trim();
            mediaType = mediaUrl.match(/\.(mp4|webm|ogg)$/i) ? 'video' : 'image';
        }

        // Extract tags from textarea data attribute (set by canchero-features tag autocomplete)
        let tags = [];
        try { tags = JSON.parse(textEl.dataset.tags || '[]'); } catch(e){}

        const post = {
            user_email: me.email,
            user_name:  me.name,
            user_role:  me.role,
            user_avatar: me.avatar,
            content:    text || null,
            media_url:  mediaUrl,
            media_type: mediaType,
            tags:       tags
        };

        if (sb) {
            const { error, data: inserted } = await sb.from('posts').insert(post).select().single();
            // Notify tagged users
            if (!error && inserted && tags.length && window.cancheroFeatures) {
                window.cancheroFeatures.tags.onPostPublished(inserted.id, tags);
            }
            // Clear tag data
            textEl.dataset.tags = '[]';
            if (error) {
                showToast('Error al publicar: ' + error.message, 'error');
                if (btn) { btn.disabled = false; btn.textContent = 'PUBLICAR'; }
                return;
            }
        }

        // Clear composer
        textEl.value = '';
        if (mediaInput) { mediaInput.value = ''; }
        if (mediaUrlInput) mediaUrlInput.value = '';
        const previewEl = document.getElementById(role === 'jugador' ? 'player-post-preview' : 'club-post-preview');
        if (previewEl) { previewEl.innerHTML = ''; previewEl.style.display = 'none'; }
        if (btn) { btn.disabled = false; btn.textContent = 'PUBLICAR'; }

        showToast('¡Publicación creada!', 'success');
        loadFeed('amigos-feed');
        loadFeed('jugador-feed');
    }

    // ── LIKE TOGGLE ───────────────────────────────────────────
    async function toggleLike(el) {
        const postId = el.dataset.postId;
        if (!postId || !sb) return;
        const me = getUser();
        const isLiked = el.classList.contains('liked');
        const icon = el.querySelector('i');
        const countEl = el.querySelector('.like-count');
        const current = parseInt(countEl.textContent) || 0;

        // Optimistic UI
        if (isLiked) {
            el.classList.remove('liked');
            el.style.color = '#666';
            icon.className = 'bx bx-heart';
            countEl.textContent = Math.max(0, current - 1);
        } else {
            el.classList.add('liked');
            el.style.color = 'var(--accent)';
            icon.className = 'bx bxs-heart';
            countEl.textContent = current + 1;
        }

        try {
            if (isLiked) {
                await sb.from('post_likes').delete().eq('post_id', postId).eq('user_email', me.email);
                await sb.from('posts').update({ likes_count: Math.max(0, current - 1) }).eq('id', postId);
            } else {
                await sb.from('post_likes').insert({ post_id: postId, user_email: me.email });
                await sb.from('posts').update({ likes_count: current + 1 }).eq('id', postId);
            }
        } catch(e) {}
    }

    // ── COMMENTS ─────────────────────────────────────────────
    async function openComments(postId) {
        let modal = document.getElementById('social-comments-modal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'social-comments-modal';
            modal.style.cssText = 'position:fixed;inset:0;z-index:9000;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);';
            modal.innerHTML = `
              <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px 20px 0 0;width:100%;max-width:600px;max-height:80vh;display:flex;flex-direction:column;overflow:hidden;">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);">
                  <span style="font-family:var(--font-secondary,Outfit,sans-serif);font-size:15px;font-weight:700;">Comentarios</span>
                  <button onclick="document.getElementById('social-comments-modal').remove()" style="background:none;border:none;color:#888;cursor:pointer;font-size:22px;line-height:1;">&times;</button>
                </div>
                <div id="comments-list" style="flex:1;overflow-y:auto;padding:16px 20px;"></div>
                <div style="padding:14px 16px;border-top:1px solid var(--border);display:flex;gap:10px;">
                  <input id="comment-input" type="text" placeholder="Escribí un comentario..." style="flex:1;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:20px;padding:10px 16px;color:#fff;font-size:13px;outline:none;">
                  <button id="comment-send-btn" onclick="social.submitComment('${postId}')" style="background:var(--accent);color:#000;border:none;border-radius:20px;padding:10px 18px;font-weight:800;font-size:12px;cursor:pointer;white-space:nowrap;">Enviar</button>
                </div>
              </div>`;
            modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
            document.body.appendChild(modal);
        }
        modal.querySelector('#comment-send-btn').setAttribute('onclick', `social.submitComment('${postId}')`);
        loadComments(postId);
    }

    async function loadComments(postId) {
        const list = document.getElementById('comments-list');
        if (!list) return;
        list.innerHTML = `<div style="text-align:center;color:#555;padding:20px;"><i class='bx bx-loader-alt bx-spin'></i></div>`;
        if (!sb) { list.innerHTML = '<div style="color:#555;padding:12px;">Sin conexión.</div>'; return; }
        const { data, error } = await sb.from('post_comments').select('*').eq('post_id', postId).order('created_at', { ascending: true });
        if (error || !data || !data.length) {
            list.innerHTML = '<div style="text-align:center;color:#555;padding:20px;font-size:13px;">Sé el primero en comentar.</div>';
            return;
        }
        list.innerHTML = data.map(c => `
            <div style="display:flex;gap:10px;margin-bottom:14px;">
              ${avatarEl(c.user_name, null, 34)}
              <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:8px 12px;flex:1;">
                <div style="font-size:11px;font-weight:700;margin-bottom:3px;">${(c.user_name||'Jugador').toUpperCase()}</div>
                <div style="font-size:13px;line-height:1.4;">${escapeHtml(c.content)}</div>
                <div style="font-size:10px;color:#555;margin-top:4px;">${timeAgoStr(c.created_at)}</div>
              </div>
            </div>`).join('');
        list.scrollTop = list.scrollHeight;
    }

    async function submitComment(postId) {
        const input = document.getElementById('comment-input');
        if (!input) return;
        const text = input.value.trim();
        if (!text) return;
        const me = getUser();
        if (!sb) return;
        input.value = '';
        const { error } = await sb.from('post_comments').insert({ post_id: postId, user_email: me.email, user_name: me.name, content: text });
        if (!error) {
            await sb.from('posts').update({ comments_count: sb.rpc ? undefined : undefined }).eq('id', postId);
            // increment comments count
            const { data: post } = await sb.from('posts').select('comments_count').eq('id', postId).single();
            if (post) await sb.from('posts').update({ comments_count: (post.comments_count||0) + 1 }).eq('id', postId);
            loadComments(postId);
        }
    }

    // ── STORIES ──────────────────────────────────────────────
    async function loadStories() {
        const container = document.getElementById('stories-container');
        if (!container) return;
        if (!sb) return;

        const now = new Date().toISOString();
        const { data: stories } = await sb.from('stories').select('*').gt('expires_at', now).order('created_at', { ascending: false }).limit(20);

        const me = getUser();
        let html = `
          <div onclick="social.openCreateStory()" style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bg3);border:2px dashed var(--accent);display:flex;align-items:center;justify-content:center;">
              <i class='bx bx-plus' style="font-size:22px;color:var(--accent);"></i>
            </div>
            <span style="font-size:10px;color:#888;">Tu story</span>
          </div>`;

        if (stories && stories.length) {
            html += stories.map(s => `
              <div onclick="social.viewStory('${s.id}')" style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;flex-shrink:0;">
                <div style="width:60px;height:60px;border-radius:50%;background:${s.media_url?'#111':'var(--bg3)'};border:2px solid var(--accent);overflow:hidden;display:flex;align-items:center;justify-content:center;position:relative;">
                  ${s.media_url ? `<img src="${s.media_url}" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'">` : `<i class='bx bx-message-rounded' style="font-size:22px;color:#666;"></i>`}
                </div>
                <span style="font-size:10px;color:#aaa;max-width:60px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;">${(s.user_name||'').split(' ')[0]}</span>
              </div>`).join('');
        }

        container.innerHTML = html;
    }

    const _stories_cache = {};
    async function viewStory(storyId) {
        if (!sb) return;
        const { data: s } = await sb.from('stories').select('*').eq('id', storyId).single();
        if (!s) return;

        let existing = document.getElementById('story-viewer-modal');
        if (existing) existing.remove();

        const modal = document.createElement('div');
        modal.id = 'story-viewer-modal';
        modal.style.cssText = 'position:fixed;inset:0;z-index:9500;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.92);';
        modal.innerHTML = `
          <div style="width:100%;max-width:380px;max-height:90vh;position:relative;border-radius:16px;overflow:hidden;background:#111;">
            <div style="position:absolute;top:0;left:0;right:0;height:3px;background:rgba(255,255,255,0.2);z-index:1;">
              <div style="height:100%;background:var(--accent);animation:story-progress 5s linear forwards;" onanimationend="this.closest('#story-viewer-modal').remove()"></div>
            </div>
            <div style="position:absolute;top:14px;left:14px;right:14px;display:flex;align-items:center;gap:10px;z-index:1;">
              ${avatarEl(s.user_name, s.user_avatar, 36)}
              <div>
                <div style="font-size:12px;font-weight:700;">${(s.user_name||'Jugador').toUpperCase()}</div>
                <div style="font-size:10px;color:rgba(255,255,255,0.6);">${timeAgoStr(s.created_at)}</div>
              </div>
              <button onclick="document.getElementById('story-viewer-modal').remove()" style="margin-left:auto;background:none;border:none;color:#fff;font-size:22px;cursor:pointer;">&times;</button>
            </div>
            ${s.media_url ? `<img src="${s.media_url}" style="width:100%;min-height:500px;max-height:90vh;object-fit:cover;" onerror="this.src=''">` : `<div style="min-height:400px;display:flex;align-items:center;justify-content:center;padding:60px 24px;"></div>`}
            ${s.content ? `<div style="position:absolute;bottom:20px;left:16px;right:16px;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);border-radius:10px;padding:12px 16px;font-size:14px;line-height:1.5;">${escapeHtml(s.content)}</div>` : ''}
          </div>`;
        modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
        document.body.appendChild(modal);
    }

    function openCreateStory() {
        let existing = document.getElementById('create-story-modal');
        if (existing) existing.remove();
        const modal = document.createElement('div');
        modal.id = 'create-story-modal';
        modal.style.cssText = 'position:fixed;inset:0;z-index:9000;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);';
        modal.innerHTML = `
          <div style="background:var(--bg2);border:1px solid var(--border);border-radius:20px 20px 0 0;width:100%;max-width:600px;padding:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
              <span style="font-family:Outfit,sans-serif;font-size:15px;font-weight:700;">Nueva Story</span>
              <button onclick="document.getElementById('create-story-modal').remove()" style="background:none;border:none;color:#888;cursor:pointer;font-size:22px;">&times;</button>
            </div>
            <textarea id="story-text" placeholder="Contá algo..." style="width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:10px;padding:12px;color:#fff;font-size:14px;resize:none;outline:none;margin-bottom:12px;" rows="3"></textarea>
            <div style="margin-bottom:12px;">
              <label style="font-size:10px;color:#888;text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:6px;">URL de imagen (opcional)</label>
              <input id="story-media" type="url" placeholder="https://..." style="width:100%;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;padding:10px;color:#fff;font-size:13px;outline:none;">
            </div>
            <button onclick="social.submitStory()" style="width:100%;background:var(--accent);color:#000;border:none;padding:13px;border-radius:10px;font-family:Outfit,sans-serif;font-weight:900;font-size:14px;cursor:pointer;text-transform:uppercase;letter-spacing:1px;">Publicar Story</button>
            <p style="font-size:11px;color:#555;text-align:center;margin-top:10px;">Las stories desaparecen en 24 horas.</p>
          </div>`;
        modal.onclick = (e) => { if (e.target === modal) modal.remove(); };
        document.body.appendChild(modal);
    }

    async function submitStory() {
        const text = document.getElementById('story-text')?.value.trim();
        const mediaUrl = document.getElementById('story-media')?.value.trim();
        if (!text && !mediaUrl) { showToast('Agregá texto o imagen a tu story.', 'error'); return; }
        const me = getUser();
        if (!sb) return;
        const { error } = await sb.from('stories').insert({
            user_email: me.email, user_name: me.name, user_role: me.role,
            content: text || null, media_url: mediaUrl || null,
        });
        if (error) { showToast('Error al publicar story.', 'error'); return; }
        document.getElementById('create-story-modal')?.remove();
        showToast('¡Story publicada!', 'success');
        loadStories();
    }

    // ── REPORT ───────────────────────────────────────────────
    async function reportPost(postId) {
        const reasons = ['Spam', 'Contenido inapropiado', 'Violencia', 'Contenido sexual', 'Información falsa', 'Otro'];
        const reason = await new Promise(resolve => {
            let modal = document.getElementById('report-modal');
            if (modal) modal.remove();
            modal = document.createElement('div');
            modal.id = 'report-modal';
            modal.style.cssText = 'position:fixed;inset:0;z-index:9100;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.8);padding:20px;';
            modal.innerHTML = `
              <div style="background:var(--bg2);border:1px solid var(--border);border-radius:16px;width:100%;max-width:380px;padding:24px;">
                <h3 style="font-family:Outfit,sans-serif;font-weight:800;margin-bottom:6px;">Reportar contenido</h3>
                <p style="font-size:12px;color:#888;margin-bottom:16px;">¿Por qué querés reportar esto?</p>
                ${reasons.map(r => `<button onclick="document.getElementById('report-modal').dispatchEvent(new CustomEvent('pick',{detail:'${r}'}))" style="display:block;width:100%;text-align:left;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:8px;padding:10px 14px;color:#fff;font-size:13px;cursor:pointer;margin-bottom:6px;">${r}</button>`).join('')}
                <button onclick="document.getElementById('report-modal').remove()" style="display:block;width:100%;background:none;border:none;color:#666;cursor:pointer;margin-top:8px;font-size:12px;">Cancelar</button>
              </div>`;
            modal.addEventListener('pick', e => { modal.remove(); resolve(e.detail); });
            modal.onclick = (e) => { if (e.target === modal) { modal.remove(); resolve(null); } };
            document.body.appendChild(modal);
        });

        if (!reason || !sb) return;
        const me = getUser();
        await sb.from('reports').insert({ content_type: 'post', content_id: postId, reporter_email: me.email, reason });
        showToast('Reporte enviado. Lo revisaremos pronto.', 'success');
    }

    function sharePost(postId, userName) {
        const url = `${window.location.origin}${window.location.pathname}#post-${postId}`;
        if (navigator.share) {
            navigator.share({ title: `Post de ${userName} en Canchero`, url });
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url);
            showToast('Link copiado al portapapeles.', 'success');
        }
    }

    // ── FOLLOW SYSTEM ─────────────────────────────────────────
    async function follow(targetEmail, targetName) {
        const me = getUser();
        if (!sb || !targetEmail || targetEmail === me.email) return;
        try {
            await sb.from('follows').insert({ follower_email: me.email, following_email: targetEmail });
            if (window.notif) window.notif.create(targetEmail, 'follow', me.name, `${me.name} ahora te sigue.`);
        } catch(e) {}
    }

    async function unfollow(targetEmail) {
        const me = getUser();
        if (!sb) return;
        try { await sb.from('follows').delete().eq('follower_email', me.email).eq('following_email', targetEmail); } catch(e) {}
    }

    async function toggleFollow(el, targetEmail, targetName) {
        const isFollowing = el.dataset.following === 'true';
        el.disabled = true;
        if (isFollowing) {
            await unfollow(targetEmail);
            el.dataset.following = 'false';
            el.textContent = '+ Seguir';
            el.style.background = 'rgba(186,255,0,0.12)';
            el.style.color = 'var(--accent)';
            el.style.border = '1px solid rgba(186,255,0,0.4)';
        } else {
            await follow(targetEmail, targetName);
            el.dataset.following = 'true';
            el.textContent = 'Siguiendo';
            el.style.background = 'transparent';
            el.style.color = '#555';
            el.style.border = '1px solid #333';
        }
        el.disabled = false;
    }

    async function loadFollowersList(email, containerId) {
        const el = document.getElementById(containerId);
        if (!el || !sb) return;
        el.innerHTML = '<div style="text-align:center;padding:20px;"><i class="bx bx-loader-alt bx-spin" style="font-size:22px;color:#555;"></i></div>';
        try {
            const { data } = await sb.from('follows').select('follower_email').eq('following_email', email);
            if (!data || data.length === 0) {
                el.innerHTML = '<div style="text-align:center;padding:28px;color:#555;font-size:12px;"><i class="bx bx-user-plus" style="font-size:28px;display:block;margin-bottom:8px;"></i>Sin seguidores aún.</div>';
                return;
            }
            const me = getUser();
            const { data: myFol } = await sb.from('follows').select('following_email').eq('follower_email', me.email);
            const myFolSet = new Set((myFol||[]).map(f => f.following_email));
            el.innerHTML = data.map(f => {
                const n = f.follower_email.split('@')[0];
                const isF = myFolSet.has(f.follower_email);
                const isMeF = f.follower_email === me.email;
                return `<div style="display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--border);">${avatarEl(n, null, 38)}<div style="flex:1;min-width:0;"><div style="font-size:12px;font-weight:700;">${n.toUpperCase()}</div><div style="font-size:11px;color:#555;">${f.follower_email}</div></div>${!isMeF?`<button onclick="social.toggleFollow(this,'${f.follower_email}','${n}')" data-following="${isF?'true':'false'}" style="background:${isF?'transparent':'rgba(186,255,0,0.12)'};color:${isF?'#555':'var(--accent)'};border:1px solid ${isF?'#333':'rgba(186,255,0,0.4)'};font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;cursor:pointer;">${isF?'Siguiendo':'+ Seguir'}</button><button onclick="window.openDM('${f.follower_email}','${n}')" style="background:rgba(255,255,255,0.06);color:#aaa;border:1px solid #333;font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;cursor:pointer;"><i class='bx bx-message-dots'></i></button>`:'<span style="font-size:11px;color:#666;">Tú</span>'}</div>`;
            }).join('');
        } catch(e) {
            el.innerHTML = '<div style="color:#f44;padding:16px;text-align:center;font-size:12px;">Error cargando seguidores.</div>';
        }
    }

    async function loadFollowingList(email, containerId) {
        const el = document.getElementById(containerId);
        if (!el || !sb) return;
        el.innerHTML = '<div style="text-align:center;padding:20px;"><i class="bx bx-loader-alt bx-spin" style="font-size:22px;color:#555;"></i></div>';
        try {
            const { data } = await sb.from('follows').select('following_email').eq('follower_email', email);
            if (!data || data.length === 0) {
                el.innerHTML = '<div style="text-align:center;padding:28px;color:#555;font-size:12px;"><i class="bx bx-user-check" style="font-size:28px;display:block;margin-bottom:8px;"></i>No estás siguiendo a nadie aún.</div>';
                return;
            }
            const me = getUser();
            el.innerHTML = data.map(f => {
                const n = f.following_email.split('@')[0];
                const isMeF = f.following_email === me.email;
                return `<div style="display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--border);">${avatarEl(n, null, 38)}<div style="flex:1;min-width:0;"><div style="font-size:12px;font-weight:700;">${n.toUpperCase()}</div><div style="font-size:11px;color:#555;">${f.following_email}</div></div>${!isMeF?`<button onclick="social.toggleFollow(this,'${f.following_email}','${n}')" data-following="true" style="background:transparent;color:#555;border:1px solid #333;font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;cursor:pointer;">Siguiendo</button><button onclick="window.openDM('${f.following_email}','${n}')" style="background:rgba(255,255,255,0.06);color:#aaa;border:1px solid #333;font-size:10px;font-weight:700;padding:3px 8px;border-radius:20px;cursor:pointer;"><i class='bx bx-message-dots'></i></button>`:'<span style="font-size:11px;color:#666;">Tú</span>'}</div>`;
            }).join('');
        } catch(e) {
            el.innerHTML = '<div style="color:#f44;padding:16px;text-align:center;font-size:12px;">Error cargando seguidos.</div>';
        }
    }

    return { getUser, loadFeed, createPost, toggleLike, openComments, submitComment, loadStories, viewStory, openCreateStory, submitStory, reportPost, sharePost, follow, unfollow, toggleFollow, loadFollowersList, loadFollowingList };
})();

// Auto-load stories when amigos tab is active
const _origSwitchTab = window.switchDashboardTab;
window.switchDashboardTab = function(role, tab, el) {
    if (_origSwitchTab) _origSwitchTab(role, tab, el);
    if (tab === 'amigos') {
        setTimeout(() => { social.loadFeed('amigos-feed'); social.loadStories(); }, 100);
    }
    if (tab === 'inicio' && role === 'jugador') {
        setTimeout(() => social.loadFeed('jugador-feed'), 100);
    }
};

// ============================================================
// MÓDULO NOTIFICACIONES
// ============================================================
const notif = (() => {
    const SB_URL = 'https://dofbxgqzcvfjpnvcvdjb.supabase.co';
    const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc';
    let sb = null;
    try { sb = window.supabase ? window.supabase.createClient(SB_URL, SB_KEY) : null; } catch(e) {}
    let _realtimeChannel = null;
    let _panelOpen = false;

    function getEmail() {
        return (window.userData && window.userData.email) || localStorage.getItem('canchero_email') || null;
    }

    async function load() {
        const email = getEmail();
        if (!email || !sb) return;
        try {
            const { data } = await sb.from('notifications').select('*').eq('recipient_email', email).order('created_at', { ascending: false }).limit(30);
            render(data || []);
        } catch(e) {}
    }

    function render(items) {
        const list = document.getElementById('notif-list');
        if (!list) return;
        const unread = items.filter(n => !n.read).length;

        // Update badge
        const badge = document.getElementById('notif-badge');
        if (badge) {
            badge.textContent = unread > 9 ? '9+' : unread;
            badge.style.display = unread > 0 ? 'flex' : 'none';
        }
        const icon = document.getElementById('notif-bell-icon');
        if (icon) icon.className = unread > 0 ? 'bx bxs-bell' : 'bx bx-bell';

        if (!items.length) {
            list.innerHTML = '<div style="padding:24px;text-align:center;color:#555;font-size:13px;"><i class=\'bx bx-bell-off\' style="font-size:28px;display:block;margin-bottom:8px;"></i>Sin notificaciones aún.</div>';
            return;
        }

        const icons = { like: 'bxs-heart', comment: 'bx-comment', follow: 'bx-user-plus', story: 'bx-radio-circle' };
        const colors = { like: '#ff4444', comment: '#baff00', follow: '#4fc3f7', story: '#ffb400' };
        list.innerHTML = items.map(n => `
            <div onclick="notif.markRead('${n.id}')" style="display:flex;align-items:flex-start;gap:12px;padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.04);cursor:pointer;background:${n.read ? 'transparent' : 'rgba(186,255,0,0.03)'};" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background='${n.read?'transparent':'rgba(186,255,0,0.03)'}'">
                <div style="width:32px;height:32px;border-radius:50%;background:${colors[n.type]||'#555'}22;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class='bx ${icons[n.type]||'bx-bell'}' style="color:${colors[n.type]||'#888'};font-size:16px;"></i>
                </div>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:12px;line-height:1.4;">${n.message||''}</div>
                    <div style="font-size:10px;color:#555;margin-top:3px;">${timeStr(n.created_at)}</div>
                </div>
                ${!n.read ? '<div style="width:7px;height:7px;border-radius:50%;background:#baff00;flex-shrink:0;margin-top:4px;"></div>' : ''}
            </div>`).join('');
    }

    function timeStr(d) {
        if (!d) return '';
        const s = Math.floor((new Date() - new Date(d)) / 1000);
        if (s < 60) return 'Ahora';
        if (s < 3600) return `${Math.floor(s/60)} min`;
        if (s < 86400) return `${Math.floor(s/3600)}h`;
        return `${Math.floor(s/86400)}d`;
    }

    async function markRead(id) {
        if (!sb) return;
        try { await sb.from('notifications').update({ read: true }).eq('id', id); } catch(e) {}
        load();
    }

    async function markAllRead() {
        const email = getEmail();
        if (!email || !sb) return;
        try { await sb.from('notifications').update({ read: true }).eq('recipient_email', email).eq('read', false); } catch(e) {}
        load();
        const panel = document.getElementById('notif-panel');
        if (panel) panel.style.display = 'none';
        _panelOpen = false;
    }

    function togglePanel() {
        const panel = document.getElementById('notif-panel');
        if (!panel) return;
        _panelOpen = !_panelOpen;
        panel.style.display = _panelOpen ? 'flex' : 'none';
        if (_panelOpen) load();
    }

    // Create a notification for another user
    async function create(recipientEmail, type, actorName, message, postId = null) {
        const senderEmail = getEmail();
        if (!sb || !recipientEmail || recipientEmail === senderEmail) return;
        try {
            await sb.from('notifications').insert({
                recipient_email: recipientEmail, type, actor_name: actorName,
                actor_email: senderEmail, post_id: postId, message, read: false,
            });
        } catch(e) {}
    }

    // Supabase Realtime: listen for new posts and refresh feed
    function startRealtime() {
        if (!sb || _realtimeChannel) return;
        try {
            _realtimeChannel = sb.channel('public:posts')
                .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'posts' }, () => {
                    const feedEl = document.getElementById('amigos-feed');
                    if (feedEl && document.getElementById('jugador-amigos') && document.getElementById('jugador-amigos').style.display !== 'none') {
                        social.loadFeed('amigos-feed');
                    }
                })
                .subscribe();
        } catch(e) {}
    }

    function showBell(show) {
        const wrap = document.getElementById('notif-bell-wrap');
        if (wrap) wrap.style.display = show ? 'block' : 'none';
        if (show) { load(); startRealtime(); }
    }

    // Close panel when clicking outside
    document.addEventListener('click', (e) => {
        if (_panelOpen && !e.target.closest('#notif-bell-wrap')) {
            const panel = document.getElementById('notif-panel');
            if (panel) panel.style.display = 'none';
            _panelOpen = false;
        }
    });

    return { load, togglePanel, markRead, markAllRead, create, showBell, startRealtime };
})();

// Expose notif globally
window.notif = notif;

// Hook: show bell + create notifications on like/comment
// Patch social.toggleLike to also create notification
const _origToggleLike = window.likePost;
window.likePost = async function(el) {
    const postId = el.dataset ? el.dataset.postId : null;
    await social.toggleLike(el);
    // Try to notify post owner
    if (postId && supabase) {
        try {
            const sb2 = window.supabase.createClient('https://dofbxgqzcvfjpnvcvdjb.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc');
            const { data: post } = await sb2.from('posts').select('user_email,user_name').eq('id', postId).single();
            if (post) {
                const me = window.userData;
                notif.create(post.user_email, 'like', (me&&me.name)||'Alguien', `❤️ ${(me&&me.name)||'Alguien'} le dio like a tu publicación.`, postId);
            }
        } catch(e) {}
    }
};

// Show bell when user logs in
const _origApplyUserData = window.applyUserData;
window.applyUserData = function() {
    if (_origApplyUserData) _origApplyUserData();
    notif.showBell(true);
};
