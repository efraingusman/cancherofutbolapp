                    <div style="background:rgba(255,255,255,0.03);border:1px solid #1e201e;border-radius:10px;padding:12px;text-align:center;">
                        <i class='bx ${icon}' style="color:#baff00;font-size:18px;"></i>
                        <div style="font-family:'Outfit',sans-serif;font-size:18px;font-weight:900;margin:4px 0;">${val}</div>
                        <div style="font-size:10px;color:#666;">${lbl}</div>
                    </div>`).join('')}
                </div>
                <p style="font-size:12px;color:#888;line-height:1.6;margin-bottom:20px;">Banners en la app, publicaciones patrocinadas en el feed, presencia en torneos y eventos. Contactanos y armamos un plan a medida para tu marca.</p>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <a href="https://wa.me/59896528701?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20sponsorship%20en%20Canchero" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#25D366;color:#000;padding:14px;border-radius:12px;font-weight:900;font-size:14px;text-decoration:none;letter-spacing:.5px;"><i class='bx bxl-whatsapp' style="font-size:18px;"></i> HABLAR POR WHATSAPP</a>
                    <a href="mailto:neurovidstudioia@gmail.com?subject=Sponsorship Canchero&body=Hola, quiero información sobre sponsorship en Canchero." style="display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(186,255,0,0.08);border:1px solid rgba(186,255,0,0.3);color:#baff00;padding:14px;border-radius:12px;font-weight:900;font-size:14px;text-decoration:none;letter-spacing:.5px;"><i class='bx bx-envelope' style="font-size:18px;"></i> ENVIAR EMAIL</a>
                </div>
            </div>
        </div>`;
    modal.addEventListener('click', e => { if (e.target === modal) modal.remove(); });
    document.body.appendChild(modal);
};

// ─── BIZ DROPDOWN (navbar + hero) ─────────────────────────────────────────────
window.toggleBizDropdown = function() {
    const d = document.getElementById('biz-dropdown');
    const chev = document.getElementById('biz-chev');
    const open = d.style.display === 'block';
    d.style.display = open ? 'none' : 'block';
    if (chev) chev.style.transform = open ? '' : 'rotate(180deg)';
    if (!open) {
        setTimeout(() => document.addEventListener('click', function h(e) {
            if (!document.getElementById('biz-entry-wrap').contains(e.target)) {
                d.style.display = 'none';
                if (chev) chev.style.transform = '';
                document.removeEventListener('click', h);
            }
        }), 10);
    }
};
window.toggleHeroBizDropdown = function() {
    const d = document.getElementById('hero-biz-dropdown');
    const open = d.style.display === 'block';
    d.style.display = open ? 'none' : 'block';
    if (!open) {
        setTimeout(() => document.addEventListener('click', function h(e) {
            if (!e.target.closest('[onclick="toggleHeroBizDropdown()"]') && !document.getElementById('hero-biz-dropdown').contains(e.target)) {
                d.style.display = 'none';
                document.removeEventListener('click', h);
            }
        }), 10);
    }
};
// loginAsBiz — va a login del CRM con rol pre-seleccionado
window.loginAsBiz = function(role) {
    document.getElementById('biz-dropdown') && (document.getElementById('biz-dropdown').style.display = 'none');
    document.getElementById('hero-biz-dropdown') && (document.getElementById('hero-biz-dropdown').style.display = 'none');
    window.open('crm.html?role=' + role, '_self');
};

// ─── DIRECTORIO MODAL (CeleBreak-inspired) ────────────────────────────────────
const URUGUAY_DEPTS = [
    { id:'montevideo',   name:'Montevideo',   img:'https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Montevideo_desde_el_Cerro_edit2.jpg/640px-Montevideo_desde_el_Cerro_edit2.jpg', lat:-34.9011, lng:-56.1645 },
    { id:'canelones',    name:'Canelones',    img:'', lat:-34.5200, lng:-56.2800 },
    { id:'maldonado',    name:'Maldonado',    img:'', lat:-34.9020, lng:-54.9614 },
    { id:'colonia',      name:'Colonia',      img:'', lat:-34.4622, lng:-57.8418 },
    { id:'salto',        name:'Salto',        img:'', lat:-31.3833, lng:-57.9670 },
    { id:'paysandu',     name:'Paysandú',     img:'', lat:-32.3228, lng:-58.0756 },
    { id:'rivera',       name:'Rivera',       img:'', lat:-30.9054, lng:-55.5506 },
    { id:'rocha',        name:'Rocha',        img:'', lat:-34.4830, lng:-54.3370 },
    { id:'tacuarembo',   name:'Tacuarembó',   img:'', lat:-31.7130, lng:-55.9820 },
    { id:'durazno',      name:'Durazno',      img:'', lat:-33.3700, lng:-56.5200 },
    { id:'florida',      name:'Florida',      img:'', lat:-34.0969, lng:-56.2144 },
    { id:'lavalleja',    name:'Lavalleja',    img:'', lat:-34.3700, lng:-55.2300 },
    { id:'soriano',      name:'Soriano',      img:'', lat:-33.5400, lng:-57.5000 },
    { id:'treintaytres', name:'Treinta y Tres',img:'', lat:-33.2341, lng:-54.3807 },
    { id:'flores',       name:'Flores',       img:'', lat:-33.5700, lng:-56.8800 },
    { id:'rio_negro',    name:'Río Negro',    img:'', lat:-32.7500, lng:-58.0200 },
    { id:'artigas',      name:'Artigas',      img:'', lat:-30.4000, lng:-56.4700 },
    { id:'cerro_largo',  name:'Cerro Largo',  img:'', lat:-32.3700, lng:-54.1800 },
    { id:'san_jose',     name:'San José',     img:'', lat:-34.3378, lng:-56.7131 },
];

let _dirMap = null;
let _dirType = 'complejos';
let _dirDept = null;
let _dirItems = [];
let _dirMarkers = [];

window.openDirectorioModal = async function(type) {
    _dirType = type || 'complejos';
    _dirDept = null;
    _dirItems = [];
    const modal = document.getElementById('directorio-modal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    _renderDepts();
};
window.closeDirectorioModal = function() {
    document.getElementById('directorio-modal').style.display = 'none';
    document.body.style.overflow = '';
    if (_dirMap) { _dirMap.remove(); _dirMap = null; }
};

const _typeLabel = { complejos:'Complejos', jugadores:'Jugadores', servicios:'Servicios', eventos:'Eventos', tienda:'Tienda' };
const _typeIcon  = { complejos:'bx-building-house', jugadores:'bx-run', servicios:'bx-briefcase', eventos:'bx-trophy', tienda:'bx-store' };

function _setBreadcrumb(parts) {
    document.getElementById('dir-breadcrumb').innerHTML = parts.map((p,i) =>
        `<span style="cursor:${i<parts.length-1?'pointer':'default'};color:${i<parts.length-1?'#baff00':'#fff'};" onclick="${p.onclick||''}">${p.label}</span>${i<parts.length-1?"<i class='bx bx-chevron-right' style='font-size:14px;'></i>":''}`
    ).join('');
}

function _renderDepts() {
    _setBreadcrumb([{ label: _typeLabel[_dirType] }]);
    const body = document.getElementById('dir-modal-body');
    body.innerHTML = `
        <div style="padding:16px 24px 8px;"><p style="color:#888;font-size:13px;">Seleccioná un departamento para ver los ${_typeLabel[_dirType].toLowerCase()}</p></div>
        <div class="dir-depts-grid">
            ${URUGUAY_DEPTS.map(d => `
                <div class="dir-dept-card" onclick="openDeptDir('${d.id}')">
                    ${d.img ? `<img src="${d.img}" alt="${d.name}">` : `<div style="width:100%;height:100%;background:linear-gradient(135deg,#0f1a0f,#1a2a1a);"></div>`}
                    <div class="dept-name">${d.name}<br><span class="dept-count" id="dept-count-${d.id}"></span></div>
                </div>`).join('')}
        </div>`;
    // Load counts async
    _loadDeptCounts();
}

async function _loadDeptCounts() {
    try {
        const bizType = _dirType === 'complejos' ? 'court' : _dirType === 'servicios' ? 'service' : _dirType === 'eventos' ? 'event' : null;
        let data = [];
        if (bizType) {
            const res = await sb.from('biz_items').select('payload').eq('type', bizType).eq('active', true);
            data = res.data || [];
        } else if (_dirType === 'tienda') {
            const res = await sb.from('products').select('payload').eq('active', true);
            data = res.data || [];
        }
        const countsByDept = {};
        data.forEach(item => {
            const dept = (item.payload?.dept || '').toLowerCase().replace(/\s+/g,'_');
            if (dept) countsByDept[dept] = (countsByDept[dept]||0)+1;
        });
        Object.entries(countsByDept).forEach(([dept, count]) => {
            const el = document.getElementById('dept-count-'+dept);
            if (el) el.textContent = count + ' registrado' + (count!==1?'s':'');
        });
    } catch(e) {}
}

window.openDeptDir = async function(deptId) {
    _dirDept = URUGUAY_DEPTS.find(d => d.id === deptId);
    if (!_dirDept) return;
    _setBreadcrumb([
        { label: _typeLabel[_dirType], onclick: `openDirectorioModal('${_dirType}')` },
        { label: _dirDept.name }
    ]);
    const body = document.getElementById('dir-modal-body');
    body.innerHTML = `<div style="display:flex;align-items:center;justify-content:center;flex:1;color:#888;font-size:13px;"><i class='bx bx-loader-alt bx-spin' style="margin-right:8px;"></i> Cargando...</div>`;

    // Fetch items
    try {
        const bizType = _dirType === 'complejos' ? 'court' : _dirType === 'servicios' ? 'service' : _dirType === 'eventos' ? 'event' : null;
        if (bizType) {
            const { data } = await sb.from('biz_items').select('*').eq('type', bizType).eq('active', true);
            _dirItems = (data||[]).filter(i => {
                const d = (i.payload?.dept||'').toLowerCase().replace(/\s+/g,'_');
                return !d || d === deptId; // show all if no dept set
            });
        } else if (_dirType === 'tienda') {
            const { data } = await sb.from('products').select('*').eq('active', true);
            _dirItems = data || [];
        } else {
            _dirItems = [];
        }
    } catch(e) { _dirItems = []; }

    _renderMapView();
};

function _renderMapView() {
    const body = document.getElementById('dir-modal-body');
    body.innerHTML = `
        <div class="dir-split">
            <div class="dir-map-pane" id="dir-map-container" style="height:100%;"></div>
            <div class="dir-list-pane">
                <div class="dir-list-header">
                    <div style="font-family:'Outfit',sans-serif;font-size:16px;font-weight:900;color:#fff;">${_dirDept?.name||''}</div>
                    <div style="font-size:12px;color:#888;margin-top:2px;">${_dirItems.length} ${_typeLabel[_dirType].toLowerCase()}${_dirItems.length!==1?'':'o'} encontrado${_dirItems.length!==1?'s':''}</div>
                </div>
                <div class="dir-filter-row" id="dir-filters"></div>
                <div class="dir-items-list" id="dir-items-list">
                    ${_dirItems.length === 0 ? `<div style="padding:40px;text-align:center;color:#555;"><i class='bx bx-buildings' style="font-size:48px;display:block;margin-bottom:12px;"></i>Aún no hay ${_typeLabel[_dirType].toLowerCase()} registrados en este departamento.<br><br><small>¿Tenés un negocio? <a onclick="navigate('register')" style="color:#baff00;cursor:pointer;">Registrate</a></small></div>` : _dirItems.map((item,i) => _complexCardHTML(item,i)).join('')}
                </div>
            </div>
        </div>
        <div class="dir-detail-panel" id="dir-detail-panel"></div>`;

    // Init map
    setTimeout(() => {
        const mapEl = document.getElementById('dir-map-container');
        if (!mapEl || !window.L) return;
        if (_dirMap) { _dirMap.remove(); _dirMap = null; }
        const center = _dirDept ? [_dirDept.lat, _dirDept.lng] : [-32.5, -56.0];
        _dirMap = L.map('dir-map-container', { zoomControl: true, attributionControl: false }).setView(center, _dirDept ? 11 : 7);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom:19 }).addTo(_dirMap);

        _dirMarkers = [];
        _dirItems.forEach((item, i) => {
            const lat = item.payload?.lat || (_dirDept?.lat + (Math.random()-.5)*.04) || center[0];
            const lng = item.payload?.lng || (_dirDept?.lng + (Math.random()-.5)*.04) || center[1];
            const icon = L.divIcon({
                className: '',
                html: `<div style="background:#baff00;color:#000;font-size:10px;font-weight:900;padding:4px 8px;border-radius:20px;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,0.5);cursor:pointer;">${(item.title||'').slice(0,14)}</div>`,
                iconAnchor: [0, 0]
            });
            const marker = L.marker([lat, lng], { icon }).addTo(_dirMap);
            marker.on('click', () => _highlightCard(i));
            _dirMarkers.push({ marker, lat, lng });
        });
    }, 100);

    // Filters for complejos
    if (_dirType === 'complejos') {
        const filters = document.getElementById('dir-filters');
        const sizes = ['F5','F7','F8','F9','F11'];
        const feats = ['Techado','Vestuarios','Duchas','Estacionamiento','Iluminación'];
        filters.innerHTML = sizes.map(s => `<button class="dir-filter-chip" onclick="filterComplexos('size','${s}',this)">${s}</button>`).join('') +
            feats.map(f => `<button class="dir-filter-chip" onclick="filterComplexos('feat','${f}',this)">${f}</button>`).join('');
    }
}

function _complexCardHTML(item, i) {
    const tags = [];
    if (item.payload?.sizes) item.payload.sizes.forEach(s => tags.push({ text: s, green: false }));
    if (item.payload?.covered) tags.push({ text: 'Techado', green: true });
    if (item.payload?.parking) tags.push({ text: 'Estacionamiento', green: true });
    if (item.payload?.showers) tags.push({ text: 'Duchas', green: false });
    const img = item.image_url || `https://placehold.co/70x60/0f110f/333?text=⚽`;
    const price = item.price ? `$${item.price}/hora` : '';
    return `<div class="dir-complex-card" id="dir-card-${i}" onclick="openComplexDetail(${i})">
        <img class="dir-complex-img" src="${img}" onerror="this.src='https://placehold.co/70x60/0f110f/333?text=⚽'" alt="">
        <div class="dir-complex-info">
            <div class="dir-complex-name">${item.title||'Sin nombre'}</div>
            <div class="dir-complex-city">${item.payload?.city||_dirDept?.name||''} ${price ? '· '+price : ''}</div>
            <div class="dir-complex-tags">${tags.slice(0,3).map(t=>`<span class="dir-tag ${t.green?'green':''}">${t.text}</span>`).join('')}</div>
        </div>
    </div>`;
}

function _highlightCard(i) {
    document.querySelectorAll('.dir-complex-card').forEach(c => c.classList.remove('highlighted'));
    const card = document.getElementById('dir-card-'+i);
    if (card) { card.classList.add('highlighted'); card.scrollIntoView({ behavior:'smooth', block:'nearest' }); }
}

window.openComplexDetail = function(i) {
    const item = _dirItems[i];
    if (!item) return;
    const panel = document.getElementById('dir-detail-panel');
    const tags = [];
    if (item.payload?.sizes) item.payload.sizes.forEach(s => tags.push(s));
    if (item.payload?.covered) tags.push('Techado');
    if (item.payload?.parking) tags.push('Estacionamiento');
    if (item.payload?.showers) tags.push('Duchas');
    if (item.payload?.lockers) tags.push('Vestuarios');
    if (item.payload?.lighting) tags.push('Iluminación');
    const wa = item.payload?.whatsapp ? `https://wa.me/${item.payload.whatsapp.replace(/\D/g,'')}` : '';
    panel.innerHTML = `
        <div style="padding:16px;border-bottom:1px solid #1e201e;display:flex;align-items:center;gap:10px;position:sticky;top:0;background:#070907;z-index:2;">
            <button onclick="document.getElementById('dir-detail-panel').classList.remove('open')" style="background:none;border:none;color:#fff;cursor:pointer;font-size:20px;"><i class='bx bx-arrow-back'></i></button>
            <span style="font-weight:800;font-size:15px;color:#fff;">${item.title||''}</span>
        </div>
        ${item.image_url ? `<img src="${item.image_url}" style="width:100%;height:200px;object-fit:cover;" onerror="this.style.display='none'">` : `<div style="width:100%;height:160px;background:linear-gradient(135deg,#0f1a0f,#1a2a1a);display:flex;align-items:center;justify-content:center;"><i class='bx bx-football' style="font-size:48px;color:#333;"></i></div>`}
        <div style="padding:20px;">
            <div style="font-family:'Outfit',sans-serif;font-size:22px;font-weight:900;margin-bottom:4px;">${item.title||''}</div>
            <div style="color:#888;font-size:13px;margin-bottom:16px;"><i class='bx bx-map-pin' style="color:#baff00;"></i> ${item.payload?.city||_dirDept?.name||'Uruguay'}</div>
            ${item.price ? `<div style="font-size:18px;font-weight:800;color:#baff00;margin-bottom:16px;">$${item.price} <span style="font-size:12px;color:#888;font-weight:400">/ hora</span></div>` : ''}
            ${item.description ? `<p style="font-size:13px;color:#aaa;line-height:1.6;margin-bottom:16px;">${item.description}</p>` : ''}
            ${tags.length ? `<div style="margin-bottom:16px;"><div style="font-size:10px;font-weight:800;letter-spacing:1px;color:#555;margin-bottom:8px;text-transform:uppercase;">Características</div><div style="display:flex;gap:6px;flex-wrap:wrap;">${tags.map(t=>`<span style="background:rgba(186,255,0,0.1);border:1px solid rgba(186,255,0,0.2);color:#baff00;padding:5px 10px;border-radius:20px;font-size:11px;font-weight:700;">${t}</span>`).join('')}</div></div>` : ''}
            ${item.payload?.courts ? `<div style="margin-bottom:16px;"><div style="font-size:10px;font-weight:800;letter-spacing:1px;color:#555;margin-bottom:8px;text-transform:uppercase;">Canchas disponibles</div><div style="font-size:24px;font-weight:900;color:#fff;">${item.payload.courts} <span style="font-size:13px;color:#888;font-weight:400">canchas</span></div></div>` : ''}
            <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px;">
                ${wa ? `<a href="${wa}" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#25D366;color:#000;padding:13px;border-radius:10px;font-weight:900;font-size:14px;text-decoration:none;"><i class='bx bxl-whatsapp'></i> Contactar por WhatsApp</a>` : ''}
                ${item.payload?.phone ? `<a href="tel:${item.payload.phone}" style="display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(186,255,0,0.1);border:1px solid rgba(186,255,0,0.3);color:#baff00;padding:13px;border-radius:10px;font-weight:900;font-size:14px;text-decoration:none;"><i class='bx bx-phone'></i> Llamar</a>` : ''}
            </div>
        </div>`;
    panel.classList.add('open');
};

window.filterComplexos = function(type, val, btn) {
    btn.classList.toggle('active');
    const activeChips = [...document.querySelectorAll('.dir-filter-chip.active')];
    const activeSizes = activeChips.filter(c=>c.getAttribute('onclick').includes("'size'")).map(c=>c.textContent.trim());
    const activeFeats = activeChips.filter(c=>c.getAttribute('onclick').includes("'feat'")).map(c=>c.textContent.trim());
    document.querySelectorAll('.dir-complex-card').forEach((card, i) => {
        const item = _dirItems[i];
        if (!item) return;
        let show = true;
        if (activeSizes.length) {
            const itemSizes = item.payload?.sizes || [];
            if (!activeSizes.some(s => itemSizes.includes(s))) show = false;
        }
        if (activeFeats.length) {
            if (activeFeats.includes('Techado') && !item.payload?.covered) show = false;
            if (activeFeats.includes('Estacionamiento') && !item.payload?.parking) show = false;
            if (activeFeats.includes('Duchas') && !item.payload?.showers) show = false;
            if (activeFeats.includes('Vestuarios') && !item.payload?.lockers) show = false;
            if (activeFeats.includes('Iluminación') && !item.payload?.lighting) show = false;
        }
        card.style.display = show ? '' : 'none';
    });
};

window.navigate = function(viewId) {
    if (viewId === 'admin') {
        if (!userData || userData.role !== 'admin') {
            showToast('Acceso denegado.', 'error');
            viewId = 'home';
            window.location.hash = 'home';
        }
    }

    // Paid roles that need approval redirect to jugador view pending approval
    const paidRoles = ['profesional','organizacion','tienda','sponsor'];
    if (paidRoles.includes(viewId)) {
        if (!userData || !userData.isComplexApproved) {
            // Show pending state
            showToast('Tu cuenta está pendiente de aprobación.', 'warning');
            viewId = 'home';
            window.location.hash = 'home';
        }
    }

    if (viewId === 'jugador' || viewId === 'club') {
        if (!userData) {
            showToast('Iniciá sesión para acceder.', 'warning');
            viewId = 'home';
            window.location.hash = 'home';
        } else {
            const role = userData.role;
            // Route paid non-club roles to jugador dashboard for now
            if (paidRoles.includes(role) && viewId === 'jugador') {
                // OK - let them see jugador dashboard
            } else if (role === 'jugador' && viewId === 'club') {
                showToast('Estás registrado como Jugador.', 'warning');
                viewId = 'jugador';
            } else if (role === 'club' && viewId === 'jugador') {
                showToast('Estás registrado como Complejo.', 'warning');
                viewId = 'club';
            }
        }
    }

    window.location.hash = viewId;
    localStorage.setItem('canchero_last_view', viewId);

    document.body.classList.remove('is-home', 'is-internal');
    if (viewId === 'home') {
        document.body.classList.add('is-home');
    } else {
        document.body.classList.add('is-internal');
    }

    document.querySelectorAll('.view-section').forEach(view => {
        view.style.display = 'none';
    });

    const targetView = document.getElementById(`view-${viewId}`);
    if (targetView) targetView.style.display = 'block';

    // Mobile Bottom Nav & Hamburger visibility based on Auth
    const playerBottomNav = document.getElementById('player-bottom-nav');
    const clubBottomNav = document.getElementById('club-bottom-nav');
    const btnHamburger = document.getElementById('btn-hamburger');
    const btnNavLogin = document.getElementById('btn-nav-login');
    const btnNavRegister = document.getElementById('btn-nav-register');
    const btnDownloadApp = document.getElementById('btn-download-app');
    const isLoggedIn = !!userData;
    
    if (playerBottomNav) playerBottomNav.style.display = 'none';
    if (clubBottomNav) clubBottomNav.style.display = 'none';
    
    if (isLoggedIn && window.innerWidth <= 1024) {
        if (userData.role === 'jugador') {
            if (playerBottomNav) playerBottomNav.style.display = 'flex';
        } else if (userData.role === 'club') {
            if (clubBottomNav) clubBottomNav.style.display = 'flex';
        }
    }
    
    // Top Navbar responsive toggles
    if (window.innerWidth <= 1024) {
        if (isLoggedIn) {
            if (btnHamburger) btnHamburger.style.display = 'block';
            if (btnNavLogin) btnNavLogin.style.display = 'none';
            if (btnNavRegister) btnNavRegister.style.display = 'none';
            if (btnDownloadApp) btnDownloadApp.style.display = 'none';
        } else {
            if (btnHamburger) btnHamburger.style.display = 'none';
            if (btnNavLogin) btnNavLogin.style.display = 'flex';
            if (btnNavRegister) btnNavRegister.style.display = 'flex';
            if (btnDownloadApp) btnDownloadApp.style.display = 'flex';
        }
    } else {
        // Desktop
        if (btnHamburger) btnHamburger.style.display = 'none';
        if (btnNavLogin) btnNavLogin.style.display = isLoggedIn ? 'none' : 'block';
        if (btnNavRegister) btnNavRegister.style.display = isLoggedIn ? 'none' : 'block';
        if (btnDownloadApp) btnDownloadApp.style.display = 'inline-flex';
    }

    // Active state for nav buttons: only highlight the one matching current view
    if (btnNavLogin) btnNavLogin.classList.remove('active');
    if (btnNavRegister) btnNavRegister.classList.remove('active');
    if (viewId === 'login' && btnNavLogin) btnNavLogin.classList.add('active');
    if (viewId === 'register' && btnNavRegister) btnNavRegister.classList.add('active');

    // Update hamburger menu: show/hide MI PANEL and CERRAR SESIÓN
    const mobileMenuPanel = document.getElementById('mobile-menu-mi-panel');
    const mobileMenuLogout = document.getElementById('mobile-menu-logout');
    if (mobileMenuPanel) mobileMenuPanel.style.display = isLoggedIn ? 'flex' : 'none';
    if (mobileMenuLogout) mobileMenuLogout.style.display = isLoggedIn ? 'flex' : 'none';

    const chatbotBtn = document.getElementById('chatbot-trigger');
    if (chatbotBtn) {
        if (viewId === 'jugador' || viewId === 'club') chatbotBtn.style.display = 'flex';
        else chatbotBtn.style.display = 'none';
    }

    if (viewId === 'register') {
        currentRegStep = 1;
        updateRegStepUI();
        generateAvailabilityGrid();
        setTimeout(updateCityOptions, 100);
        setTimeout(window.initBirthDateSelects, 100);
    }
    
    if (viewId === 'jugador' || viewId === 'club') {
        renderDashboardHome();
    }
}

window.toggleMobileMenu = function() {
    const menu = document.getElementById('mobile-menu-overlay');
    if (menu) {
        menu.style.display = menu.style.display === 'none' ? 'flex' : 'none';
    }
}

window.initBirthDateSelects = function() {
    const daySelect = document.getElementById('reg-birth-day');
    const monthSelect = document.getElementById('reg-birth-month');
    const yearSelect = document.getElementById('reg-birth-year');
    
    if (!daySelect || !monthSelect || !yearSelect) return;
    
    // Populate Days
    daySelect.innerHTML = '<option value="">Día</option>';
    for (let i = 1; i <= 31; i++) {
        const val = i < 10 ? '0' + i : '' + i;
        daySelect.innerHTML += `<option value="${val}">${i}</option>`;
    }
    
    // Populate Months
    const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    monthSelect.innerHTML = '<option value="">Mes</option>';
    months.forEach((m, idx) => {
        const val = (idx + 1) < 10 ? '0' + (idx + 1) : '' + (idx + 1);
        monthSelect.innerHTML += `<option value="${val}">${m}</option>`;
    });
    
    // Populate Years (e.g. 1950 to current - 5)
    const currentYear = new Date().getFullYear();
    yearSelect.innerHTML = '<option value="">Año</option>';
    for (let i = currentYear; i >= 1950; i--) {
        yearSelect.innerHTML += `<option value="${i}">${i}</option>`;
    }
}

window.logout = function() {
    localStorage.removeItem('canchero_user');
    userData = null;
    applyUserData();
    window.resetTheme();
    window.navigate('home');
}

window.switchUserRole = function() {
    if (!userData) return;
    
    // Ensure registeredRoles is initialized
    if (!userData.registeredRoles) {
        userData.registeredRoles = [userData.role];
    }
    
    const isPlayer = userData.role === 'jugador';
    const targetRole = isPlayer ? 'club' : 'jugador';
    
    if (userData.registeredRoles.includes(targetRole)) {
        // Already registered, allow quick switch!
        userData.role = targetRole;
        localStorage.setItem('canchero_user', JSON.stringify(userData));
        
        applyUserData();
        navigate(targetRole);
        
        // Show a brief premium toast
        const toast = document.createElement('div');
        toast.style = 'position:fixed; bottom:80px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.85); color:var(--accent); border:1px solid var(--accent); padding:12px 24px; border-radius:30px; font-weight:bold; font-family:var(--font-display); font-size:13px; z-index:99999; box-shadow:0 5px 15px rgba(0,0,0,0.5); text-transform:uppercase;';
        toast.innerHTML = `<i class='bx bx-transfer'></i> Perfil cambiado a ${targetRole === 'club' ? 'Complejo' : 'Jugador'}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2500);
        
    } else {
        // Not registered for the target role! Open premium custom onboarding modal
        if (targetRole === 'club') {
            openInlineComplexRegistration();
        } else {
            openInlinePlayerRegistration();
        }
    }
};

// ============================================================
// INLINE COMPLEX REGISTRATION MODAL
// ============================================================
function openInlineComplexRegistration() {
    const modal = document.createElement('div');
    modal.id = 'inline-reg-modal';
    modal.style = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); display:flex; align-items:center; justify-content:center; z-index:10000; padding:20px; font-family:var(--font-display); overflow-y:auto;';
    modal.innerHTML = `
        <div class="fut-card-large" style="width:100%; max-width:480px; background:#141414; border:2px solid var(--accent); border-radius:12px; padding:25px; box-shadow:0 0 25px var(--accent-glow); position:relative; max-height: 90vh; overflow-y: auto;">
            <button onclick="document.getElementById('inline-reg-modal').remove()" style="position:absolute; top:15px; right:15px; background:none; border:none; color:#888; font-size:24px; cursor:pointer;"><i class='bx bx-x'></i></button>
            <h2 style="color:var(--accent); text-transform:uppercase; font-size:20px; letter-spacing:1px; margin-bottom:5px; display:flex; align-items:center; gap:10px;"><i class='bx bx-store-alt'></i> REGISTRAR COMPLEJO</h2>
            <p style="color:#888; font-size:12px; margin-bottom:20px;">Registra tu complejo deportivo y espera la aprobación inmediata del administrador comercial.</p>
            
            <div style="display:flex; flex-direction:column; gap:12px; text-align:left;">
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">NOMBRE DEL COMPLEJO</label>
                    <input type="text" id="in-comp-name" class="form-control fs-input" placeholder="Ej: Centenario F5" style="width:100%;">
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">NOMBRE DEL PROPIETARIO</label>
                    <input type="text" id="in-comp-owner" class="form-control fs-input" placeholder="Ej: Juan Gómez" style="width:100%;">
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">CELULAR DE CONTACTO</label>
                    <input type="tel" id="in-comp-phone" class="form-control fs-input" placeholder="Ej: 099 123 456" style="width:100%;">
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">RUT COMERCIAL / NRO REGISTRO</label>
                    <input type="text" id="in-comp-rut" class="form-control fs-input" placeholder="Ej: 219999990012" style="width:100%;">
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">DIRECCIÓN DEL COMPLEJO</label>
                    <input type="text" id="in-comp-address" class="form-control fs-input" placeholder="Ej: Av. Rivera 3241" style="width:100%;">
                </div>
                <div style="display:flex; gap:10px;">
                    <div style="flex:1;">
                        <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">NRO CANCHAS</label>
                        <input type="number" id="in-comp-fields" class="form-control fs-input" value="2" min="1" style="width:100%;">
                    </div>
                    <div style="flex:1.5;">
                        <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">DEPARTAMENTO</label>
                        <select id="in-comp-city" class="form-control fs-input" style="width:100%;">
                            <option value="Montevideo">Montevideo</option>
                            <option value="Canelones">Canelones</option>
                            <option value="Maldonado">Maldonado</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">SERVICIOS</label>
                    <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px; background:rgba(0,0,0,0.2); padding:10px; border-radius:6px;">
                        <label style="font-size:11px; display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="in-srv-vestuario"> Vestuarios</label>
                        <label style="font-size:11px; display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="in-srv-cantina"> Cantina</label>
                        <label style="font-size:11px; display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="in-srv-parking"> Estacionamiento</label>
                        <label style="font-size:11px; display:flex; align-items:center; gap:5px; cursor:pointer;"><input type="checkbox" id="in-srv-parrillero"> Parrillero</label>
                    </div>
                </div>
            </div>
            
            <button onclick="submitInlineComplexRegistration()" class="btn btn-primary" style="width:100%; margin-top:20px; padding:12px; font-weight:bold; font-size:14px; text-transform:uppercase;"><i class='bx bx-check-circle'></i> FINALIZAR Y ENVIAR REGISTRO</button>
        </div>
    `;
    document.body.appendChild(modal);
}

window.submitInlineComplexRegistration = function() {
    const cName = document.getElementById('in-comp-name').value.trim();
    const owner = document.getElementById('in-comp-owner').value.trim();
    const phone = document.getElementById('in-comp-phone').value.trim();
    const rut = document.getElementById('in-comp-rut').value.trim();
    const address = document.getElementById('in-comp-address').value.trim();
    const fieldsCount = parseInt(document.getElementById('in-comp-fields').value || '1');
    const city = document.getElementById('in-comp-city').value;
    
    if(!cName || !owner || !phone || !rut || !address) {
        alert('Por favor, completa todos los campos para el registro comercial del complejo.');
        return;
    }
    
    // Save Complex Data into existing userData!
    userData.complexData = {
        owner: owner,
        complexName: cName,
        rut: rut,
        address: address,
        fieldsCount: fieldsCount,
        services: {
            vestuario: document.getElementById('in-srv-vestuario').checked,
            cantina: document.getElementById('in-srv-cantina').checked,
            parking: document.getElementById('in-srv-parking').checked,
            parrillero: document.getElementById('in-srv-parrillero').checked
        }
    };
    
    // Remove the registration modal
    document.getElementById('inline-reg-modal').remove();
    
    // Show simulated complex approval loading overlay!
    const overlay = document.createElement('div');
    overlay.id = 'approval-overlay';
    overlay.style = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:10000; color:white; font-family:var(--font-display); padding: 20px; text-align:center;';
    overlay.innerHTML = `
        <div class="fut-card-large" style="max-width:400px; background:rgba(20,20,20,0.9); border:2px solid var(--accent); border-radius:15px; padding:30px; box-shadow:0 0 30px var(--accent-glow);">
            <i class='bx bx-loader-alt bx-spin' style='font-size: 50px; color: var(--accent); margin-bottom: 20px;'></i>
            <h2 style='color:var(--accent); text-transform:uppercase; letter-spacing:1px; margin-bottom:15px;'>Enviando Solicitud</h2>
            <div id='approval-status' style='font-size:14px; margin-bottom:20px; line-height:1.6;'>
                Revisando credenciales del complejo...<br>
                <span style="color:#888;">Validando RUT: ${rut}</span><br>
                <span style="color:#888;">Propietario: ${owner}</span>
            </div>
            <div style="width:100%; background:rgba(255,255,255,0.1); height:6px; border-radius:3px; overflow:hidden; margin-top:20px;">
                <div id="approval-progress" style="width: 10%; height: 100%; background: var(--accent); transition: width 0.8s ease;"></div>
            </div>
        </div>
    `;
    document.body.appendChild(overlay);
    
    setTimeout(() => {
        document.getElementById('approval-progress').style.width = '60%';
        document.getElementById('approval-status').innerHTML = `
            Validación de RUT y propietario exitosa.<br>
            <span style="color:var(--accent);">Estado: Esperando aprobación de Administrador Canchero...</span>
        `;
    }, 1200);
    
    setTimeout(() => {
        document.getElementById('approval-progress').style.width = '100%';
        document.getElementById('approval-status').innerHTML = `
            <span style="color:var(--accent); font-weight:bold; font-size:18px;"><i class='bx bx-check-circle'></i> ¡REGISTRO APROBADO!</span><br>
            El administrador ha habilitado tu perfil de Complejo.<br>
            <span style="color:#888;">Ingresando a tu Panel...</span>
        `;
        
        // Add role & mark approved
        userData.registeredRoles.push('club');
        userData.isComplexApproved = true;
        userData.role = 'club';
        localStorage.setItem('canchero_user', JSON.stringify(userData));
    }, 2500);
    
    setTimeout(() => {
        document.body.removeChild(overlay);
        applyUserData();
        window.navigate('club');
    }, 3800);
};

