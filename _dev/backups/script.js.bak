    modal.innerHTML = `
        <div class="fut-card-large" style="width:100%; max-width:440px; background:#141414; border:2px solid var(--accent); border-radius:12px; padding:25px; box-shadow:0 0 25px var(--accent-glow); position:relative;">
            <button onclick="document.getElementById('inline-reg-modal').remove()" style="position:absolute; top:15px; right:15px; background:none; border:none; color:#888; font-size:24px; cursor:pointer;"><i class='bx bx-x'></i></button>
