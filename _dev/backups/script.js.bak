// ============ PLATFORM DETECTION ============
const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const isAndroid = /Android/.test(navigator.userAgent);
let isStandalone = false;
try { isStandalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true; } catch(e) {}

window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
});

// Adapt download buttons on page load
window.addEventListener('DOMContentLoaded', () => {
    const dlIcon = document.getElementById('download-icon');
    const dlLabel = document.getElementById('download-label');
    const footerLabel = document.getElementById('footer-download-label');
    const footerDesc = document.getElementById('footer-download-desc');
    
    if (isStandalone) {
        // Already installed as PWA - hide download buttons
        const btnNav = document.getElementById('btn-download-app');
        if (btnNav) btnNav.style.display = 'none';
    } else if (isIOS) {
        if (dlIcon) { dlIcon.className = 'bx bxl-apple'; }
        if (dlLabel) dlLabel.textContent = 'INSTALAR APP';
        if (footerLabel) footerLabel.textContent = 'INSTALAR EN iPHONE';
        if (footerDesc) footerDesc.textContent = 'Agregá Canchero a tu pantalla de inicio para la mejor experiencia.';
    } else if (isAndroid) {
        if (dlIcon) { dlIcon.className = 'bx bxl-android'; }
        if (dlLabel) dlLabel.textContent = 'DESCARGAR APK';
        if (footerLabel) footerLabel.textContent = 'DESCARGAR PARA ANDROID';
    }
    // Desktop stays as default
});

window.smartDownload = function() {
    if (isIOS) {
        // Show beautiful iOS install instructions modal
        const modal = document.getElementById('ios-install-modal');
        if (modal) {
            modal.style.display = 'flex';
            requestAnimationFrame(() => modal.classList.add('visible'));
        }
    } else if (isAndroid) {
        // Try native install prompt first, fall back to APK
        if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(({ outcome }) => {
                if (outcome === 'accepted') console.log('PWA installed');
                deferredPrompt = null;
            });
        } else {
            // Direct APK download (hosted on gofile.io — Vercel no soporta archivos >100MB)
            window.open('https://gofile.io/d/bsfFKA', '_blank');
        }
    } else {
        // Desktop - ofrecer el APK directamente (también sirve para mandárselo al celular)
        window.open('https://gofile.io/d/bsfFKA', '_blank');
    }
};

window.closeIOSModal = function() {
    const modal = document.getElementById('ios-install-modal');
    if (modal) {
        modal.classList.remove('visible');
        setTimeout(() => modal.style.display = 'none', 300);
    }
};

// Keep legacy function for backward compatibility
window.installApp = window.smartDownload;

