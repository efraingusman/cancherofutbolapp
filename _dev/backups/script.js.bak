};

window.addTeamInvitation = function() {
    const select = document.getElementById('ct-invitar-select');
    if (!select) return;
    const value = select.value;
    const text = select.options[select.selectedIndex].text;
    
    const container = document.getElementById('ct-invited-list');
    if (!container) return;
    const existing = container.querySelectorAll(`[data-val="${value}"]`);
    if (existing.length > 0) return;
    
    const badge = document.createElement('span');
    badge.className = 'badge';
    badge.setAttribute('data-val', value);
    badge.style.background = 'rgba(186,255,0,0.1)';
    badge.style.border = '1px solid var(--accent)';
    badge.style.color = 'var(--accent)';
    badge.style.padding = '5px 12px';
    badge.style.borderRadius = '20px';
    badge.style.fontSize = '12px';
    badge.style.display = 'flex';
    badge.style.alignItems = 'center';
    badge.style.gap = '6px';
    badge.innerHTML = `${text} <i class='bx bx-x' style='cursor:pointer;' onclick='this.parentElement.remove()'></i>`;
    container.appendChild(badge);
};

window.createTournamentAction = function() {
    // Gate: solo Profesionales/Organizaciones con sub activa pueden crear torneos/ligas
    if (window.cancheroFeatures && window.cancheroFeatures.subs) {
        if (!window.cancheroFeatures.subs.gateLeagueCreation()) return;
    }
    const nombre = document.getElementById('ct-nombre')?.value?.trim();
    if (!nombre) { alert('Ingresa el nombre del torneo.'); return; }
    const tipo    = document.getElementById('ct-tipo')?.value || 'liga';
    const equipos = document.getElementById('ct-equipos')?.value || '8';
    const premio  = document.getElementById('ct-premio')?.value || 'Por definir';
    const inscribirPropio = document.getElementById('ct-inscribir-propio')?.value;
    const abierto = document.getElementById('ct-abierto')?.checked;
    
    const invitedBadges = document.querySelectorAll('#ct-invited-list span');
    const invitedTeams = Array.from(invitedBadges).map(b => b.textContent.trim());

    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const content = document.getElementById(`${dashboard}-global-viewer-content`);
    if (!content) return;
    if(typeof switchDashboardTab === 'function') switchDashboardTab(dashboard, 'global-viewer');

    const myTeam = inscribirPropio ? 'F.C. Tres Cruces' : 'F.C. Tres Cruces';

    content.innerHTML = `
        <button class="btn btn-outline" style="margin-bottom:15px;" onclick="switchDashboardTab('${dashboard}', 'crear-torneo')">
            <i class='bx bx-left-arrow-alt'></i> VOLVER A CREAR TORNEO
        </button>
        
        <div class="social-profile" style="padding: 25px;">
            <div style="text-align: center; margin-bottom: 25px;">
                <span class="badge" style="background: var(--accent); color: #000; font-weight: bold; padding: 4px 10px; border-radius: 12px;">ADMINISTRADOR DEL TORNEO</span>
                <h1 style="color: var(--accent); font-family: var(--font-display); font-size: 28px; margin: 10px 0 5px; text-transform: uppercase;">${nombre}</h1>
                <p style="color: #888; font-size: 13px;">Modalidad: ${tipo.toUpperCase()} · Cupos: 1/${equipos} Equipos · Premio: ${premio}</p>
            </div>

            <div class="grid-2" style="gap: 20px;">
                <!-- EQUIPOS INSCRITOS -->
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 20px; border-radius: 12px;">
                    <h3 style="color: #fff; font-family: var(--font-display); border-bottom: 1px solid #222; padding-bottom: 10px; margin-top: 0; font-size: 16px;">
                        EQUIPOS INSCRITOS
                    </h3>
                    <ul style="list-style: none; padding: 0; margin: 15px 0 0;" id="ct-inscribed-list">
                        <li style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: rgba(186,255,0,0.05); border: 1px solid rgba(186,255,0,0.2); border-radius: 8px;">
                            <img src="https://ui-avatars.com/api/?name=TC&background=000&color=baff00" style="width: 32px; height: 32px; border-radius: 50%;" />
                            <div>
                                <strong style="color: var(--accent); font-size: 14px;">${myTeam}</strong>
                                <div style="font-size: 11px; color: #888;">Creador del Torneo (Mi Equipo)</div>
                            </div>
                        </li>
                    </ul>

                    <h3 style="color: #fff; font-family: var(--font-display); border-bottom: 1px solid #222; padding-bottom: 10px; margin-top: 25px; font-size: 16px;">
                        EQUIPOS INVITADOS (${invitedTeams.length})
                    </h3>
                    ${invitedTeams.length === 0 ? `
                        <p style="color: #555; font-size: 13px; margin: 15px 0 0;">No has invitado a ningún equipo específico.</p>
                    ` : `
                        <ul style="list-style: none; padding: 0; margin: 15px 0 0; display: flex; flex-direction: column; gap: 8px;">
                            ${invitedTeams.map(team => `
                                <li style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: rgba(0,0,0,0.2); border-radius: 8px; font-size: 13px; color: #ccc;">
                                    <span><i class='bx bx-mail-send' style="color: var(--accent); margin-right: 8px;"></i> ${team}</span>
                                    <span style="font-size: 11px; color: #ffaa00; background: rgba(255,170,0,0.1); padding: 2px 8px; border-radius: 10px;">Invitación Enviada</span>
                                </li>
                            `).join('')}
                        </ul>
                    `}
                </div>

                <!-- SOLICITUDES DE INGRESO -->
                <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 20px; border-radius: 12px;">
                    <h3 style="color: #fff; font-family: var(--font-display); border-bottom: 1px solid #222; padding-bottom: 10px; margin-top: 0; font-size: 16px;">
                        SOLICITUDES DE INGRESO
                    </h3>
                    ${abierto ? `
                        <div id="ct-requests-container" style="margin-top: 15px;">
                            <div class="ct-request-item" id="req-team-1" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <img src="https://ui-avatars.com/api/?name=BS&background=222&color=00ffcc" style="width: 32px; height: 32px; border-radius: 50%;" />
                                    <div>
                                        <strong style="color: #fff; font-size: 13px;">Barrio Sur F.C.</strong>
                                        <div style="font-size: 10px; color: #888;">Enviada hace 3 min</div>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <button class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;" onclick="approveTeamRequest('Barrio Sur F.C.', 'req-team-1')">ACEPTAR</button>
                                    <button class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 11px; border-color: #ff4d4d; color: #ff4d4d;" onclick="rejectTeamRequest('req-team-1')">RECHAZAR</button>
                                </div>
                            </div>
                            
                            <div class="ct-request-item" id="req-team-2" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <img src="https://ui-avatars.com/api/?name=LT&background=ff007f&color=fff" style="width: 32px; height: 32px; border-radius: 50%;" />
                                    <div>
                                        <strong style="color: #fff; font-size: 13px;">Los Terribles</strong>
                                        <div style="font-size: 10px; color: #888;">Enviada hace 12 min</div>
                                    </div>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <button class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;" onclick="approveTeamRequest('Los Terribles', 'req-team-2')">ACEPTAR</button>
                                    <button class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 11px; border-color: #ff4d4d; color: #ff4d4d;" onclick="rejectTeamRequest('req-team-2')">RECHAZAR</button>
                                </div>
                            </div>
                        </div>
                    ` : `
                        <p style="color: #666; font-size: 13px; margin: 15px 0 0;">
                            Invitación Abierta desactivada. Solo los equipos que invites directamente podrán inscribirse.
                        </p>
                    `}
                </div>
            </div>
            
            <button class="btn btn-primary" style="width: 100%; margin-top: 25px; font-weight: bold;" onclick="alert('¡Torneo publicado! Los equipos ya pueden buscarlo en el Mundo Fútbol.')">
                PUBLICAR Y ACTIVAR TORNEO
            </button>
        </div>
    `;
};

window.approveTeamRequest = function(teamName, elementId) {
    alert(`¡Has aprobado e inscrito al equipo "${teamName}" en tu torneo!`);
    const el = document.getElementById(elementId);
    if(el) el.remove();
    
    const container = document.getElementById('ct-inscribed-list');
    if(container) {
        const item = document.createElement('li');
        item.style.cssText = "display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-top: 8px;";
        item.innerHTML = `
            <img src="https://ui-avatars.com/api/?name=${teamName.substring(0,2)}&background=222&color=baff00" style="width: 32px; height: 32px; border-radius: 50%;" />
            <div>
                <strong style="color: #fff; font-size: 14px;">${teamName}</strong>
                <div style="font-size: 11px; color: #888;">Inscrito mediante Solicitud Abierta</div>
            </div>
        `;
        container.appendChild(item);
    }
};

window.rejectTeamRequest = function(elementId) {
    if(confirm('¿Seguro que deseas rechazar esta solicitud de inscripción?')) {
        const el = document.getElementById(elementId);
        if(el) el.remove();
    }
};

window.openApplicantsModal = function(matchId) {
    const mock = ['Martín García (Arquero)', 'Diego López (Defensa)', 'Nicolás Suárez (Mediocampo)'];
    alert(`SOLICITUDES PARA PARTIDO #${matchId}:\n\n${mock.join('\n')}\n\nPara gestionar solicitudes, ve a MATCH CENTER.`);
};

window.viewMatchDetails = function(matchId) {
    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const content = document.getElementById(`${dashboard}-global-viewer-content`);
    if (!content) return;
    if(typeof switchDashboardTab === 'function') switchDashboardTab(dashboard, 'global-viewer');

    const matches = {
        1: { 
            nombre:'Nocturno La Teja', 
            tipo:'11v11', 
            lugar:'Complejo La Teja', 
            hora:'Hoy 21:00', 
            precio:'$350/jugador', 
            organizador: 'Diego10 (Capitán)',
            equipoA: {
                nombre: 'F.C. Tres Cruces',
                logo: 'https://ui-avatars.com/api/?name=TC&background=000&color=baff00',
                jugadores: ['Diego López', 'Martín García', 'Elian10', 'Lucas Pérez', 'Guzmán Sosa', 'Felipe Ruiz', 'Juan Silva', 'Mateo Castro', 'Leandro Díaz', 'Enzo Pérez', 'Bruno Mendez']
            },
            equipoB: {
                nombre: 'C.A. Pocitos',
                logo: 'https://ui-avatars.com/api/?name=CP&background=111&color=00ffcc',
                jugadores: ['Sebastián Coates', 'Nicolás Suárez', 'Rodrigo Bentancur', 'Federico Valverde', 'Manuel Ugarte', 'Nahitan Nández', 'Mathías Olivera', 'Ronald Araújo', 'José Giménez', 'Guillermo Varela', 'Sergio Rochet']
            }
        },
        2: { 
            nombre:'Picado del Barrio', 
            tipo:'7v7', 
            lugar:'Núñez Fútbol', 
            hora:'Mañana 20:00', 
            precio:'$300/jugador',
            organizador: 'Gabi99 (Capitán)',
            equipoA: {
                nombre: 'Los Terribles',
                logo: 'https://ui-avatars.com/api/?name=LT&background=222&color=ff007f',
                jugadores: ['Gabi99', 'Facundo Pellistri', 'Brian Rodríguez', 'Maxi Araujo', 'Darwin Núñez', 'Luis Suárez', 'Matías Vecino']
            },
            equipoB: {
                nombre: 'Barrio Sur',
                logo: 'https://ui-avatars.com/api/?name=BS&background=0a0c0a&color=baff00',
                jugadores: ['Santiago Mele', 'Franco Israel', 'Camilo Cándido', 'Joaquín Piquerez', 'Lucas Olaza', 'Emiliano Martínez', 'Nicolás De La Cruz']
            }
        }
    };

    const m = matches[matchId] || {
        nombre: 'Partido Abierto #' + matchId,
        tipo: '5v5',
        lugar: 'Complejo Rambla',
        hora: 'Sábado 18:00',
        precio: '$250/jugador',
        organizador: 'Organizador Canchero',
        equipoA: { nombre: 'Equipo A', logo: 'https://ui-avatars.com/api/?name=A', jugadores: ['Jugador 1', 'Jugador 2', 'Jugador 3', 'Jugador 4', 'Jugador 5'] },
        equipoB: { nombre: 'Equipo B (Buscando rival)', logo: 'https://ui-avatars.com/api/?name=B', jugadores: ['Buscando...'] }
    };

    content.innerHTML = `
        <button class="btn btn-outline" style="margin-bottom:15px;" onclick="switchDashboardTab('${dashboard}', 'buscar-partidos')">
            <i class='bx bx-left-arrow-alt'></i> VOLVER A PARTIDOS
        </button>
        
        <div class="social-profile">
            <!-- Header/Cover -->
            <div class="cover-photo" style="background: linear-gradient(135deg, #0a0c0a, #112211, #0a0c0a); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; height: 160px;">
                <span class="badge" style="background: var(--accent); color: #000; font-weight: bold; margin-bottom: 8px; font-size: 11px; padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">
                    PARTIDO ABIERTO
                </span>
                <h1 style="color: var(--accent); font-family: var(--font-display); font-size: 26px; font-weight: 900; margin: 0; text-align: center; text-shadow: 0 0 10px rgba(186,255,0,0.5);">
                    ${m.nombre.toUpperCase()}
                </h1>
                <p style="color: #ccc; margin: 5px 0 0; font-size: 13px;"><i class='bx bx-time-five'></i> ${m.hora} · <i class='bx bx-map'></i> ${m.lugar}</p>
            </div>
            
            <div style="padding: 25px;">
                <!-- Detalles Principales -->
                <div class="grid-3" style="margin-bottom: 30px; gap: 15px;">
                    <div class="stat-box" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); padding: 15px; border-radius: 12px; text-align: center;">
                        <span style="font-size: 11px; color: #888; text-transform: uppercase; display: block; margin-bottom: 5px;">Modalidad</span>
                        <h4 style="font-size: 20px; color: #fff; margin: 0; font-family: var(--font-display);">${m.tipo}</h4>
                    </div>
                    <div class="stat-box" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); padding: 15px; border-radius: 12px; text-align: center;">
                        <span style="font-size: 11px; color: #888; text-transform: uppercase; display: block; margin-bottom: 5px;">Precio</span>
                        <h4 style="font-size: 20px; color: var(--accent); margin: 0; font-family: var(--font-display);">${m.precio}</h4>
                    </div>
                    <div class="stat-box" style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); padding: 15px; border-radius: 12px; text-align: center;">
                        <span style="font-size: 11px; color: #888; text-transform: uppercase; display: block; margin-bottom: 5px;">Organizador</span>
                        <h4 style="font-size: 14px; color: #fff; margin: 0; font-family: var(--font-display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${m.organizador}</h4>
                    </div>
                </div>

                <!-- Equipos e Integrantes -->
                <div class="grid-2" style="gap: 20px; margin-bottom: 30px;">
                    <!-- EQUIPO A -->
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px;">
                        <div style="display: flex; align-items: center; gap: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 15px;">
                            <img src="${m.equipoA.logo}" style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--accent);" />
                            <div>
                                <h3 style="margin: 0; font-size: 18px; color: #fff; font-family: var(--font-display);">${m.equipoA.nombre}</h3>
                                <span style="font-size: 11px; color: #888;">${m.equipoA.jugadores.length} anotados</span>
                            </div>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                            ${m.equipoA.jugadores.map((player, idx) => `
                                <li style="display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: #ccc; padding: 6px 10px; background: rgba(0,0,0,0.2); border-radius: 6px;">
                                    <span style="display: flex; align-items: center; gap: 8px; cursor: pointer;" onclick="viewProfileByName('${player}')">
                                        <i class='bx bx-user' style="color: var(--accent);"></i> ${player}
                                    </span>
                                    <span style="font-size: 10px; color: #888;">#${idx+1}</span>
                                </li>
                            `).join('')}
                        </ul>
                    </div>

                    <!-- EQUIPO B -->
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px;">
                        <div style="display: flex; align-items: center; gap: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 15px;">
                            <img src="${m.equipoB.logo}" style="width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--accent);" />
                            <div>
                                <h3 style="margin: 0; font-size: 18px; color: #fff; font-family: var(--font-display);">${m.equipoB.nombre}</h3>
                                <span style="font-size: 11px; color: #888;">${m.equipoB.jugadores.filter(x => x !== 'Buscando...').length} anotados</span>
                            </div>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
                            ${m.equipoB.jugadores.map((player, idx) => `
                                <li style="display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: #ccc; padding: 6px 10px; background: rgba(0,0,0,0.2); border-radius: 6px;">
                                    <span style="display: flex; align-items: center; gap: 8px; ${player !== 'Buscando...' ? 'cursor: pointer;' : ''}" ${player !== 'Buscando...' ? `onclick="viewProfileByName('${player}')"` : ''}>
                                        <i class='bx bx-user' style="color: ${player !== 'Buscando...' ? 'var(--accent)' : '#555'};"></i> ${player}
                                    </span>
                                    <span style="font-size: 10px; color: #888;">#${idx+1}</span>
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div style="display: flex; gap: 12px; margin-top: 20px;">
                    <button class="btn btn-primary" style="flex: 1; font-weight: bold; font-size: 14px;" onclick="alert('¡Te has postulado a este partido! El organizador recibirá tu solicitud.')">
                        <i class='bx bx-plus-circle'></i> POSTULARME A JUGAR
                    </button>
                    <button class="btn btn-glass" style="border: 1px solid var(--accent); color: var(--accent); font-weight: bold;" onclick="viewComplexProfile(1)">
                        <i class='bx bx-map-pin'></i> VER COMPLEJO
                    </button>
                </div>
            </div>
        </div>
    `;
};

window.openCourtModal = function() {
    alert('Funcionalidad de agregar cancha próximamente.');
};

window.createOpenMatchAction = function() {
    const fType = document.querySelector('#jugador-crear-partido .type-selector .type-btn.active')?.innerText || '11v11';
    const fecha = document.getElementById('cp-fecha')?.value;
    const hora = document.getElementById('cp-hora')?.value;
    const ciudad = document.getElementById('cp-ciudad')?.value || 'Montevideo';
    const cancha = document.getElementById('cp-cancha')?.value || 'Complejo La Teja';

    if (!fecha || !hora) {
        alert('Por favor, selecciona la fecha y hora del partido.');
        return;
    }

    // Detect match modality
    const activeModBtn = document.querySelector('#cp-modality-selector .type-btn.active');
    const modalityText = activeModBtn ? activeModBtn.innerText.toUpperCase() : 'ABIERTO';
    const modality = modalityText.includes('CERRADO') ? 'cerrado' : (modalityText.includes('INVITAR') ? 'invitar' : 'abierto');
    const oppTeam = document.getElementById('cp-opponent-team')?.value || 'La Blanqueada F.C.';

    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const content = document.getElementById(`${dashboard}-global-viewer-content`);
    if (!content) return;
    if(typeof switchDashboardTab === 'function') switchDashboardTab(dashboard, 'global-viewer');

    let matchPlayers = [{ name: 'Diego10 (Capitán)', pos: 'DEL', status: 'confirmado' }];

    const renderRoster = () => {
        const listEl = document.getElementById('om-roster-list');
        const countEl = document.getElementById('om-roster-count');
        if (!listEl) return;
        
        listEl.innerHTML = matchPlayers.map((p, idx) => `
            <li style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(0,0,0,0.25); border-radius: 8px; border: 1px solid rgba(255,255,255,0.03); font-size: 13px; color: #ccc;">
                <span style="display: flex; align-items: center; gap: 10px; cursor: pointer;" onclick="viewProfileByName('${p.name.split(' (')[0]}')">
                    <i class='bx bx-user' style="color: var(--accent); font-size: 16px;"></i>
                    <strong>${p.name}</strong>
                </span>
                <span class="badge" style="background: rgba(186,255,0,0.1); color: var(--accent); border: 1px solid var(--accent); font-size: 10px; padding: 2px 8px; border-radius: 12px; font-weight: bold; text-transform: uppercase;">
                    ${p.pos}
                </span>
            </li>
        `).join('');

        if (countEl) countEl.innerText = matchPlayers.length;
    };

    window.addPlayerManual = function() {
        const nameInput = document.getElementById('om-player-name');
        const posSelect = document.getElementById('om-player-pos');
        if (!nameInput || !posSelect) return;
        
        const name = nameInput.value.trim();
        const pos = posSelect.value;
        if (!name) {
            alert('Ingresa el nombre del jugador.');
            return;
        }

        matchPlayers.push({ name: name, pos: pos, status: 'confirmado' });
        nameInput.value = '';
        renderRoster();
        alert(`¡Jugador "${name}" agregado exitosamente al partido!`);
    };

    window.addMyTeamToMatch = function() {
        const teamPlayers = [
            { name: 'Diego López', pos: 'DEF' },
            { name: 'Martín García', pos: 'DEF' },
            { name: 'Nicolás Suárez', pos: 'MED' },
            { name: 'Lucas Pérez', pos: 'MED' },
            { name: 'Elian10', pos: 'POR' },
            { name: 'Guzmán Sosa', pos: 'MED' },
            { name: 'Felipe Ruiz', pos: 'DEF' }
        ];

        teamPlayers.forEach(p => {
            if (!matchPlayers.some(existing => existing.name === p.name)) {
                matchPlayers.push({ name: p.name, pos: p.pos, status: 'confirmado' });
            }
        });

        renderRoster();
        alert('¡Tu equipo "F.C. Tres Cruces" ha sido agregado al partido! Se ha enviado una notificación automática a todos los integrantes.');
    };

    window.acceptMatchApplicant = function(name, pos, reqId) {
        matchPlayers.push({ name: name, pos: pos, status: 'confirmado' });
        const el = document.getElementById(reqId);
        if (el) el.remove();
        renderRoster();
        alert(`¡Has aceptado la solicitud de ${name}! Se ha unido al partido.`);
    };

    window.rejectMatchApplicant = function(reqId) {
        if (confirm('¿Seguro que deseas rechazar esta solicitud?')) {
            const el = document.getElementById(reqId);
            if (el) el.remove();
        }
    };

    // Build modality header and sidebar dynamically
    let titleHtml = `PARTIDO ABIERTO EN ${cancha.toUpperCase()}`;
    let subtitleBadge = 'PARTIDO ABIERTO';
    if (modality === 'cerrado') {
        titleHtml = `PARTIDO PRIVADO EN ${cancha.toUpperCase()}`;
        subtitleBadge = 'PARTIDO CERRADO';
    } else if (modality === 'invitar') {
        titleHtml = `DESAFÍO DE CLUBES: TRES CRUCES vs ${oppTeam.toUpperCase()}`;
        subtitleBadge = 'RETO ENVIADO';
    }

    let sidebarHtml = '';
    if (modality === 'abierto') {
        sidebarHtml = `
            <div style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); padding: 20px; border-radius: 12px; height: fit-content;">
                <h3 style="color: #fff; font-family: var(--font-display); border-bottom: 1px solid #222; padding-bottom: 10px; margin-top: 0; font-size: 16px;">
                    SOLICITUDES DE INSCRIPCIÓN (INVITACIÓN ABIERTA)
                </h3>
                
                <div id="om-requests-container" style="margin-top: 15px;">
                    <div class="ct-request-item" id="om-req-1" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="https://randomuser.me/api/portraits/men/11.jpg" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--accent);" />
                            <div>
                                <strong style="color: #fff; font-size: 13px;">Martín García</strong>
                                <div style="font-size: 10px; color: var(--accent);">Golero · Uruguay</div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <button class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;" onclick="acceptMatchApplicant('Martín García', 'POR', 'om-req-1')">ACEPTAR</button>
                            <button class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 11px; border-color: #ff4d4d; color: #ff4d4d;" onclick="rejectMatchApplicant('om-req-1')">RECHAZAR</button>
                        </div>
                    </div>

                    <div class="ct-request-item" id="om-req-2" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="https://randomuser.me/api/portraits/men/32.jpg" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--accent);" />
                            <div>
                                <strong style="color: #fff; font-size: 13px;">Diego López</strong>
                                <div style="font-size: 10px; color: var(--accent);">Defensa · Canelones</div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <button class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;" onclick="acceptMatchApplicant('Diego López', 'DEF', 'om-req-2')">ACEPTAR</button>
                            <button class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 11px; border-color: #ff4d4d; color: #ff4d4d;" onclick="rejectMatchApplicant('om-req-2')">RECHAZAR</button>
                        </div>
                    </div>

                    <div class="ct-request-item" id="om-req-3" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="https://randomuser.me/api/portraits/men/44.jpg" style="width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--accent);" />
                            <div>
                                <strong style="color: #fff; font-size: 13px;">Nicolás Suárez</strong>
                                <div style="font-size: 10px; color: var(--accent);">Mediocentro · Montevideo</div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <button class="btn btn-primary btn-sm" style="padding: 4px 10px; font-size: 11px;" onclick="acceptMatchApplicant('Nicolás Suárez', 'MED', 'om-req-3')">ACEPTAR</button>
                            <button class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 11px; border-color: #ff4d4d; color: #ff4d4d;" onclick="rejectMatchApplicant('om-req-3')">RECHAZAR</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
    } else if (modality === 'cerrado') {
        sidebarHtml = `
            <div style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); padding: 30px; border-radius: 12px; height: fit-content; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
                <i class='bx bx-lock-alt' style="font-size: 56px; color: var(--accent); margin-bottom: 15px; text-shadow: 0 0 15px var(--accent-glow);"></i>
                <h3 style="color: #fff; font-family: var(--font-display); margin-top: 0; font-size: 16px; text-transform: uppercase; letter-spacing: 0.5px;">PARTIDO PRIVADO</h3>
                <p style="color: #aaa; font-size: 12px; max-width: 250px; line-height: 1.6; margin: 10px 0 0;">Este partido es 100% privado y cerrado al público. Solo los jugadores que agregues manualmente u organices en esta planilla podrán participar.</p>
            </div>
        `;
    } else if (modality === 'invitar') {
        sidebarHtml = `
            <div style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); padding: 25px; border-radius: 12px; height: fit-content;">
                <h3 style="color: #fff; font-family: var(--font-display); border-bottom: 1px solid #222; padding-bottom: 10px; margin-top: 0; font-size: 16px; text-transform: uppercase;">
                    DESAFÍO DE CLUBES
                </h3>
                <div style="text-align: center; padding: 20px 0;">
                    <i class='bx bx-paper-plane' style="font-size: 52px; color: var(--accent); margin-bottom: 15px; text-shadow: 0 0 15px var(--accent-glow);"></i>
                    <h4 style="color: #fff; font-size: 12px; margin: 5px 0; color: #888; text-transform: uppercase; letter-spacing: 0.5px;">RETADO A DUELO:</h4>
                    <strong style="color: var(--accent); font-size: 18px; text-transform: uppercase; letter-spacing: 1px;">${oppTeam.toUpperCase()}</strong>
                    <p style="color: #aaa; font-size: 12px; margin-top: 15px; line-height: 1.6;">La invitación formal de partido cerrado ha sido enviada al capitán del club rival. Se te notificará cuando confirmen el reto.</p>
                </div>
            </div>
        `;
    }

    content.innerHTML = `
        <button class="btn btn-outline" style="margin-bottom:15px;" onclick="switchDashboardTab('${dashboard}', 'crear-partido')">
            <i class='bx bx-left-arrow-alt'></i> VOLVER A CREAR PARTIDO
        </button>
        
        <div class="social-profile" style="padding: 25px;">
            <div style="text-align: center; margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 20px;">
                <span class="badge" style="background: var(--accent); color: #000; font-weight: bold; padding: 4px 10px; border-radius: 12px; font-size: 11px; text-transform: uppercase;">${subtitleBadge}</span>
                <h1 style="color: var(--accent); font-family: var(--font-display); font-size: 28px; margin: 12px 0 5px; text-transform: uppercase;">${titleHtml}</h1>
                <p style="color: #888; font-size: 13px;"><i class='bx bx-time-five'></i> ${fecha} a las ${hora} hs · <i class='bx bx-map'></i> ${ciudad} · <i class='bx bx-football'></i> Fútbol ${fType}</p>
            </div>

            <div class="grid-2" style="gap: 25px;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #222; padding-bottom: 10px; margin-bottom: 15px;">
                        <h3 style="color: #fff; font-family: var(--font-display); margin: 0; font-size: 16px;">
                            PLANTEL DEL PARTIDO (<span id="om-roster-count">1</span>)
                        </h3>
                        <button class="btn btn-primary btn-sm" style="font-size:11px; padding: 4px 10px;" onclick="addMyTeamToMatch()">
                            <i class='bx bx-group'></i> INTEGRAR MI EQUIPO
                        </button>
                    </div>

                    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;" id="om-roster-list">
                    </ul>

                    <div style="margin-top: 25px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 15px;">
                        <h4 style="color: #fff; font-family: var(--font-display); margin-top: 0; margin-bottom: 12px; font-size: 13px;">AGREGAR JUGADOR UNO POR UNO</h4>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" class="form-control" id="om-player-name" placeholder="Nombre del jugador..." style="flex: 2; height: 38px; font-size: 13px; padding: 0 12px;">
                            <select class="form-control" id="om-player-pos" style="flex: 1; height: 38px; font-size: 13px; padding: 0 12px;">
                                <option value="POR">POR</option>
                                <option value="DEF">DEF</option>
                                <option value="MED" selected>MED</option>
                                <option value="DEL">DEL</option>
                            </select>
                            <button class="btn btn-primary" style="height: 38px; padding: 0 15px;" onclick="addPlayerManual()"><i class='bx bx-plus'></i></button>
                        </div>
                    </div>
                </div>

                ${sidebarHtml}
            </div>
            
            <button class="btn btn-primary" style="width: 100%; margin-top: 30px; font-weight: bold; letter-spacing: 0.5px;" onclick="alert('¡Partido listo! Se ha publicado en tus actividades.')">
                <i class='bx bx-check-double'></i> TERMINAR Y PUBLICAR PARTIDO
            </button>
        </div>
    `;

    setTimeout(renderRoster, 50);
};


// ============================================================
// SHIELD & FLAG GENERATION LOGIC
// ============================================================

window.currentShieldShape = 'shield-classic';
window.setShieldShape = function(shape, el) {
    window.currentShieldShape = shape;
    document.querySelectorAll('.shape-opt').forEach(b => b.classList.remove('active'));
    if(el) el.classList.add('active');
    updateShieldPreview();
};

window.updateShieldPreview = function() {
    const preview = document.getElementById('identity-preview-render');
    if(!preview) return;
    
    // Check if custom upload exists
    const fileInput = document.getElementById('club-custom-shield-upload');
    if(fileInput && fileInput.files && fileInput.files.length > 0) {
        return;
    }

    const c1 = document.getElementById('club-color-1') ? document.getElementById('club-color-1').value : '#baff00';
    const c2 = document.getElementById('club-color-2') ? document.getElementById('club-color-2').value : '#000000';
    const c3 = document.getElementById('club-color-3') ? document.getElementById('club-color-3').value : '#ffffff';
    const border = document.getElementById('club-color-4') ? document.getElementById('club-color-4').value : '#000000';
    const textColor = document.getElementById('club-color-5') ? document.getElementById('club-color-5').value : '#ffffff';
    const textBorder = document.getElementById('club-color-text-border') ? document.getElementById('club-color-text-border').value : '#000000';
    const text = document.getElementById('club-shield-text') ? document.getElementById('club-shield-text').value.toUpperCase() : 'CLUB';
    
    const size = document.getElementById('club-shield-text-size') ? document.getElementById('club-shield-text-size').value : 20;
    const posX = document.getElementById('club-shield-text-x') ? document.getElementById('club-shield-text-x').value : 50;
    const posY = document.getElementById('club-shield-text-y') ? document.getElementById('club-shield-text-y').value : 55;
    
    const pattern = document.getElementById('club-shield-pattern') ? document.getElementById('club-shield-pattern').value : 'solid';
    const count = document.getElementById('club-shield-pattern-count') ? document.getElementById('club-shield-pattern-count').value : 5;
    
    // Generate SVG
    let patternSVG = '';
    const defs = `<defs>
        <pattern id="shield-pattern" width="${100/count}" height="${100/count}" patternUnits="userSpaceOnUse">
            <rect width="100%" height="100%" fill="${c1}" />
            <rect width="${pattern === 'vertical' ? '50%' : '100%'}" height="${pattern === 'horizontal' ? '50%' : '100%'}" fill="${c2}" />
        </pattern>
    </defs>`;
    
    let pathD = "M50 5 L95 25 V75 L50 95 L5 75 V25 Z"; // classic
    if(window.currentShieldShape === 'shield-circle') pathD = "M 50, 50 m -45, 0 a 45,45 0 1,0 90,0 a 45,45 0 1,0 -90,0";
    else if(window.currentShieldShape === 'shield-square') pathD = "M10 10 H90 V90 H10 Z";
    
    const svg = `
        <svg viewBox="0 0 100 100" width="100%" height="100%">
            ${defs}
            <path d="${pathD}" fill="${pattern === 'solid' ? c1 : 'url(#shield-pattern)'}" stroke="${border}" stroke-width="4"/>
            <text x="${posX}" y="${posY}" font-family="Arial" font-weight="900" font-size="${size}" fill="${textColor}" stroke="${textBorder}" stroke-width="1" text-anchor="middle" dominant-baseline="middle">${text}</text>
        </svg>
    `;
    
    preview.innerHTML = svg;
};

window.updateFlagPreview = function() {
    const preview = document.getElementById('identity-preview-render');
    if(!preview) return;

    // Check if custom upload exists
    const fileInput = document.getElementById('club-custom-flag-upload');
    if(fileInput && fileInput.files && fileInput.files.length > 0) {
        return;
    }

    const c1 = document.getElementById('flag-color-1') ? document.getElementById('flag-color-1').value : '#000000';
    const c2 = document.getElementById('flag-color-2') ? document.getElementById('flag-color-2').value : '#baff00';
    const c3 = document.getElementById('flag-color-3') ? document.getElementById('flag-color-3').value : '#ffffff';
    
    const style = document.getElementById('club-flag-style') ? document.getElementById('club-flag-style').value : 'horizontal';
    const pos = document.getElementById('club-flag-detail-pos') ? document.getElementById('club-flag-detail-pos').value : 50;

    let flagContent = '';
    if (style === 'horizontal') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <rect y="${pos}" width="100" height="20" fill="${c2}"/>
            <rect y="${Math.min(100, parseInt(pos)+20)}" width="100" height="10" fill="${c3}"/>
        `;
    } else if (style === 'vertical') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <rect x="${pos}" width="20" height="100" fill="${c2}"/>
            <rect x="${Math.min(100, parseInt(pos)+20)}" width="10" height="100" fill="${c3}"/>
        `;
    } else if (style === 'diagonal') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <polygon points="0,0 100,100 0,100" fill="${c2}"/>
            <polygon points="0,0 100,0 100,100" fill="${c1}"/>
            <line x1="0" y1="0" x2="100" y2="100" stroke="${c3}" stroke-width="5"/>
        `;
    } else if (style === 'cross') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <rect x="40" width="20" height="100" fill="${c2}"/>
            <rect y="40" width="100" height="20" fill="${c2}"/>
            <rect x="45" width="10" height="100" fill="${c3}"/>
            <rect y="45" width="100" height="10" fill="${c3}"/>
        `;
    } else if (style === 'quads') {
        flagContent = `
            <rect width="50" height="50" fill="${c1}"/>
            <rect x="50" width="50" height="50" fill="${c2}"/>
            <rect y="50" width="50" height="50" fill="${c2}"/>
            <rect x="50" y="50" width="50" height="50" fill="${c1}"/>
            <circle cx="50" cy="50" r="15" fill="${c3}"/>
        `;
    } else if (style === 'stripes-thin') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <rect y="10" width="100" height="5" fill="${c2}"/>
            <rect y="30" width="100" height="5" fill="${c2}"/>
            <rect y="50" width="100" height="5" fill="${c2}"/>
            <rect y="70" width="100" height="5" fill="${c2}"/>
            <rect y="90" width="100" height="5" fill="${c2}"/>
        `;
    } else if (style === 'sun') {
        flagContent = `
            <rect width="100" height="100" fill="${c3}"/>
            <rect y="20" width="100" height="20" fill="${c1}"/>
            <rect y="60" width="100" height="20" fill="${c1}"/>
            <circle cx="50" cy="50" r="15" fill="${c2}" stroke="#000" stroke-width="1"/>
            <path d="M50 20 V80 M20 50 H80" stroke="${c2}" stroke-width="2"/>
        `;
    } else if (style === 'checkered') {
        flagContent = `
            <rect width="50" height="50" fill="${c1}"/>
            <rect x="50" width="50" height="50" fill="${c2}"/>
            <rect y="50" width="50" height="50" fill="${c2}"/>
            <rect x="50" y="50" width="50" height="50" fill="${c1}"/>
        `;
    } else if (style === 'triangles') {
        flagContent = `
            <rect width="100" height="100" fill="${c1}"/>
            <polygon points="0,0 30,50 0,100" fill="${c2}"/>
            <polygon points="100,0 70,50 100,100" fill="${c3}"/>
        `;
    } else if (style === 'border') {
        flagContent = `
            <rect width="100" height="100" fill="${c2}"/>
            <rect x="10" y="10" width="80" height="80" fill="${c1}"/>
            <rect x="20" y="20" width="60" height="60" fill="${c3}"/>
        `;
    }

    const svg = `
        <svg viewBox="0 0 100 100" width="100%" height="100%">
            ${flagContent}
        </svg>
    `;
    preview.innerHTML = svg;
};

window.switchIdentityTab = function(tab, el) {
    document.querySelectorAll('.identity-tabs button').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    
    document.getElementById('identity-shield-editor').style.display = tab === 'shield' ? 'block' : 'none';
    document.getElementById('identity-flag-editor').style.display = tab === 'flag' ? 'block' : 'none';
    
    document.getElementById('download-type-text').innerText = tab === 'shield' ? 'ESCUDO' : 'BANDERA';
    
    if(tab === 'shield') updateShieldPreview();
    else updateFlagPreview();
};

window.syncShieldToFlag = function() {
    const c1 = document.getElementById('club-color-1')?.value || '#baff00';
    const c2 = document.getElementById('club-color-2')?.value || '#000000';
    
    const fc1 = document.getElementById('flag-color-1');
    const fc2 = document.getElementById('flag-color-2');
    
    if (fc1) fc1.value = c1;
    if (fc2) fc2.value = c2;
    
    updateShieldPreview();
    updateFlagPreview();
};

window.handleCustomShieldUpload = function(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('identity-preview-render');
            if (preview) {
                preview.innerHTML = `<img src="${e.target.result}" style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 0 20px var(--accent-glow);" />`;
            }
        };
        reader.readAsDataURL(input.files[0]);
    }
};

window.handleCustomFlagUpload = function(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('identity-preview-render');
            if (preview) {
                preview.innerHTML = `<img src="${e.target.result}" style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 0 20px var(--accent-glow);" />`;
            }
        };
        reader.readAsDataURL(input.files[0]);
    }
};

window.downloadIdentity = function() {
    const preview = document.getElementById('identity-preview-render');
    if (!preview || !preview.firstElementChild) {
        alert('No hay nada para descargar.');
        return;
    }
    
    const svgData = new XMLSerializer().serializeToString(preview.firstElementChild);
    const svgBlob = new Blob([svgData], {type: "image/svg+xml;charset=utf-8"});
    const svgUrl = URL.createObjectURL(svgBlob);
    
    const downloadLink = document.createElement("a");
    downloadLink.href = svgUrl;
    downloadLink.download = document.getElementById('download-type-text').innerText === 'ESCUDO' ? 'escudo-canchero.svg' : 'bandera-canchera.svg';
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
};

window.saveClubIdentity = function() {
    const preview = document.getElementById('identity-preview-render');
    if (!preview || !preview.firstElementChild) {
        alert('No hay identidad que guardar.');
        return;
    }

    const c1 = document.getElementById('club-color-1') ? document.getElementById('club-color-1').value : '#baff00';
    document.documentElement.style.setProperty('--accent', c1);
    document.documentElement.style.setProperty('--accent-glow', c1 + '44');

    alert('¡Identidad y colores del club guardados y aplicados exitosamente!');
};

window.setMatchModality = function(type, el) {
    document.querySelectorAll('#cp-modality-selector .type-btn').forEach(btn => btn.classList.remove('active'));
    if (el) el.classList.add('active');

    const extraDiv = document.getElementById('cp-modality-extra-options');
    if (!extraDiv) return;

    if (type === 'abierto') {
        extraDiv.style.display = 'none';
        extraDiv.innerHTML = '';
    } else if (type === 'cerrado') {
        extraDiv.style.display = 'block';
        extraDiv.innerHTML = `
            <div style="display: flex; align-items: center; gap: 10px; color: var(--accent);">
                <i class='bx bx-info-circle' style="font-size: 18px;"></i>
                <span style="font-size: 11px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase;">PARTIDO PRIVADO / CERRADO</span>
            </div>
            <p style="color: #aaa; font-size: 11px; margin: 6px 0 0; line-height: 1.4;">Este partido no aparecerá en las búsquedas públicas ni aceptará solicitudes de inscripción de desconocidos. Administrarás tu planilla de manera cerrada.</p>
        `;
    } else if (type === 'invitar') {
        extraDiv.style.display = 'block';
        extraDiv.innerHTML = `
            <label class="form-label" style="font-size: 10px; margin-bottom: 5px; color: var(--accent);">SELECCIONAR EQUIPO RIVAL</label>
            <select class="form-control" id="cp-opponent-team" style="height: 38px; font-size: 13px; padding: 0 12px; background: #111;">
                <option value="La Blanqueada F.C.">La Blanqueada F.C.</option>
                <option value="Maldonado Wanderers">Maldonado Wanderers</option>
                <option value="Punta Carretas Athletic">Punta Carretas Athletic</option>
                <option value="Cerro Largo United">Cerro Largo United</option>
            </select>
        `;
    }
};

// ============================================================
// CHATBOT - ASISTENTE VIRTUAL CANCHERO
// ============================================================
window.toggleChatbot = function() {
    const panel = document.getElementById('chatbot-panel');
    if (!panel) return;
    panel.classList.toggle('open');
    // Hide notification badge when opened
    const notif = document.getElementById('chat-notif');
    if (notif) notif.style.display = 'none';
};

window.sendChatbotMessage = function() {
    const input = document.getElementById('chatbot-input');
    const messagesContainer = document.getElementById('chatbot-messages');
    if (!input || !messagesContainer) return;

    const text = input.value.trim();
    if (!text) return;

    // Add user message
    const userMsg = document.createElement('div');
    userMsg.className = 'msg user';
    userMsg.textContent = text;
    messagesContainer.appendChild(userMsg);
    input.value = '';

    // Show typing indicator
    const typingMsg = document.createElement('div');
    typingMsg.className = 'msg typing';
    typingMsg.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Escribiendo...';
    messagesContainer.appendChild(typingMsg);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // Simulate AI response
    setTimeout(() => {
        messagesContainer.removeChild(typingMsg);
        const iaMsg = document.createElement('div');
        iaMsg.className = 'msg ia';
        iaMsg.innerHTML = generateChatbotResponse(text);
        messagesContainer.appendChild(iaMsg);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }, 800 + Math.random() * 1200);
};

function generateChatbotResponse(query) {
    const q = query.toLowerCase();

    // Reservations
    if (q.includes('reserv') || q.includes('cancha') || q.includes('alquil')) {
        return `🏟️ <strong>Reservar Cancha</strong><br><br>Para reservar una cancha:<br>
        1. Ve a <strong>Buscar Canchas</strong> en el menú<br>
        2. Selecciona un departamento en el mapa<br>
        3. Elige el complejo y la cancha disponible<br>
        4. Selecciona fecha, hora y confirma<br><br>
        Los métodos de pago aceptados son: <strong>Mercado Pago, Prex, MiDinero</strong> o transferencia bancaria.<br><br>
        ¿Necesitas ayuda con algo más?`;
    }

    // Matches
    if (q.includes('partido') || q.includes('jugar') || q.includes('match')) {
        return `⚽ <strong>Partidos</strong><br><br>Tienes varias opciones:<br>
        • <strong>Crear Partido Abierto:</strong> Cualquier jugador puede unirse<br>
        • <strong>Partido Cerrado:</strong> Solo por invitación<br>
        • <strong>Invitar Equipo:</strong> Desafía a otro equipo directamente<br><br>
        Ve a <strong>Crear Partido</strong> en el menú lateral para empezar. También puedes buscar partidos abiertos en <strong>Buscar Partidos</strong>.`;
    }

    // Tournaments
    if (q.includes('torneo') || q.includes('copa') || q.includes('campeonato')) {
        return `🏆 <strong>Torneos</strong><br><br>Puedes crear o unirte a torneos:<br>
        • <strong>Crear Torneo:</strong> Define formato, reglas y equipos<br>
        • <strong>Buscar Torneos:</strong> Encuentra torneos abiertos<br>
        • <strong>Invitación Abierta:</strong> Acepta equipos que quieran participar<br><br>
        Los torneos generan puntos extra para el <strong>Ranking Global</strong>.`;
    }

    // Team/Club
    if (q.includes('equipo') || q.includes('club') || q.includes('crear equipo')) {
        return `🛡️ <strong>Equipos</strong><br><br>Para crear tu equipo:<br>
        1. Ve a <strong>Mis Equipos</strong><br>
        2. Presiona <strong>Crear Mi Equipo</strong><br>
        3. Agrega nombre, escudo, colores y bandera<br>
        4. Invita jugadores a la plantilla<br><br>
        Como capitán puedes gestionar tácticas, planificación y la planilla del equipo.`;
    }

    // Ranking
    if (q.includes('ranking') || q.includes('puntos') || q.includes('nivel')) {
        return `📊 <strong>Ranking y Puntos</strong><br><br>Tu rating se calcula automáticamente según:<br>
        • Goles, asistencias y partidos jugados<br>
        • Premios MVP y victorias<br>
        • Participación en torneos<br><br>
        Acumula <strong>Puntos Canchero</strong> invitando amigos, jugando partidos y ganando torneos. ¡Los puntos desbloquean personalización premium!`;
    }

    // Premium
    if (q.includes('premium') || q.includes('personaliz')) {
        return `⭐ <strong>Premium</strong><br><br>Con 100+ puntos Canchero accedes a:<br>
        • Personalización de tarjeta (estilos Gold, Fire, Neon, Retro)<br>
        • Formas especiales (Hexagonal, Escudo)<br>
        • Badge exclusivo en tu perfil<br><br>
        ¡Gana puntos invitando amigos y jugando partidos!`;
    }

    // Live streaming
    if (q.includes('vivo') || q.includes('stream') || q.includes('transmit')) {
        return `📺 <strong>En Vivo</strong><br><br>Puedes transmitir partidos en vivo desde la sección <strong>En Vivo</strong>:<br>
        • Estadísticas en tiempo real<br>
        • Chat del partido<br>
        • Predicciones y apuestas con Canchero Coins<br>
        • Detección de jugadas destacadas con IA`;
    }

    // Contact / Help
    if (q.includes('contacto') || q.includes('ayuda') || q.includes('soporte') || q.includes('problema')) {
        return `📞 <strong>Contacto y Soporte</strong><br><br>Puedes comunicarte con nosotros:<br>
        • 📧 Email: <strong>neurovidstudioia@gmail.com</strong><br>
        • 📱 WhatsApp: <strong>096528701</strong><br><br>
        Nuestro equipo responde en menos de 24 horas. ¡Estamos para ayudarte!`;
    }

    // Complejo / Business
    if (q.includes('complejo') || q.includes('negocio') || q.includes('empresa')) {
        return `🏢 <strong>Complejos Deportivos</strong><br><br>Si eres dueño de un complejo deportivo puedes:<br>
        • Registrar tu complejo y gestionar canchas<br>
        • Panel CRM profesional con reservas, ventas, empleados<br>
        • Chatbot automático para WhatsApp<br>
        • Métodos de pago: Mercado Pago, Prex, MiDinero<br><br>
        Para registrar tu complejo, contacta a <strong>neurovidstudioia@gmail.com</strong> para activar tu cuenta.`;
    }

    // Greetings
    if (q.includes('hola') || q.includes('buenas') || q.includes('hey') || q.includes('qué tal')) {
        const userName = userData ? userData.name : 'crack';
        return `👋 ¡Hola <strong>${userName}</strong>! Soy tu asistente Canchero.<br><br>¿En qué te puedo ayudar? Puedo asistirte con:<br>
        • 🏟️ Reservar canchas<br>
        • ⚽ Crear partidos<br>
        • 🏆 Torneos<br>
        • 🛡️ Gestión de equipos<br>
        • 📊 Rankings y puntos<br>
        • 📞 Contacto y soporte`;
    }

    // Default
    return `🤖 Gracias por tu mensaje. Puedo ayudarte con:<br><br>
    • 🏟️ <strong>Reservas</strong> de canchas<br>
    • ⚽ <strong>Partidos</strong> (crear, buscar, unirse)<br>
    • 🏆 <strong>Torneos</strong> (crear, participar)<br>
    • 🛡️ <strong>Equipos</strong> (crear, gestionar)<br>
    • 📊 <strong>Rankings</strong> y puntos<br>
    • 📞 <strong>Soporte</strong> técnico<br><br>
    Escribe tu consulta y te ayudo al instante. También puedes contactarnos por WhatsApp al <strong>096528701</strong>.`;
}


