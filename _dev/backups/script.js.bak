}

window.calculatePlayerRating = function(stats, pos) {
    if (!stats || (stats.matches || 0) === 0) return 40; // Base rating for new players
    
    // Weight factors based on position
    let goalWeight = 5;
    let assistWeight = 3;
    let mvpWeight = 10;
    
    if (pos === 'DC') { goalWeight = 6; assistWeight = 2; }
    else if (pos === 'DEF' || pos === 'POR') { goalWeight = 2; assistWeight = 1; mvpWeight = 15; }
    else if (pos === 'MED') { goalWeight = 3; assistWeight = 6; }

    const score = ((stats.goals || 0) * goalWeight) + 
                  ((stats.assists || 0) * assistWeight) + 
                  ((stats.mvp || 0) * mvpWeight) + 
                  ((stats.matches || 0) * 1);
                  
    // Logarithmic growth: starts fast, slows down as it reaches 99
    // Starting at 40, each match/stat adds small points
    let rating = 40 + Math.floor(Math.sqrt(score * 20));
    return Math.min(99, rating);
};

window.resetTheme = function() {
    document.documentElement.style.setProperty('--accent', '#baff00');
    document.documentElement.style.setProperty('--accent-glow', 'rgba(186,255,0,0.3)');
    document.documentElement.style.setProperty('--brand-green', '#baff00');
}

function applyUserData() {
    const navActions = document.querySelector('.nav-actions');
    if (navActions) {
        if (userData) {
            const isPlayer = userData.role === 'jugador';
            navActions.innerHTML = `
                <button id="btn-hamburger" class="btn btn-fs-login" style="padding: 8px !important; margin-right:10px;" onclick="toggleMobileMenu()"><i class='bx bx-menu' style="font-size:24px; margin:0 !important;"></i></button>
            `;
            // En desktop mostrar también los botones de cerrar sesión
            if (window.innerWidth > 1024) {
                navActions.innerHTML = `
                    <button class="btn btn-fs-login" onclick="logout()" style="background:#ff4d4d; color:white; border-color:#ff4d4d; font-weight: 700;">CERRAR SESIÓN</button>
                    <button class="btn btn-fs-register" onclick="switchUserRole()" style="background:var(--accent); color:#000; font-weight: 700; margin-left: 10px;">${isPlayer ? 'A COMPLEJO' : 'A JUGADOR'}</button>
                `;
            }
        } else {
            navActions.innerHTML = `
                <button id="btn-nav-login" class="btn btn-fs-login" onclick="navigate('login')">ENTRAR</button>
                <button id="btn-nav-register" class="btn btn-fs-register" onclick="navigate('register')">REGISTRO</button>
                <button id="btn-download-app" class="btn btn-fs-register" style="background:#baff00; color:black; text-decoration:none; display:inline-flex; align-items:center; gap:3px; border:none; cursor:pointer; font-weight:800;" onclick="smartDownload()"><i class='bx bxl-android' id="download-icon" style="margin:0!important;"></i> <span id="download-label">DESCARGAR</span></button>
            `;
        }
    }

    if (!userData) return;
    
    // Apply to Player Dashboard
    const playerNames = document.querySelectorAll('.sidebar-user-info .name, .card-name, #p-display-name, .profile-name');
    playerNames.forEach(el => el.innerText = (userData.name || 'JUGADOR').toUpperCase());
    
    const pos = (userData.pos || 'DC').toUpperCase();
    document.querySelectorAll('.card-pos-val').forEach(el => el.innerText = pos.substring(0, 3));
    const displayPos = document.getElementById('p-display-pos');
    if (displayPos) displayPos.innerText = `(${pos})`;

    const playerAvatars = document.querySelectorAll('.sidebar-avatar, .card-img, .post-composer-avatar, .post-avatar, #edit-profile-preview');

    playerAvatars.forEach(el => {
        if (el.tagName === 'IMG') {
            el.src = userData.photo;
            el.style.objectFit = 'cover';
            if (el.id !== 'edit-profile-preview' && userData.photoStyle) {
                 // Convert range (0-100) to object-position (0-100%)
                 el.style.objectPosition = `${userData.photoStyle.x}% ${userData.photoStyle.y}%`;
                 // Note: zoom on IMG tags with object-fit is tricky, we use transform scale if needed
                 if (userData.photoStyle.zoom > 100) {
                     el.style.transform = `scale(${userData.photoStyle.zoom / 100})`;
                 } else {
                     el.style.transform = 'none';
                 }
            }
        } else {
            el.style.backgroundImage = `url('${userData.photo}')`;
            if (userData.photoStyle) {
                el.style.backgroundSize = `${userData.photoStyle.zoom}%`;
                el.style.backgroundPosition = `${userData.photoStyle.x}% ${userData.photoStyle.y}%`;
            } else {
                el.style.backgroundSize = 'cover';
                el.style.backgroundPosition = 'center';
            }
        }
    });

    // Apply Card Style & Shape (Premium)
    const card = document.querySelector('.fut-card-large');
    if (card) {
        card.classList.remove('card-premium-gold', 'card-premium-fire', 'card-premium-neon', 'card-premium-retro', 'shape-hexagon', 'shape-shield');
        if (checkPremiumStatus()) {
            if (userData.cardStyle && userData.cardStyle !== 'default') card.classList.add(`card-premium-${userData.cardStyle}`);
            if (userData.cardShape && userData.cardShape !== 'default') card.classList.add(`shape-${userData.cardShape}`);
        }
    }

    // Apply Stats & Calculate Rating
    if (!userData.stats) {
        userData.stats = { goals: 0, assists: 0, matches: 0, mvp: 0, rit: 60, reg: 60, tir: 60, def: 60, pas: 60, fis: 60 };
    }
    
    const calculatedRating = calculatePlayerRating(userData.stats, userData.pos || 'DC');
    userData.stats.rating = calculatedRating;

    globalStats = userData.stats;
    const ratings = document.querySelectorAll('#my-rating, .profile-card-rating, .val-rating');
    ratings.forEach(r => r.innerText = calculatedRating);

    // Apply availability state
    const availBadge = document.getElementById('profile-availability-badge');
    const availToggle = document.getElementById('availability-toggle');
    if (availBadge) {
        availBadge.style.background = userData.isAvailable ? '#baff00' : '#ff4444';
        availBadge.title = userData.isAvailable ? 'Disponible' : 'No disponible';
    }
    if (availToggle) availToggle.checked = !!userData.isAvailable;

    renderDashboardHome();

    const statsMap = {
        'rit': userData.stats.rit || 60,
        'reg': userData.stats.reg || 60,
        'tir': userData.stats.tir || 60,
        'def': userData.stats.def || 60,
        'pas': userData.stats.pas || 60,
        'fis': userData.stats.fis || 60
    };

    for (const [key, val] of Object.entries(statsMap)) {
        document.querySelectorAll(`.val-${key}`).forEach(el => el.innerText = val);
    }

    const goalsEl = document.getElementById('my-goals');
    const assistsEl = document.getElementById('my-assists');
    const matchesEl = document.getElementById('my-matches');
    const mvpEl = document.getElementById('my-mvp');

    if (goalsEl) goalsEl.innerText = userData.stats.goals;
    if (assistsEl) assistsEl.innerText = userData.stats.assists;
    if (matchesEl) matchesEl.innerText = userData.stats.matches || 0;
    if (mvpEl) mvpEl.innerText = userData.stats.mvp || 0;
    
    // Profile Badges Sync
    const bGoals = document.getElementById('p-stat-goles');
    const bAsist = document.getElementById('p-stat-asist');
    const bMatches = document.getElementById('p-stat-partidos');
    if (bGoals) bGoals.innerText = userData.stats.goals;
    if (bAsist) bAsist.innerText = userData.stats.assists;
    if (bMatches) bMatches.innerText = userData.stats.matches || 0;

    init3DCardTilt();
    populateSocialFeed();
    renderMisClubes();
    renderUserPosts(userData.role === 'jugador' ? 'jugador' : 'club');







    // Apply Club Data if exists (Legacy check - wrap in safety)
    const noClubView = document.getElementById('no-club-view');
    const clubProfileView = document.getElementById('club-profile-view');
    if (userData.club) {
        if (noClubView) noClubView.style.display = 'none';
        if (clubProfileView) {
            clubProfileView.style.display = 'block';
            const ceName = document.getElementById('club-entity-name');
            if (ceName) ceName.innerText = userData.club.name.toUpperCase();
            const ceHandle = document.getElementById('club-entity-handle');
            if (ceHandle) ceHandle.innerText = userData.club.handle;
            const ceBio = document.getElementById('club-entity-bio');
            if (ceBio) ceBio.innerText = userData.club.bio || 'Sin descripción.';
            const ceFans = document.getElementById('club-entity-fans');
            if (ceFans) ceFans.innerText = userData.club.fans || 0;
            
            const shieldImg = document.getElementById('club-entity-logo');
            const placeholder = document.getElementById('club-logo-placeholder');
            if (userData.club.logo && shieldImg) {
                shieldImg.src = userData.club.logo;
                shieldImg.style.display = 'block';
                if (placeholder) placeholder.style.display = 'none';
            }
        }
    } else {
        if (noClubView) noClubView.style.display = 'block';
        if (clubProfileView) clubProfileView.style.display = 'none';
    }

    // Apply Social Profile Info
    const handle = '@' + (userData.name || 'user').toLowerCase().replace(/\s/g,'');
    const loc = (userData.city || '') + (userData.nat ? ', ' + userData.nat : '');
    
    const pName = document.getElementById('p-display-name');
    if (pName) pName.innerText = userData.name.toUpperCase();
    const pPos = document.getElementById('p-display-pos');
    if (pPos) pPos.innerText = `(${userData.pos || 'DC'})`;

    const pHandle = document.getElementById('p-handle');
    if (pHandle) pHandle.innerText = handle;
    const pBio = document.getElementById('p-bio');
    if (pBio) pBio.innerText = userData.bio || 'Sin biografía.';
    const pLoc = document.getElementById('p-location');
    if (pLoc) pLoc.innerText = loc || 'Uruguay';
    const pLink = document.getElementById('p-link');
    if (pLink) pLink.innerText = userData.link || 'canchero.app';
    
    // Dynamically set joined date
    const pJoined = document.getElementById('p-joined-date');
    if (pJoined) {
        const months = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
        const d = new Date();
        pJoined.innerText = `Se unió en ${months[d.getMonth()]} ${d.getFullYear()}`;
    }

    // Set followers/following counts
    const followingEl = document.getElementById('p-following-count');
    const followersEl = document.getElementById('p-followers-count');
    if (followingEl) followingEl.innerText = userData.followingCount || 0;
    if (followersEl) followersEl.innerText = userData.followersCount || 0;

    // Badges visibility based on real accomplishments
    const badgeGoals = document.getElementById('p-badge-goleador');
    const badgeFollowers = document.getElementById('p-badge-seguidores');
    if (badgeGoals) badgeGoals.style.display = (userData.stats.goals && userData.stats.goals >= 10) ? 'block' : 'none';
    if (badgeFollowers) badgeFollowers.style.display = (userData.followersCount && userData.followersCount >= 100) ? 'block' : 'none';

    // Apply Cover Photo
    const playerCover = document.getElementById('player-cover');
    if (playerCover) {
        if (userData.coverPhoto) {
            playerCover.style.backgroundImage = `url('${userData.coverPhoto}')`;
            if (userData.coverStyle) {
                playerCover.style.backgroundSize = `${userData.coverStyle.zoom}%`;
                playerCover.style.backgroundPosition = `center ${userData.coverStyle.y}%`;
            } else {
                playerCover.style.backgroundSize = 'cover';
                playerCover.style.backgroundPosition = 'center';
            }
        } else {
            playerCover.style.backgroundImage = '';
        }
    }

    
    // Apply Info Tab
    const infoPos = document.getElementById('info-pos');
    if (infoPos) infoPos.innerText = userData.pos || 'Delantero';
    
    // Dynamically calculate age from birthdate
    let age = '—';
    if (userData.birth) {
        const birthDate = new Date(userData.birth);
        const ageDifMs = Date.now() - birthDate.getTime();
        const ageDate = new Date(ageDifMs);
        age = Math.abs(ageDate.getUTCFullYear() - 1970);
    }
    const infoAge = document.getElementById('info-age');
    if (infoAge) infoAge.innerText = age;

    const infoNat = document.getElementById('info-nat');
    if (infoNat) infoNat.innerText = userData.nat || '—';
    const infoCity = document.getElementById('info-city');
    if (infoCity) infoCity.innerText = userData.city || '—';
    const infoPhone = document.getElementById('info-phone');
    if (infoPhone) infoPhone.innerText = userData.phone || '—';
    const infoEmail = document.getElementById('info-email');
    if (infoEmail) infoEmail.innerText = userData.email || '—';

    // Apply to Complex Dashboard
    const complexProfile = document.querySelector('#view-club');
    if (complexProfile) {
        const clubName = complexProfile.querySelector('.sidebar-user-info .name');
        if (clubName) clubName.innerText = userData.name.toUpperCase();
        
        const clubAvatar = complexProfile.querySelectorAll('.sidebar-avatar');
        clubAvatar.forEach(av => {
            av.style.backgroundImage = `url('${userData.photo}')`;
            if (userData.photoStyle) {
                av.style.backgroundSize = `${userData.photoStyle.zoom}%`;
                av.style.backgroundPosition = `${userData.photoStyle.x}% ${userData.photoStyle.y}%`;
            }
        });

        // Social Info (Complex)
        const cName = document.getElementById('c-display-name');
        if (cName) cName.innerText = userData.name.toUpperCase();
        const cHandle = document.getElementById('c-handle');
        if (cHandle) cHandle.innerText = handle;
        const cBio = document.getElementById('c-bio');
        if (cBio) cBio.innerText = userData.bio || '🏟️ El mejor complejo de la zona.';
        const cLoc = document.getElementById('c-location');
        if (cLoc) cLoc.innerText = loc || 'Uruguay';
        const cLink = document.getElementById('c-link');
        if (cLink) cLink.innerText = userData.link || 'canchero.app';

        // Cover Photo (Complex)
        const clubCover = document.getElementById('club-cover');
        if (clubCover) {
            if (userData.coverPhoto) {
                clubCover.style.backgroundImage = `url('${userData.coverPhoto}')`;
                if (userData.coverStyle) {
                    clubCover.style.backgroundSize = `${userData.coverStyle.zoom}%`;
                    clubCover.style.backgroundPosition = `center ${userData.coverStyle.y}%`;
                } else {
                    clubCover.style.backgroundSize = 'cover';
                    clubCover.style.backgroundPosition = 'center';
                }
            } else {
                clubCover.style.backgroundImage = '';
            }
        }


        // Info Tab (Complex)
        const cNat = document.getElementById('c-info-nat');
        if (cNat) cNat.innerText = userData.nat || '—';
        const cCity = document.getElementById('c-info-city');
        if (cCity) cCity.innerText = userData.city || '—';
        const cPhone = document.getElementById('c-info-phone');
        if (cPhone) cPhone.innerText = userData.phone || '—';
        const cEmail = document.getElementById('c-info-email');
        if (cEmail) cEmail.innerText = userData.email || '—';
    }
    // Apply Club Identity Persistence
    if (userData.club) {
        applyClubIdentity();
    }
}








function checkNewNotifications() {
    if (!userData || userData.role !== 'club') return;
    const myRes = allReservations.filter(r => r.complex === userData.name || r.complex === 'Complejo La Teja');
    if (myRes.length > 0) {
        const badge = document.getElementById('res-notif-badge');
        if (badge) badge.style.display = 'block';
    }
}

// === PLAYER FUNCTIONALITY ===
window.addGoal = function() {
    globalStats.goals++;
    document.getElementById('my-goals').innerText = globalStats.goals;
    updateRating();
}
window.addAssist = function() {
    globalStats.assists++;
    document.getElementById('my-assists').innerText = globalStats.assists;
    updateRating();
}
function updateRating() {
    // Formula mock
    globalStats.rating = Math.min(99, 85 + Math.floor((globalStats.goals + globalStats.assists) / 50));
    document.getElementById('my-rating').innerText = globalStats.rating;
    const card = document.querySelector('.fut-card-large');
    card.style.borderColor = globalStats.rating >= 90 ? '#d4af37' : 'var(--accent)';
    alert(`¡Felicidades! Tus estadísticas se han actualizado.`);
}

window.crearPartido = function() {
    const fecha = document.getElementById('cp-fecha').value;
    const hora = document.getElementById('cp-hora').value;
    const cancha = document.getElementById('cp-cancha').value;
    
    if(!fecha || !hora) { alert('Completa fecha y hora.'); return; }
    
    const id = Date.now();
    const html = `
        <div class="match-list-item" id="match-${id}" style="border-color: var(--accent);">
            <div class="match-info">
                <div class="match-type-badge">11v11</div>
                <div class="match-details">
                    <h4>Mi Partido Abierto</h4>
                    <div class="match-meta"><span><i class='bx bx-map'></i> ${cancha}</span><span><i class='bx bx-time'></i> ${fecha} ${hora}</span><span><i class='bx bx-user'></i> <span class="players-count">1</span>/22</span></div>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:20px;"><div class="match-price">$350</div><button class="btn btn-outline" disabled>CREADO</button></div>
        </div>
    `;
    document.getElementById('partidos-list').insertAdjacentHTML('afterbegin', html);
    alert('Partido publicado exitosamente en la plataforma.');
    switchDashboardTab('jugador', 'buscar-partidos', document.querySelectorAll('.sidebar-menu .menu-item')[3]);
}

window.joinMatch = function(id) {
    const matchEl = document.getElementById(`match-${id}`);
    const countEl = matchEl.querySelector('.players-count');
    let count = parseInt(countEl.innerText);
    countEl.innerText = count + 1;
    const btn = matchEl.querySelector('button');
    btn.innerText = 'ANOTADO';
    btn.className = 'btn btn-primary';
    btn.onclick = null;
    alert('¡Te has anotado al partido! Podrás ver la confirmación en el chat del equipo.');
}

// === MAP FUNCTIONALITY ===
function renderMap() {
    const container = document.getElementById('map-markers-container');
    if(!container) return;
    container.innerHTML = '';
    
    UY_MAP_DATA.forEach(dept => {
        const marker = document.createElement('div');
        marker.className = 'map-marker';
        marker.style.left = `${dept.x}%`;
        marker.style.top = `${dept.y}%`;
        
        const lbl = document.createElement('div');
        lbl.className = 'map-marker-label';
        lbl.innerText = dept.n;
        marker.appendChild(lbl);

        marker.addEventListener('click', () => {
            document.getElementById('selected-dept-title').innerText = dept.n;
            document.querySelectorAll('.map-marker').forEach(m => m.classList.remove('active'));
            marker.classList.add('active');

            const deptIdx = UY_MAP_DATA.indexOf(dept);
            const complejos = genComplexes(deptIdx);
            const equipos   = genTeams(deptIdx);

            let html = `<h4 style="margin-bottom:10px;color:var(--accent);font-size:12px;letter-spacing:1px;">COMPLEJOS (${complejos.length})</h4>`;
            complejos.forEach(c => {
                html += `
                <div style="padding:12px;background:#111;border:1px solid #222;margin-bottom:8px;border-radius:8px;display:flex;justify-content:space-between;align-items:center;">
                    <div>
                        <div style="font-weight:700;font-size:13px;color:var(--accent);">${c.name}</div>
                        <div style="font-size:10px;color:#666;">${c.canchas} canchas · ${c.piso} · ⭐${c.rating}</div>
                        <div style="font-size:10px;color:#888;">$${c.precio}/h</div>
                    </div>
                    <button class="btn btn-primary btn-sm" onclick="alert('Reserva enviada a ${c.name}. Te contactarán pronto.')">RESERVAR</button>
                </div>`;
            });

            html += `<h4 style="margin:15px 0 8px;color:var(--accent);font-size:12px;letter-spacing:1px;">EQUIPOS (${equipos.length})</h4>`;
            equipos.forEach(e => {
                html += `<div style="padding:10px;background:#111;border:1px solid #222;margin-bottom:6px;border-radius:6px;display:flex;justify-content:space-between;font-size:12px;">
                    <span style="font-weight:700;">${e.name}</span>
                    <span style="color:#666;">${e.members} jug · ${e.wins}G ${e.draws}E ${e.losses}P</span>
                </div>`;
            });

            document.getElementById('dept-info-panel').innerHTML = html;
        });

        container.appendChild(marker);
    });
}

// === MOCK RENDERERS ===
function renderBuscarClubes() {
    const cityList = document.getElementById('street-city-list');
    const clubList = document.getElementById('street-club-list');
    if (!cityList || !clubList) return;

    const stored = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    const mock = [];
    const clubs = [...stored, ...mock];

    const byCity = {};
    clubs.forEach(club => {
        const city = club.city || 'Sin departamento';
        if (!byCity[city]) byCity[city] = [];
        byCity[city].push(club);
    });

    const cities = Object.keys(byCity);

    if (cities.length === 0) {
        cityList.innerHTML = `<div style="padding:20px; color:#666; font-size:13px;">No hay equipos registrados aún.</div>`;
        clubList.innerHTML = `<div style="padding:20px; color:#666; font-size:13px;">Crea el primer equipo desde "Mis Equipos".</div>`;
        return;
    }

    cityList.innerHTML = cities.map(city => `
        <div class="street-city-item" onclick="showClubsForCity('${city}')" style="padding:12px 15px; cursor:pointer; border-bottom:1px solid #222; font-size:13px; font-weight:700; letter-spacing:1px;">
            ${city.toUpperCase()} <span style="color:#666; font-weight:400;">(${byCity[city].length})</span>
        </div>
    `).join('');

    window._clubsByCity = byCity;

    showClubsForCity(cities[0]);
    const first = cityList.querySelector('.street-city-item');
    if (first) first.style.color = 'var(--accent)';
}

window.showClubsForCity = function(city) {
    const clubList = document.getElementById('street-club-list');
    if (!clubList) return;
    const clubs = (window._clubsByCity || {})[city] || [];

    document.querySelectorAll('.street-city-item').forEach(el => el.style.color = '');
    document.querySelectorAll('.street-city-item').forEach(el => {
        if (el.textContent.trim().toUpperCase().startsWith(city.toUpperCase())) el.style.color = 'var(--accent)';
    });

    clubList.innerHTML = clubs.map(club => `
        <div class="street-club-item" onclick="viewClubProfile(${club.id})" style="padding:12px 15px; cursor:pointer; border-bottom:1px solid #222; display:flex; align-items:center; gap:12px;">
            <div style="width:40px; height:40px; background:#000; border:1px solid var(--accent); border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden;">
                ${club.logo ? `<img src="${club.logo}" style="width:100%; height:100%; object-fit:cover;">` : `<i class='bx bxs-shield' style="color:var(--accent); font-size:20px;"></i>`}
            </div>
            <div>
                <div style="font-weight:700; font-size:13px; letter-spacing:1px;">${club.name}</div>
                ${club.bio ? `<div style="font-size:11px; color:#666; margin-top:2px;">${club.bio}</div>` : ''}
            </div>
        </div>
    `).join('');
};

function renderRanking() {
    const tbody = document.getElementById('ranking-body');
    const header = document.getElementById('ranking-header');
    const category = document.getElementById('ranking-category')?.value || 'puntos';
    if(!tbody) return;
    
    // Update header column name
    let label = category.toUpperCase();
    if(category === 'porteros') label = 'INVRICTAS';
    header.innerHTML = `<th>#</th><th>JUGADOR</th><th>EQUIPO</th><th>${label}</th>`;

    const names = ["F. Valverde", "D. Núñez", "R. Bentancur", "S. Coates", "Nicolás", "R. Araújo", "M. Olivera", "N. De La Cruz", "J. Rodríguez", "L. Suárez"];
    const equipos = ["C.A. Peñarol", "Club Nacional", "Defensor Sporting", "Danubio F.C.", "Liverpool F.C.", "Racing Club", "Wanderers", "Fénix F.C.", "Plaza Colonia", "Boston River"];
    
    let html = '';
    for(let i=0; i<10; i++) {
        const isMe = i === 4;
        const rankColor = i === 0 ? 'var(--accent)' : i === 1 ? '#C0C0C0' : i === 2 ? '#CD7F32' : 'inherit';
        
        let val = 0;
        if(category === 'puntos') val = 3500 - (i * 120);
        else if(category === 'goles') val = 42 - i;
        else if(category === 'asistencias') val = 28 - i;
        else if(category === 'porteros') val = 15 - Math.floor(i/2);

        html += `
            <tr ${isMe ? 'style="background: rgba(186,255,0,0.1); color:var(--accent); font-weight:bold;"' : ''}>
                <td style="color:${rankColor}">${i+1}</td>
                <td><div class="player-cell"><img src="${isMe ? 'https://randomuser.me/api/portraits/men/32.jpg' : `https://randomuser.me/api/portraits/men/${i+20}.jpg`}" style="border-radius:50%; object-fit:cover;"> ${isMe ? 'ELIAN10' : names[i]}</div></td>
                <td>${equipos[i]}</td>
                <td>${val}</td>
            </tr>
        `;
    }
    tbody.innerHTML = html;
}

function renderTeam() {
    const roster = document.getElementById('team-roster');
    if(!roster) return;
    const players = [
        {n:'ELIAN10', p:'DC', r:89, c:'gold', cap:true}, {n:'MATIS', p:'MCO', r:84, c:'gold'}, 
        {n:'PABLO', p:'MC', r:83, c:'gold'}, {n:'DIEGO', p:'DFC', r:81, c:''}, 
        {n:'GONZA', p:'LD', r:82, c:''}, {n:'ARQUERO', p:'POR', r:79, c:''}
    ];
    let html = players.map((p, i) => `
            <div class="mini-fut-wrapper ${p.r >= 83 ? 'gold' : ''}">
                <div class="mini-fut">
                    <div class="r" style="color: ${p.r >= 83 ? '#d4af37' : 'var(--accent)'}">${p.r}</div>
                    <div class="p">${p.p}</div>
                    <div class="mini-img" style="background-image:url('https://randomuser.me/api/portraits/men/${33 + i}.jpg')"></div>
                    <div class="mini-name">
                        ${p.cap ? '<i class="bx bxs-star" style="color:#FFD700; font-size:10px;"></i> ' : ''}${p.n}
                    </div>
                </div>
                <div style="font-size:9px; color:var(--text-muted); text-align:center; margin-top:5px; font-weight:700;">
                    ${p.p === 'DC' ? 'DELANTERO' : p.p === 'MC' || p.p === 'MCO' ? 'VOLANTE' : p.p === 'DFC' ? 'DEFENSA' : p.p === 'LD' ? 'LATERAL' : 'PORTERO'}
                </div>
            </div>
        `).join('');
    roster.innerHTML = html;
}

// === CLUB CHAT IA ===
window.sendIaMessage = function() {
    const input = document.getElementById('ia-chat-input');
    const text = input.value.trim();
    if(!text) return;
    
    const windowEl = document.getElementById('ia-chat-window');
    
    // User message
    const divIn = document.createElement('div');
    divIn.className = 'msg in';
    divIn.innerText = text;
    windowEl.appendChild(divIn);
    input.value = '';
    windowEl.scrollTop = windowEl.scrollHeight;

    // AI Reply simulation
    setTimeout(() => {
        const divOut = document.createElement('div');
        divOut.className = 'msg out';
        if(text.toLowerCase().includes('reserva') || text.toLowerCase().includes('cancha')) {
            divOut.innerText = '¡Perfecto! Tengo disponibilidad en la Cancha 1 a las 21:00 hs. ¿Te confirmo la reserva a tu nombre?';
        } else {
            divOut.innerText = 'Soy el asistente automatizado del complejo. Puedo ayudarte a gestionar reservas, ver horarios disponibles o precios. ¿Qué necesitas?';
        }
        windowEl.appendChild(divOut);
        windowEl.scrollTop = windowEl.scrollHeight;
    }, 1000);
}

// ============ SOCIAL PROFILE FUNCTIONS ============

window.switchProfileTab = function(dashboard, tabId, el) {
    const bar = el.closest('.profile-tabs-bar');
    bar.querySelectorAll('.profile-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');

    const profile = el.closest('.social-profile');
    profile.querySelectorAll('.profile-tab-content').forEach(c => c.style.display = 'none');
    const target = document.getElementById(`${dashboard}-profile-${tabId}`);
    if (target) target.style.display = 'block';

    if (dashboard === 'jugador' && tabId === 'fans') {
        const email = (window.userData && window.userData.email) || localStorage.getItem('canchero_email') || '';
        if (email) {
            try { social.loadFollowersList(email, 'fans-seguidores'); social.loadFollowingList(email, 'fans-siguiendo'); } catch(e) {}
        }
    }
}

window.openEditProfile = function() {
    const modal = document.getElementById('edit-profile-modal');
    modal.style.display = 'flex';
    document.getElementById('edit-name').value = userData?.name || '';
    document.getElementById('edit-bio').value = userData?.bio || '';
    document.getElementById('edit-link').value = userData?.link || '';
    const locVal = (userData?.city || '') + (userData?.nat ? ', ' + userData.nat : '');
    const locSelect = document.getElementById('edit-location');
    if (locSelect) {
        let found = Array.from(locSelect.options).some(opt => opt.value === locVal);
        if (found) locSelect.value = locVal;
        else if (locSelect.options.length > 0) locSelect.selectedIndex = 0;
    }
    document.getElementById('edit-pos').value = userData?.pos || 'DC';
    
    currentEditPhotoBase64 = userData?.photo || '';
    const preview = document.getElementById('edit-profile-preview');
    if (preview) {
        preview.src = currentEditPhotoBase64;
        if (userData?.photoStyle) {
            document.getElementById('edit-photo-zoom').value = userData.photoStyle.zoom || 100;
            document.getElementById('edit-photo-x').value = userData.photoStyle.x || 0;
            document.getElementById('edit-photo-y').value = userData.photoStyle.y || 0;
            updatePhotoPreviewTransform();
            document.getElementById('edit-photo-controls').style.display = 'block';
        } else {
            document.getElementById('edit-photo-zoom').value = 100;
            document.getElementById('edit-photo-x').value = 0;
            document.getElementById('edit-photo-y').value = 0;
            updatePhotoPreviewTransform();
            document.getElementById('edit-photo-controls').style.display = 'none';
        }
    }
    
    const ptsDisplay = document.getElementById('my-points-display');
    if (ptsDisplay) ptsDisplay.innerText = userData?.points || 0;

    const isPremium = checkPremiumStatus();
    document.getElementById('edit-premium-section').style.display = isPremium ? 'block' : 'none';
    document.getElementById('edit-premium-locked').style.display = isPremium ? 'none' : 'block';
    
    if (isPremium) {
        document.getElementById('edit-card-style').value = userData.cardStyle || 'default';
        document.getElementById('edit-card-shape').value = userData.cardShape || 'default';
    }
}


window.saveEditProfile = function() {
    if (!userData) return;
    userData.name = document.getElementById('edit-name').value;
    userData.bio = document.getElementById('edit-bio').value;
    userData.link = document.getElementById('edit-link').value;
    userData.pos = document.getElementById('edit-pos').value;
    
    const locVal = document.getElementById('edit-location').value;
    if (locVal && locVal.includes(',')) {
        const parts = locVal.split(',');
        userData.city = parts[0].trim();
        userData.nat = parts[1].trim();
    } else {
        userData.city = locVal;
    }
    
    if (currentEditPhotoBase64) {
        userData.photo = currentEditPhotoBase64;
    }
    
    userData.photoStyle = {
        zoom: document.getElementById('edit-photo-zoom').value,
        x: document.getElementById('edit-photo-x').value,
        y: document.getElementById('edit-photo-y').value
    };
    
    if (checkPremiumStatus()) {
        userData.cardStyle = document.getElementById('edit-card-style').value;
        userData.cardShape = document.getElementById('edit-card-shape').value;
    }
    
    localStorage.setItem('canchero_user', JSON.stringify(userData));
    applyUserData();
    document.getElementById('edit-profile-modal').style.display = 'none';
    alert('¡Perfil actualizado!');
}

window.handleProfilePhotoChange = function(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    const reader = new FileReader();
    reader.onload = function(e) {
        compressImage(e.target.result, 300, 300, 0.7, function(compressed) {
            currentEditPhotoBase64 = compressed;
            const preview = document.getElementById('edit-profile-preview');
            if (preview) {
                preview.src = currentEditPhotoBase64;
                document.getElementById('edit-photo-controls').style.display = 'block';
            }
        });
    };
    reader.readAsDataURL(file);
}

window.updatePhotoPreviewTransform = function() {
    const zoom = document.getElementById('edit-photo-zoom').value;
    const x = document.getElementById('edit-photo-x').value;
    const y = document.getElementById('edit-photo-y').value;
    const preview = document.getElementById('edit-profile-preview');
    if (preview) {
        preview.style.objectFit = 'cover';
        preview.style.objectPosition = `${50 + parseInt(x)}% ${50 + parseInt(y)}%`;
        preview.style.transform = `scale(${zoom / 100})`;
    }
}

let currentEditPhotoBase64 = null;

window.checkPremiumStatus = function() {
    if (!userData) return false;
    // Premium if they have 100 points or are explicitly marked premium
    return (userData.points && userData.points >= 100) || userData.isPremium;
}

let currentCoverBase64 = '';
let currentCoverType = 'jugador';

window.openCoverEditor = function(type) {
    currentCoverType = type;
    const modal = document.getElementById('cover-editor-modal');
    modal.style.display = 'flex';
    
    // Reset or Load current
    const preview = document.getElementById('cover-preview-box');
    const existingCover = userData.coverPhoto || '';
    if (existingCover) {
        preview.style.backgroundImage = `url('${existingCover}')`;
        currentCoverBase64 = existingCover;
    } else {
        preview.style.backgroundImage = '';
        currentCoverBase64 = '';
    }
    
    if (userData.coverStyle) {
        document.getElementById('cover-zoom').value = userData.coverStyle.zoom || 100;
        document.getElementById('cover-y').value = userData.coverStyle.y || 50;
    } else {
        document.getElementById('cover-zoom').value = 100;
        document.getElementById('cover-y').value = 50;
    }
    updateCoverPreview();
}

window.onCoverSelected = function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(ev) {
        // Compress cover to 800x300 at 0.6 quality for ultra-light storage footprint
        compressImage(ev.target.result, 800, 300, 0.6, function(compressed) {
            currentCoverBase64 = compressed;
            document.getElementById('cover-preview-box').style.backgroundImage = `url('${currentCoverBase64}')`;
            updateCoverPreview();
        });
    };
    reader.readAsDataURL(file);
}

window.updateCoverPreview = function() {
    const zoom = document.getElementById('cover-zoom').value;
    const y = document.getElementById('cover-y').value;
    const preview = document.getElementById('cover-preview-box');
    
    preview.style.backgroundSize = `${zoom}%`;
    preview.style.backgroundPosition = `center ${y}%`;
}

window.saveCoverEdits = function() {
    if (!userData) return;
    
    userData.coverPhoto = currentCoverBase64;
    userData.coverStyle = {
        zoom: document.getElementById('cover-zoom').value,
        y: document.getElementById('cover-y').value
    };
    
    try {
        localStorage.setItem('canchero_user', JSON.stringify(userData));
        applyUserData();
        document.getElementById('cover-editor-modal').style.display = 'none';
        alert('¡Portada guardada con éxito!');
    } catch(err) {
        console.error(err);
        alert('Hubo un error al guardar la portada. Por favor, intenta con otra imagen o una más pequeña.');
    }
}

window.previewPostMedia = function(input) {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        compressImage(e.target.result, 800, 600, 0.7, function(compressed) {
            currentPostMediaBase64 = compressed;
            const previewEl = document.getElementById('player-post-preview');
            if (previewEl) {
                previewEl.style.display = 'block';
                previewEl.innerHTML = `
                    <div style="position:relative; margin-top:10px; border-radius:8px; overflow:hidden; border:1px solid rgba(255,255,255,0.1);">
                        <img src="${currentPostMediaBase64}" style="width:100%; max-height:200px; object-fit:cover;">
                        <div style="position:absolute; top:5px; right:5px; background:rgba(0,0,0,0.8); color:#fff; width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; font-weight:bold; font-size:14px; line-height:24px;" onclick="clearPostMedia()">×</div>
                    </div>
                `;
            }
        });
    };
    reader.readAsDataURL(file);
}

window.clearPostMedia = function() {
    currentPostMediaBase64 = '';
    const previewEl = document.getElementById('player-post-preview');
    if (previewEl) {
        previewEl.innerHTML = '';
        previewEl.style.display = 'none';
    }
    const input = document.getElementById('player-post-media');
    if (input) input.value = '';
}

