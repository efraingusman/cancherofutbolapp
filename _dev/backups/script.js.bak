window.viewProfileByName = function(name) {
    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const content = document.getElementById(`${dashboard}-global-viewer-content`);
    if (!content) return;
    if(typeof switchDashboardTab === 'function') switchDashboardTab(dashboard, 'global-viewer');
    
    if(name.includes('Complejo')) {
        content.innerHTML = generateComplexProfileHTML({name: name, image: 'https://images.unsplash.com/photo-1551958219-acbc608c6377?auto=format&fit=crop&q=80&w=300', desc: 'Uruguay'});
    } else if(name.includes('Club')) {
        content.innerHTML = generateClubProfileHTML({name: name, image: 'https://ui-avatars.com/api/?name=C&background=000&color=baff00'});
    } else {
        content.innerHTML = generatePlayerProfileHTML({name: name, image: 'https://randomuser.me/api/portraits/men/30.jpg', desc: 'Uruguay', isMockUser: true});
    }
}

function generatePlayerProfileHTML(p) {
    return `
        <button class="btn btn-outline" style="margin-bottom:15px;" onclick="document.getElementById(userData.role + '-global-viewer-content').innerHTML=''; switchDashboardTab(userData.role, 'amigos')"><i class='bx bx-left-arrow-alt'></i> VOLVER AL FEED</button>
        <div class="social-profile">
            <div class="cover-photo" style="background-image:url('${p.image}'); background-size: cover; background-position: center; height:150px;"></div>
            <div style="padding:20px; margin-top:-60px; text-align:center;">
                <div style="width:100px; height:100px; border-radius:50%; background:#111; border:3px solid var(--accent); margin:0 auto 10px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    <img src="${p.image}" style="width:100%; height:100%; object-fit:cover;">
                </div>
                <h2 style="margin:0; font-family:var(--font-display);">${p.name.toUpperCase()}</h2>
                <p style="color:var(--accent); font-weight:bold; margin-top:5px;">RATING 85</p>
                <p style="color:#888; font-size:12px;">${p.desc}</p>
                
                <div class="grid-3" style="margin-top:20px;">
                    <div class="stat-box" style="background:#111; padding:15px; border-radius:8px; border:1px solid #333;"><h4>GOLES</h4><p style="font-size:24px; font-weight:bold; color:var(--accent);">12</p></div>
                    <div class="stat-box" style="background:#111; padding:15px; border-radius:8px; border:1px solid #333;"><h4>ASISTENCIAS</h4><p style="font-size:24px; font-weight:bold; color:var(--accent);">5</p></div>
                    <div class="stat-box" style="background:#111; padding:15px; border-radius:8px; border:1px solid #333;"><h4>MVP</h4><p style="font-size:24px; font-weight:bold; color:var(--accent);">3</p></div>
                </div>
                <div style="margin-top:20px; display:flex; gap:10px;">
                    <button class="btn btn-primary" style="flex:1;"><i class='bx bx-user-plus'></i> AGREGAR</button>
                    <button class="btn btn-glass" style="flex:1;"><i class='bx bx-message-rounded'></i> MENSAJE</button>
                </div>
            </div>
        </div>
    `;
}

