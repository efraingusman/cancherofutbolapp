                        <select id="in-play-city" class="form-control fs-input" style="width:100%;">
                            <option value="Montevideo" selected>Montevideo</option>
                            <option value="Canelones">Canelones</option>
                            <option value="Maldonado">Maldonado</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label style="font-size:11px; color:#aaa; font-weight:bold; display:block; margin-bottom:5px;">MODALIDAD PREFERIDA</label>
                    <div style="display:flex; gap:10px; justify-content:center;">
                        <button id="in-f5-btn" onclick="this.classList.toggle('active');" class="btn btn-glass active" style="flex:1; font-weight:bold; padding:8px;">F5</button>
                        <button id="in-f7-btn" onclick="this.classList.toggle('active');" class="btn btn-glass active" style="flex:1; font-weight:bold; padding:8px;">F7</button>
                        <button id="in-f11-btn" onclick="this.classList.toggle('active');" class="btn btn-glass" style="flex:1; font-weight:bold; padding:8px;">F11</button>
                    </div>
                </div>
            </div>
            
            <button onclick="submitInlinePlayerRegistration()" class="btn btn-primary" style="width:100%; margin-top:25px; padding:12px; font-weight:bold; font-size:14px; text-transform:uppercase;"><i class='bx bx-check-circle'></i> FINALIZAR REGISTRO JUGADOR</button>
        </div>
    `;
    document.body.appendChild(modal);
}

window.submitInlinePlayerRegistration = function() {
    const fTypes = [];
    if(document.getElementById('in-f5-btn').classList.contains('active')) fTypes.push('F5');
    if(document.getElementById('in-f7-btn').classList.contains('active')) fTypes.push('F7');
    if(document.getElementById('in-f11-btn').classList.contains('active')) fTypes.push('F11');
    
    // Save Player fields into existing userData!
    userData.pos = document.getElementById('in-play-pos').value;
    userData.foot = document.getElementById('in-play-foot').value;
    userData.nat = document.getElementById('in-play-nat').value;
    userData.city = document.getElementById('in-play-city').value;
    userData.fTypes = fTypes;
    
    // Add role
    userData.registeredRoles.push('jugador');
    userData.role = 'jugador';
    localStorage.setItem('canchero_user', JSON.stringify(userData));
    
    // Remove the registration modal
    document.getElementById('inline-reg-modal').remove();
    
    applyUserData();
    window.navigate('jugador');
};

window.setRegRole = function(role, el) {
    regRole = role;

    // Update type-card UI
    const grid = document.getElementById('reg-type-grid');
    if (grid) {
        grid.querySelectorAll('.type-card').forEach(c => c.classList.remove('active'));
    }
    if (el) el.classList.add('active');

    // Clear inputs
    const nameEl = document.getElementById('reg-name');
    const emailEl = document.getElementById('reg-email');
    const passEl = document.getElementById('reg-pass');
    if (nameEl) nameEl.value = '';
    if (emailEl) emailEl.value = '';
    if (passEl) passEl.value = '';

    // Update name label
    const labelName = document.getElementById('label-reg-name');
    const labelMap = {
        jugador: 'NOMBRE COMPLETO',
        club: 'NOMBRE DEL COMPLEJO',
        profesional: 'NOMBRE COMPLETO',
        organizacion: 'NOMBRE DE LA ORGANIZACIÓN',
        tienda: 'NOMBRE DE LA TIENDA',
        sponsor: 'NOMBRE DE LA EMPRESA / MARCA'
    };
    if (labelName) labelName.innerText = labelMap[role] || 'NOMBRE';

    // Sub-type selectors
    const profGroup = document.getElementById('reg-prof-type-group');
    const orgGroup = document.getElementById('reg-org-type-group');
    if (profGroup) profGroup.style.display = role === 'profesional' ? 'block' : 'none';
    if (orgGroup) orgGroup.style.display = role === 'organizacion' ? 'block' : 'none';

    // Role info text
    const infoEl = document.getElementById('reg-role-info');
    const infoMap = {
        jugador: 'Acceso gratuito. Tu perfil es público para toda la comunidad Canchero.',
        club: 'Requiere aprobación. Pago mensual con 7 días gratis al ser aprobado.',
        profesional: 'Árbitros, técnicos, preparadores y más. Requiere aprobación y suscripción.',
        organizacion: 'Clubes, ligas, escuelas de fútbol. Requiere aprobación y suscripción.',
        tienda: 'Vendé equipamiento, suplementos y accesorios en el marketplace. Requiere aprobación.',
        sponsor: 'Mostrá tu marca a toda la comunidad. Requiere aprobación y acuerdo comercial.'
    };
    if (infoEl) infoEl.innerText = infoMap[role] || '';

    // Form fields visibility
    const playerOnly = document.querySelectorAll('.player-only');
    const clubOnly = document.querySelectorAll('.club-only');

    if (role === 'jugador') {
        playerOnly.forEach(f => f.style.display = 'block');
        clubOnly.forEach(f => f.style.display = 'none');
    } else if (role === 'club') {
        playerOnly.forEach(f => f.style.display = 'none');
        clubOnly.forEach(f => f.style.display = 'block');
    } else {
        // profesional, organizacion, tienda, sponsor: minimal fields
        playerOnly.forEach(f => f.style.display = 'none');
        clubOnly.forEach(f => f.style.display = 'none');
    }
}

window.updateCityOptions = function() {
    const country = document.getElementById('reg-nat')?.value;
    const citySelect = document.getElementById('reg-city');
    if(!citySelect) return;
    
    citySelect.innerHTML = '<option value="">Seleccionar Ciudad</option>';
    if(country && CITY_DATA[country]) {
        CITY_DATA[country].forEach(city => {
            const opt = document.createElement('option');
            opt.value = city;
            opt.innerText = city;
            citySelect.appendChild(opt);
        });
    }
}

// ONBOARDING LOGIC
window.changeRegStep = function(n) {
    let nextStep = currentRegStep + n;

    const nonPlayerRoles = ['club','profesional','organizacion','tienda','sponsor'];
    // Skip availability step (4) for non-player roles
    if (nextStep === 4 && nonPlayerRoles.includes(regRole)) {
        nextStep += n;
    }
    // Skip photo step (5) for paid roles (photo can be added later)
    // but keep it for jugador

    if (nextStep < 1 || nextStep > 5) return;

    // Basic validation before moving forward
    if (n > 0) {
        if (currentRegStep === 1) {
            const name = document.getElementById('reg-name')?.value?.trim();
            const email = document.getElementById('reg-email')?.value?.trim();
            const pass = document.getElementById('reg-pass')?.value?.trim();
            if (!name || !email || !pass) { showToast('Completá nombre, email y contraseña.', 'warning'); return; }
            if (!email.includes('@')) { showToast('Ingresá un email válido.', 'warning'); return; }
        }
    }

    currentRegStep = nextStep;
    updateRegStepUI();
}

function updateRegStepUI() {
    document.querySelectorAll('.reg-step').forEach(step => step.style.display = 'none');
    document.getElementById(`reg-step-${currentRegStep}`).style.display = 'block';

    const progress = (currentRegStep / 5) * 100;
    document.getElementById('reg-progress').style.width = `${progress}%`;

    const titles = ["CUENTA", "PERFIL PERSONAL", "PERFIL DEPORTIVO", "DISPONIBILIDAD", "FOTO"];
    document.getElementById('reg-step-title').innerText = `PASO ${currentRegStep}: ${titles[currentRegStep-1]}`;

    // Nav buttons
    document.getElementById('btn-reg-back').style.display = currentRegStep > 1 ? 'block' : 'none';
    document.getElementById('btn-reg-next').style.display = currentRegStep < 5 ? 'block' : 'none';
    document.getElementById('btn-reg-submit').style.display = currentRegStep === 5 ? 'block' : 'none';
}

window.setGender = function(gender, el) {
    regGender = gender;
    el.parentElement.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
}

window.toggleFType = function(type, el) {
    if (regFType.includes(type)) {
        regFType = regFType.filter(t => t !== type);
        el.classList.remove('active');
    } else {
        regFType.push(type);
        el.classList.add('active');
    }
}

window.generateAvailabilityGrid = function() {
    const container = document.getElementById('reg-availability');
    if (!container) return;
    
    const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
    const times = ['Mañana', 'Tarde', 'Noche'];
    
    let html = '<div></div>'; // Corner
    times.forEach(t => html += `<div class="availability-header">${t.toUpperCase()}</div>`);
    
    days.forEach(d => {
        html += `<div class="availability-header" style="text-align:left;">${d.toUpperCase()}</div>`;
        times.forEach(t => {
            const isActive = regAvailability[d] && regAvailability[d].includes(t);
            html += `<div class="avail-cell ${isActive ? 'active' : ''}" onclick="toggleAvail('${d}', '${t}', this)">${t[0]}</div>`;
        });
    });
    
    container.innerHTML = html;
}

window.toggleAvail = function(day, time, el) {
    if (!regAvailability[day]) regAvailability[day] = [];
    
    if (regAvailability[day].includes(time)) {
        regAvailability[day] = regAvailability[day].filter(t => t !== time);
        el.classList.remove('active');
    } else {
        regAvailability[day].push(time);
        el.classList.add('active');
    }
}


window.onPhotoSelected = function(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
        currentPhotoBase64 = e.target.result;
        const preview = document.getElementById('onboarding-photo-preview');
        const editPreview = document.getElementById('edit-profile-preview');
        const editorPreview = document.getElementById('editor-preview-box');

        if (preview) preview.style.backgroundImage = `url('${currentPhotoBase64}')`;
        if (editPreview) editPreview.src = currentPhotoBase64;
        if (editorPreview) editorPreview.style.backgroundImage = `url('${currentPhotoBase64}')`;

        const controls = document.getElementById('photo-adjust-controls') || document.getElementById('edit-adjust-controls');
        if (controls) controls.style.display = 'block';
    };
    reader.readAsDataURL(file);
}

window.updatePhotoPreview = function() {
    const zoom = document.getElementById('adj-zoom')?.value || document.getElementById('edit-zoom')?.value || 100;
    const x = document.getElementById('adj-x')?.value || document.getElementById('edit-x')?.value || 50;
    const y = document.getElementById('adj-y')?.value || document.getElementById('edit-y')?.value || 50;

    const preview = document.getElementById('onboarding-photo-preview');
    const editorPreview = document.getElementById('editor-preview-box');

    if (preview) {
        preview.style.backgroundSize = `${zoom}%`;
        preview.style.backgroundPosition = `${x}% ${y}%`;
    }
    if (editorPreview) {
        editorPreview.style.backgroundSize = `${zoom}%`;
        editorPreview.style.backgroundPosition = `${x}% ${y}%`;
    }
}

window.renderDashboardHome = function() {
    if (!userData) return;
    
    const placeholders = document.querySelectorAll('.user-name-placeholder');
    placeholders.forEach(p => p.innerText = userData.name.split(' ')[0].toUpperCase());
    
    // Stats
    const ptsEl = document.getElementById('dash-user-points');
    const lvlEl = document.getElementById('dash-user-level');
    const ratEl = document.getElementById('dash-user-rating');
    
    if (ptsEl) ptsEl.innerText = userData.points || 0;
    if (lvlEl) lvlEl.innerText = userData.level || 'Amateur';
    if (ratEl) ratEl.innerText = userData.stats?.rating || 60;
    
    // Checklist logic
    const checkPhoto = document.getElementById('check-photo');
    const checkClub = document.getElementById('check-club');
    const checkAvail = document.getElementById('check-avail');
    const checkPremium = document.getElementById('check-premium');
    
    if (userData.photo && !userData.photo.includes('ui-avatars')) {
        checkPhoto?.classList.add('done');
        checkPhoto.innerHTML = `<i class='bx bx-check-circle'></i> Foto de perfil subida`;
    }
    
    if (userData.clubs && userData.clubs.length > 0) {
        checkClub?.classList.add('done');
        checkClub.innerHTML = `<i class='bx bx-check-circle'></i> Equipo creado`;
    }
    
    if (userData.isAvailable) {
        checkAvail?.classList.add('done');
        checkAvail.innerHTML = `<i class='bx bx-check-circle'></i> Disponibilidad activada`;
    }
    
    if (userData.points >= 500) {
        checkPremium?.classList.add('done');
        checkPremium.innerHTML = `<i class='bx bx-check-circle'></i> Carta 3D desbloqueada`;
    }
}

window.onPhotoSelected = function(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
        currentPhotoBase64 = e.target.result;
        const preview = document.getElementById('onboarding-photo-preview');
        const editPreview = document.getElementById('edit-profile-preview');
        const editorPreview = document.getElementById('editor-preview-box');

        if (preview) {
            preview.style.backgroundImage = `url('${currentPhotoBase64}')`;
            preview.style.backgroundSize = '100%';
            preview.style.backgroundPosition = 'center';
        }
        if (editPreview) editPreview.src = currentPhotoBase64;
        if (editorPreview) {
            editorPreview.style.backgroundImage = `url('${currentPhotoBase64}')`;
            editorPreview.style.backgroundSize = '100%';
            editorPreview.style.backgroundPosition = 'center';
        }

        const controls = document.getElementById('photo-adjust-controls') || document.getElementById('edit-adjust-controls');
        if (controls) controls.style.display = 'block';
    };
    reader.readAsDataURL(file);
}

window.updatePhotoPreview = function() {
    const zoom = document.getElementById('adj-zoom')?.value || document.getElementById('edit-zoom')?.value || 100;
    const x = document.getElementById('adj-x')?.value || document.getElementById('edit-x')?.value || 50;
