let termsCallback = null;

function showTermsModal(callback) {
    termsCallback = callback;
    const modal = document.getElementById('terms-modal');
    if (modal) {
        modal.style.display = 'flex';
        const check = document.getElementById('terms-accept-check');
        if (check) check.checked = false;
        const btn = document.getElementById('btn-accept-terms');
        if (btn) { btn.style.opacity = '0.4'; btn.style.pointerEvents = 'none'; }
    }
}

window.checkTermsAccept = function() {
    const check = document.getElementById('terms-accept-check');
    const btn = document.getElementById('btn-accept-terms');
    if (!check || !btn) return;
    if (check.checked) {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
    } else {
        btn.style.opacity = '0.4';
        btn.style.pointerEvents = 'none';
    }
};

window.acceptTermsAndRegister = function() {
    const modal = document.getElementById('terms-modal');
    if (modal) modal.style.display = 'none';
    if (termsCallback) termsCallback();
    termsCallback = null;
};

function showPlanModal() {
    const modal = document.getElementById('plan-modal');
    if (modal) modal.style.display = 'flex';
}

window.submitRegistrationWithPlan = function() {
    const modal = document.getElementById('plan-modal');
    if (modal) modal.style.display = 'none';
    doFinalRegister();
};

