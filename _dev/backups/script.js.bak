window.renderMisClubes = function() {
    const container = document.getElementById('mis-clubes-list');
    if (!container) return;

    const clubs = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    
    if (clubs.length === 0) {
        container.innerHTML = `
            <div class="panel" style="text-align:center; padding:40px;">
                <i class='bx bx-shield' style="font-size:48px; color:var(--accent); opacity:0.3; margin-bottom:15px;"></i>
                <p style="color:var(--text-muted);">Aún no has creado ningún club.</p>
                <button class="btn btn-primary" style="margin-top:20px;" onclick="openClubCreator()">CREAR MI PRIMER CLUB</button>
            </div>
        `;
        return;
    }

    container.innerHTML = clubs.map(club => `
        <div class="match-list-item" style="cursor:pointer;" onclick="viewClubProfile(${club.id})">
            <div style="display:flex; align-items:center; gap:15px;">
                <div style="width:50px; height:50px; background:#000; border-radius:8px; display:flex; align-items:center; justify-content:center; border:1px solid var(--border-color);">
                    ${club.logoSVG || '<i class="bx bx-shield"></i>'}
                </div>
                <div>
                    <h4 style="margin:0;">${club.name}</h4>
                    <p style="font-size:11px; color:var(--text-muted); margin:0;">${club.city}, ${club.nat}</p>
                </div>
            </div>
            <div style="display:flex; gap:10px;">
                <button class="btn btn-glass btn-sm" onclick="event.stopPropagation(); openEditClub(${club.id})"><i class='bx bx-edit-alt'></i> GESTIONAR</button>
            </div>
        </div>
    `).join('');
};

window.openClubCreator = function() {
    const modal = document.getElementById('club-creator-modal');
    if (modal) modal.style.display = 'flex';
    else alert("Funcionalidad de creación próximamente");
};


window.viewClubProfile = function(id) {
    const stored = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    const mock = [];
    const clubs = [...stored, ...mock];
    const club = clubs.find(c => c.id === id);
    if (!club) return;

    window.currentEditingClubId = id;
    if(typeof switchDashboardTab === 'function') switchDashboardTab('jugador', 'club-viewer');
    
    const content = document.getElementById('club-global-viewer-content');
    if (content) {
        let playersHtml = '<div style="color:var(--text-muted); font-size:12px; text-align:center; padding: 20px;">No hay jugadores registrados en la plantilla an.</div>';
        if (club.players && club.players.length > 0) {
            playersHtml = `
                <div class="quick-actions-grid" style="grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px;">
                    ${club.players.map(p => `
                        <div class="panel" style="padding: 10px; display:flex; flex-direction:column; align-items:center; border:1px solid #333;">
                            <div style="width:50px; height:50px; border-radius:50%; background-image:url('${p.photo || 'https://ui-avatars.com/api/?name=J'}'); background-size:cover; margin-bottom:10px; border:2px solid var(--accent);"></div>
                            <div style="font-weight:900; font-size:12px; color:#fff; text-align:center;">${p.name.toUpperCase()}</div>
                            <div style="font-size:10px; color:var(--accent); font-weight:800; background:rgba(186,255,0,0.1); padding:2px 8px; border-radius:10px; margin-top:5px;">${p.pos.toUpperCase()}</div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        content.innerHTML = `
            <div class="social-profile">
                <div class="cover-photo" style="background-image: url('${club.coverPhoto || ''}'); background-size: cover; background-position: center; border-radius:12px 12px 0 0;"></div>
                <div class="profile-header-row" style="padding: 0 20px;">
                    <div style="width:100px; height:100px; border-radius:50%; background-color:#000; background-image: url('${club.logoSVG ? '' : (userData && userData.photo || '')}'); background-size: cover; border:4px solid var(--accent); margin-top:-50px; display:flex; align-items:center; justify-content:center;">
                        ${club.logoSVG || ''}
                    </div>
                    <div class="profile-actions-row" style="margin-top: 15px;">
                        <button class="btn btn-primary" style="font-weight:900;">SEGUIR</button>
                    </div>
                </div>
                <div class="profile-info-section" style="padding: 10px 20px;">
                    <div class="profile-display-name" style="font-size:24px;">${club.name}</div>
                    <div class="profile-handle" style="color:var(--accent);">@${club.name.toLowerCase().replace(/\s/g, '')}</div>
                    <div class="profile-bio" style="margin-top:10px; font-size:14px;">${club.bio || 'Sin biografa disponible. Equipo competidor de Canchero.'}</div>
                </div>
                
                <div style="padding: 20px;">
                    <h3 style="color:var(--accent); font-weight:900; margin-bottom:15px; border-bottom:1px solid #333; padding-bottom:10px;"><i class='bx bx-group'></i> PLANTILLA OFICIAL</h3>
                    ${playersHtml}
                    
                    <h3 style="color:var(--accent); font-weight:900; margin-top:30px; margin-bottom:15px; border-bottom:1px solid #333; padding-bottom:10px;"><i class='bx bx-stats'></i> ESTADSTICAS DEL CLUB</h3>
                    <div class="quick-actions-grid" style="grid-template-columns: repeat(3, 1fr); gap: 10px;">
                        <div class="panel" style="text-align:center; padding:15px;"><div style="font-size:24px; color:var(--accent); font-weight:900;">${club.score || 0}</div><div style="font-size:10px; color:#888;">PUNTOS</div></div>
                        <div class="panel" style="text-align:center; padding:15px;"><div style="font-size:24px; color:var(--accent); font-weight:900;">${club.stars || 0}</div><div style="font-size:10px; color:#888;">ESTRELLAS</div></div>
                        <div class="panel" style="text-align:center; padding:15px;"><div style="font-size:24px; color:var(--accent); font-weight:900;">${club.players ? club.players.length : 0}</div><div style="font-size:10px; color:#888;">JUGADORES</div></div>
                    </div>
                </div>
            </div>
        `;
    }
};
window.addEventListener('DOMContentLoaded', () => {
    const savedUser = localStorage.getItem('canchero_user');
    if (savedUser) {
        userData = JSON.parse(savedUser);
        applyUserData();
        renderDashboardHome();
        
        const lastView = localStorage.getItem('canchero_last_view');
        if (lastView && lastView !== 'home') {
            navigate(lastView);
        } else {
            navigate(userData.role);
        }
    } else {
        userData = null;
        applyUserData();
        navigate('home');
    }
});

window.onClubLogoSelected = function(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        compressImage(e.target.result, 300, 300, 0.7, function(compressed) {
            const preview = document.getElementById('new-club-logo-preview');
            const img = document.getElementById('logo-preview-img');
            if (preview && img) {
                img.src = compressed;
                preview.style.display = 'block';
            }
        });
    };
    reader.readAsDataURL(file);
}

window.createClub = function() {
    const name = document.getElementById('new-club-name').value;
    if (!name) { alert('Ingresa el nombre del club.'); return; }
    
    const newClub = {
        id: Date.now(),
        name: name,
        abbrev: document.getElementById('new-club-abbrev').value,
        nickname: document.getElementById('new-club-nickname').value,
        founded: document.getElementById('new-club-founded').value,
        city: document.getElementById('new-club-city').value,
        nat: document.getElementById('new-club-country').value,
        phone: document.getElementById('new-club-phone').value,
        bio: document.getElementById('new-club-bio').value,
        logo: document.getElementById('logo-preview-img')?.src || ''
    };
    
    let myClubs = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    myClubs.push(newClub);
    localStorage.setItem('canchero_mis_clubes', JSON.stringify(myClubs));
    
    // Also add to user clubs
    if (userData) {
        if (!userData.clubs) userData.clubs = [];
        userData.clubs.push(newClub.id);
        localStorage.setItem('canchero_user', JSON.stringify(userData));
    }
    
    alert('¡Club registrado exitosamente!');
    document.getElementById('club-creator-modal').style.display = 'none';
    renderMisClubes();
}

window.renderMisClubes = function() {
    const container = document.getElementById('mis-clubes-list');
    if (!container) return;
    
    let myClubs = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    if (myClubs.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:40px; border:1px dashed #333; border-radius:12px;">
            <i class='bx bx-shield' style="font-size:48px; color:#333; margin-bottom:10px;"></i>
            <p style="color:#666;">Aún no tienes equipos creados.</p>
            <button class="btn btn-primary btn-sm" style="margin-top:15px;" onclick="document.getElementById('club-creator-modal').style.display='flex'">CREAR MI EQUIPO</button>
        </div>`;
        return;
    }
    
    container.innerHTML = myClubs.map(club => `
        <div class="post-card" style="display:flex; align-items:center; gap:15px; margin-bottom:12px;">
            <div style="width:50px; height:50px; background:#000; border:1px solid var(--accent); border-radius:8px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                ${club.logo ? `<img src="${club.logo}" style="width:100%; height:100%; object-fit:cover;">` : `<i class='bx bxs-shield' style="color:var(--accent); font-size:24px;"></i>`}
            </div>
            <div style="flex:1;">
                <h4 style="margin:0; font-size:14px;">${club.name.toUpperCase()}</h4>
                <p style="margin:0; font-size:11px; color:#888;">${club.city} · ${club.nickname || 'Sin apodo'}</p>
            </div>
            <button class="btn btn-glass btn-sm" onclick="openEditClub(${club.id})">GESTIÓN</button>
        </div>
    `).join('');
}

window.openCameraModal = function() {
    alert('Acceso a cámara en desarrollo. Usa la opción SUBIR por ahora.');
}

window.openPhotoEditor = function() {
    const modal = document.getElementById('edit-profile-modal');
    if (modal) {
        modal.style.display = 'flex';
        document.getElementById('edit-profile-input').click();
    }
}

window.handleGlobalSearch = function(event, el) {
    if (event.key === 'Enter') triggerGlobalSearch();
}

window.triggerGlobalSearch = function() {
    const input = document.querySelector('.global-search-input');
    const results = document.getElementById('global-search-results');
    if (!input || !results) return;
    
    const query = input.value.toLowerCase();
    if (!query) { results.style.display = 'none'; return; }
    
    results.style.display = 'block';
    results.innerHTML = `<div style="padding:15px; text-align:center; color:#888; font-size:12px;">Buscando "${query}"...</div>`;
    
    // Simulate search
    setTimeout(() => {
        results.innerHTML = `
            <div style="padding:10px; border-bottom:1px solid #222; cursor:pointer;" onclick="viewProfileByName('${query}')">
                <div style="font-size:12px; font-weight:bold; color:var(--accent);">RESULTADOS PARA "${query.toUpperCase()}"</div>
                <div style="font-size:10px; color:#666;">Toca para ver perfil</div>
            </div>
        `;
    }, 500);
}

window.deleteAccount = function() {
    if (confirm('¿ESTÁS SEGURO? Esta acción borrará todos tus datos de forma permanente.')) {
        localStorage.clear();
        location.reload();
    }
}

window.addStory = function() {
    document.getElementById('story-creator-modal').style.display = 'flex';
}



window.submitMatchReport = function() {
    alert('Reporte enviado correctamente. Tus estadísticas se actualizarán pronto.');
    document.getElementById('report-match-modal').style.display = 'none';
}

// ============================================================
// LOGIN
// ============================================================
window.handleLogin = async function() {
    const emailEl = document.getElementById('login-email');
    const passEl = document.getElementById('login-pass');
    const email = emailEl?.value?.trim();
    const pass  = passEl?.value?.trim();
    if (!email || !pass) { showToast('Completá email y contraseña.', 'warning'); return; }

    // Admin shortcut
    if (email === 'neurovidstudioia@gmail.com' && pass === 'canchero2026') {
        userData = { name: 'SUPER ADMIN', email: email, role: 'admin' };
        localStorage.setItem('canchero_user', JSON.stringify(userData));
        navigate('admin');
        try { renderAdminDashboard(); } catch(e){}
        return;
    }

    // 1) Try Supabase auth (cross-device)
    if (supabase) {
        try {
            const { data, error } = await supabase.auth.signInWithPassword({ email, password: pass });
            if (!error && data?.user) {
                // Try to load enriched user data
                let dbUser = null;
                try {
                    const { data: rows } = await supabase.from('users').select('*').eq('email', email.toLowerCase()).limit(1);
                    dbUser = (rows && rows[0]) || null;
                } catch(e){}
                const role = dbUser?.role || data.user.user_metadata?.role || 'jugador';
                const name = dbUser?.name || data.user.user_metadata?.name || email.split('@')[0];
                const isPaid = ['club','profesional','organizacion','tienda','sponsor'].includes(role);
                if (isPaid && dbUser && dbUser.sub_status !== 'active' && dbUser.is_admin !== true) {
                    showToast('Tu cuenta está pendiente de aprobación.', 'warning');
                    return;
                }
                userData = {
                    name, email,
                    role,
                    photo: dbUser?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=000&color=baff00`,
                    phone: dbUser?.phone || '',
                    stats: dbUser?.stats || { goals: 0, assists: 0, matches: 0 },
                    isComplexApproved: true
                };
                localStorage.setItem('canchero_user', JSON.stringify(userData));
                applyUserData();
                try { renderDashboardHome(); } catch(e){}
                navigate(['jugador','club','admin'].includes(role) ? role : 'jugador');
                return;
            }
        } catch(e) { console.warn('Supabase signIn error:', e.message); }
    }

    // 2) Fallback: localStorage
    const saved = localStorage.getItem('canchero_user');
    if (saved) {
        try {
            const u = JSON.parse(saved);
            if (u.email === email) {
                const isPaid = ['club','profesional','organizacion','tienda','sponsor'].includes(u.role);
                if (isPaid && !u.isComplexApproved) {
                    showToast('Tu cuenta está pendiente de aprobación.', 'warning');
                    return;
                }
                userData = u;
                applyUserData();
                try { renderDashboardHome(); } catch(e){}
                navigate(['jugador','club','admin'].includes(u.role) ? u.role : 'jugador');
                return;
            }
        } catch(e) {}
    }

    showToast('Email o contraseña incorrectos. Si sos nuevo, registrate primero.', 'error');
};

function showToast(msg, type = 'info') {
    const colors = { info: '#baff00', warning: '#ffb400', error: '#ff4444', success: '#baff00' };
    const t = document.createElement('div');
    t.style = `position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#111;color:${colors[type]||'#baff00'};border:1px solid ${colors[type]||'#baff00'};padding:12px 20px;border-radius:30px;font-size:12px;font-weight:700;font-family:var(--font-display);z-index:999999;max-width:85vw;text-align:center;box-shadow:0 5px 20px rgba(0,0,0,0.6);animation:fadeIn 0.3s ease;`;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 4000);
}

// ============================================================
// MATCH CENTER TABS
// ============================================================
window.switchMatchCenterMainTab = function(tab, el) {
    document.getElementById('mc-amistosos-section').style.display = tab === 'amistosos' ? 'block' : 'none';
    document.getElementById('mc-torneos-section').style.display  = tab === 'torneos'   ? 'block' : 'none';
    document.querySelectorAll('.mc-main-btn').forEach(b => {
        b.className = b.className.replace('btn-primary','btn-glass');
    });
    if (el) { el.className = el.className.replace('btn-glass','btn-primary'); }
};

window.switchMatchCenterSubTab = function(section, tab, el) {
    const prefix = `mc-${section}-`;
    document.getElementById(prefix + 'predicciones').style.display = tab === 'predicciones' ? 'block' : 'none';
    document.getElementById(prefix + 'resultados').style.display   = tab === 'resultados'   ? 'block' : 'none';
    const parent = el?.closest('[id^="mc-"]');
    if (parent) parent.querySelectorAll('.mc-sub-btn').forEach(b => {
        b.style.background = 'transparent';
        b.style.color = '#fff';
    });
    if (el) { el.style.background = 'var(--accent)'; el.style.color = '#000'; }
};

// ============================================================
// GESTIÓN DE CLUB (sub-tabs)
// ============================================================
window.switchClubGestionTab = function(tab, el) {
    document.querySelectorAll('.gestion-sub-content').forEach(d => d.style.display = 'none');
    const target = document.getElementById('gestion-' + tab);
    if (target) target.style.display = 'block';
    document.querySelectorAll('.club-gestion-tab').forEach(b => {
        b.className = b.className.replace('btn-primary','btn-glass');
    });
    if (el) el.className = el.className.replace('btn-glass','btn-primary');
};

// ============================================================
// MENSAJES (DMs — Supabase messages table)
// ============================================================
(function() {
    const SURL = 'https://dofbxgqzcvfjpnvcvdjb.supabase.co';
    const SKEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc';
    let dmSb = null;
    try { dmSb = window.supabase ? window.supabase.createClient(SURL, SKEY) : null; } catch(e) {}

    function dmUser() {
        const u = window.userData || {};
        return { email: u.email || localStorage.getItem('canchero_email') || '', name: u.name || localStorage.getItem('canchero_name') || 'Jugador' };
    }

    function dmTimeAgo(dateStr) {
        if (!dateStr) return '';
        const s = Math.floor((new Date() - new Date(dateStr)) / 1000);
        if (s < 60) return 'Ahora';
        if (s < 3600) return `${Math.floor(s/60)}m`;
        if (s < 86400) return `${Math.floor(s/3600)}h`;
        return `${Math.floor(s/86400)}d`;
    }

    window.renderMensajes = async function() {
        const list = document.getElementById('msg-chat-list');
        if (!list) return;
        const me = dmUser();
        if (!me.email || !dmSb) {
            list.innerHTML = '<div style="padding:15px;color:#555;font-size:12px;text-align:center;">Iniciá sesión para ver mensajes.</div>';
            return;
        }
        list.innerHTML = '<div style="padding:15px;text-align:center;"><i class="bx bx-loader-alt bx-spin" style="color:#555;font-size:20px;"></i></div>';
        try {
            const { data: msgs } = await dmSb.from('messages').select('*')
                .or(`sender_email.eq.${me.email},recipient_email.eq.${me.email}`)
                .order('created_at', { ascending: false }).limit(200);
            if (!msgs || msgs.length === 0) {
                list.innerHTML = '<div style="padding:24px;text-align:center;color:#555;font-size:12px;"><i class="bx bx-message-dots" style="font-size:28px;display:block;margin-bottom:8px;"></i>Sin mensajes aún.<br><span style="font-size:11px;">Seguí a jugadores y escribiles.</span></div>';
                return;
            }
            const convos = {};
            msgs.forEach(m => {
                const partner = m.sender_email === me.email ? m.recipient_email : m.sender_email;
                const partnerName = m.sender_email === me.email ? m.recipient_email.split('@')[0] : (m.sender_name || m.sender_email.split('@')[0]);
                if (!convos[partner]) convos[partner] = { email: partner, name: partnerName, lastMsg: m.content, time: m.created_at, unread: 0 };
                if (m.recipient_email === me.email && !m.read) convos[partner].unread++;
            });
            list.innerHTML = Object.values(convos).map(c => `
                <div onclick="openDmThread('${c.email}','${c.name.replace(/'/g,"\\'")}')" style="display:flex;align-items:center;gap:12px;padding:12px 15px;border-bottom:1px solid #1a1a1a;cursor:pointer;transition:background .2s;" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='transparent'">
                    <div style="width:44px;height:44px;border-radius:50%;background:var(--accent);color:#000;font-weight:900;font-size:16px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${(c.name[0]||'?').toUpperCase()}</div>
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-weight:700;font-size:13px;">${c.name.toUpperCase()}</span>
                            <span style="font-size:10px;color:#666;">${dmTimeAgo(c.time)}</span>
                        </div>
                        <div style="font-size:11px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${c.lastMsg||''}</div>
                    </div>
                    ${c.unread ? `<div style="width:18px;height:18px;background:var(--accent);border-radius:50%;color:#000;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;">${c.unread}</div>` : ''}
                </div>`).join('');
        } catch(e) {
            list.innerHTML = '<div style="padding:15px;color:#f44;font-size:12px;">Error cargando mensajes.</div>';
        }
    };

    window.openDmThread = async function(partnerEmail, partnerName) {
        const win = document.getElementById('active-chat-window');
        if (!win || !dmSb) return;
        const me = dmUser();
        const safePartnerName = (partnerName||'').replace(/'/g,"\\'");
        try { await dmSb.from('messages').update({ read: true }).eq('sender_email', partnerEmail).eq('recipient_email', me.email).eq('read', false); } catch(e) {}
        win.innerHTML = `
            <div style="padding:12px 15px;border-bottom:1px solid #222;display:flex;align-items:center;gap:12px;background:#111;">
                <div style="width:38px;height:38px;border-radius:50%;background:var(--accent);color:#000;font-weight:900;font-size:14px;display:flex;align-items:center;justify-content:center;">${(partnerName[0]||'?').toUpperCase()}</div>
                <span style="font-weight:700;">${partnerName.toUpperCase()}</span>
            </div>
            <div id="chat-messages" style="flex:1;overflow-y:auto;padding:15px;display:flex;flex-direction:column;gap:8px;">
                <div style="text-align:center;padding:20px;"><i class="bx bx-loader-alt bx-spin" style="color:#555;font-size:20px;"></i></div>
            </div>
            <div style="padding:10px 15px;border-top:1px solid #222;display:flex;gap:10px;background:#111;">
                <input id="dm-input" type="text" placeholder="Escribir mensaje..." style="flex:1;background:#1a1a1a;border:1px solid #333;color:#fff;padding:10px 15px;border-radius:25px;outline:none;font-size:13px;" onkeydown="if(event.key==='Enter') window.sendDmMessage('${partnerEmail}','${safePartnerName}')">
                <button class="btn btn-primary" style="border-radius:50%;width:42px;height:42px;padding:0;display:flex;align-items:center;justify-content:center;" onclick="window.sendDmMessage('${partnerEmail}','${safePartnerName}')"><i class='bx bx-send'></i></button>
            </div>`;
        try {
            const { data: thread } = await dmSb.from('messages').select('*')
                .or(`and(sender_email.eq.${me.email},recipient_email.eq.${partnerEmail}),and(sender_email.eq.${partnerEmail},recipient_email.eq.${me.email})`)
                .order('created_at', { ascending: true }).limit(60);
            const msgEl = document.getElementById('chat-messages');
            if (!msgEl) return;
            if (!thread || thread.length === 0) {
                msgEl.innerHTML = '<div style="text-align:center;color:#555;font-size:12px;padding:20px;">Sin mensajes aún. ¡Rompé el hielo!</div>';
                return;
            }
            msgEl.innerHTML = thread.map(m => {
                const isMine = m.sender_email === me.email;
                return `<div style="display:flex;justify-content:${isMine?'flex-end':'flex-start'};"><div style="max-width:72%;background:${isMine?'var(--accent)':'#1e1e1e'};color:${isMine?'#000':'#fff'};padding:9px 14px;border-radius:${isMine?'16px 16px 4px 16px':'16px 16px 16px 4px'};font-size:13px;">${m.content}<div style="font-size:9px;opacity:0.5;margin-top:2px;text-align:right;">${dmTimeAgo(m.created_at)}</div></div></div>`;
            }).join('');
            msgEl.scrollTop = msgEl.scrollHeight;
        } catch(e) {}
        renderMensajes();
    };

    window.sendDmMessage = async function(partnerEmail, partnerName) {
        const input = document.getElementById('dm-input');
        if (!input || !input.value.trim() || !dmSb) return;
        const me = dmUser();
        const content = input.value.trim();
        input.value = '';
        try {
            await dmSb.from('messages').insert({ sender_email: me.email, sender_name: me.name, recipient_email: partnerEmail, content, read: false });
            openDmThread(partnerEmail, partnerName);
            if (window.notif) window.notif.create(partnerEmail, 'dm', me.name, `💬 ${me.name}: ${content.slice(0,60)}`);
        } catch(e) { if (typeof showToast === 'function') showToast('Error al enviar mensaje.', 'error'); }
    };

    window.openDM = function(partnerEmail, partnerName) {
        if (typeof switchDashboardTab === 'function') switchDashboardTab('jugador', 'mensajes', null);
        setTimeout(() => openDmThread(partnerEmail, partnerName), 300);
    };
})();

window.showNewDmModal = function() {
    const existing = document.getElementById('new-dm-modal');
    if (existing) { existing.remove(); return; }
    const modal = document.createElement('div');
    modal.id = 'new-dm-modal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;';
    modal.innerHTML = `
        <div style="background:var(--bg2,#111);border:1px solid #222;border-radius:16px;padding:24px;width:320px;max-width:90vw;">
            <h3 style="margin:0 0 16px;font-size:14px;font-weight:800;">NUEVO MENSAJE</h3>
            <input id="new-dm-email" type="email" placeholder="Email del jugador..." style="width:100%;background:#1a1a1a;border:1px solid #333;color:#fff;padding:10px 14px;border-radius:10px;outline:none;font-size:13px;box-sizing:border-box;margin-bottom:10px;">
            <input id="new-dm-name" type="text" placeholder="Nombre (opcional)" style="width:100%;background:#1a1a1a;border:1px solid #333;color:#fff;padding:10px 14px;border-radius:10px;outline:none;font-size:13px;box-sizing:border-box;margin-bottom:16px;">
            <div style="display:flex;gap:10px;">
                <button onclick="document.getElementById('new-dm-modal').remove()" style="flex:1;padding:10px;background:transparent;border:1px solid #333;color:#fff;border-radius:10px;cursor:pointer;font-weight:700;font-size:12px;">CANCELAR</button>
                <button onclick="startNewDm()" style="flex:1;padding:10px;background:var(--accent);color:#000;border:none;border-radius:10px;cursor:pointer;font-weight:900;font-size:12px;">ABRIR CHAT</button>
            </div>
        </div>`;
    modal.addEventListener('click', e => { if (e.target === modal) modal.remove(); });
    document.body.appendChild(modal);
    setTimeout(() => document.getElementById('new-dm-email') && document.getElementById('new-dm-email').focus(), 50);
};

window.startNewDm = function() {
    const emailEl = document.getElementById('new-dm-email');
    const nameEl = document.getElementById('new-dm-name');
    const email = emailEl ? emailEl.value.trim() : '';
    const name = (nameEl && nameEl.value.trim()) || (email.split('@')[0]);
    if (!email) { showToast('Ingresá un email.', 'error'); return; }
    document.getElementById('new-dm-modal').remove();
    openDmThread(email, name);
};

