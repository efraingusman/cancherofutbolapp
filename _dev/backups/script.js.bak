// ============ MATCH REPORTING FUNCTIONS ============

window.openReportModal = function() {
    if (!userData || !userData.isCaptain) {
        alert('Solo el capitán del equipo puede reportar resultados.');
        return;
    }
    const modal = document.getElementById('report-match-modal');
    if (modal) modal.style.display = 'flex';
}

window.submitMatchReport = function() {
    const scoreMy = parseInt(document.getElementById('report-score-my').value);
    const scoreOp = parseInt(document.getElementById('report-score-op').value);
    const g1 = parseInt(document.getElementById('report-goals-1').value || 0);
    const a1 = parseInt(document.getElementById('report-assists-1').value || 0);
    const gr1 = parseInt(document.getElementById('report-gr-1').value || 0);

    if (isNaN(scoreMy) || isNaN(scoreOp)) {
        alert('Por favor ingresa el resultado del partido.');
        return;
    }


    // Mock validation: In a real app, this would wait for the rival's report
    // For the demo, we assume the rival reports the same after 2 seconds
    alert('Reporte enviado. Esperando validación del capitán rival...');
    
    setTimeout(() => {
        alert('¡Resultado validado! El capitán rival ha confirmado el mismo score (' + scoreMy + ' - ' + scoreOp + '). Tus estadísticas han sido actualizadas.');
        
        if (userData && userData.stats) {
            userData.stats.goals += g1;
            userData.stats.assists += a1;
            userData.stats.goalsConceded = (userData.stats.goalsConceded || 0) + gr1;
            userData.stats.matches += 1;
            
            // Re-calculate rating based on performance
            // For GKs, goalsConceded negatively impacts rating
            const performanceBoost = (userData.stats.goals * 0.5) + (userData.stats.assists * 0.3) - (userData.stats.goalsConceded * 0.2);
            userData.stats.rating = Math.max(60, Math.min(99, 60 + performanceBoost));
            
            localStorage.setItem('canchero_user', JSON.stringify(userData));
            applyUserData();
            document.getElementById('report-match-modal').style.display = 'none';
        }

    }, 2000);
}

// ============ 3D CARD TILT EFFECT ============
function init3DCardTilt() {
    const containers = document.querySelectorAll('.fut-card-3d-container');
    
    containers.forEach(container => {
        const wrapper = container.querySelector('.fut-card-wrapper') || container.querySelector('.mini-fut-wrapper');
        if (!wrapper) return;
        
        container.addEventListener('mousemove', (e) => {
            const rect = container.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = (y - centerY) / 10;
            const rotateY = (centerX - x) / 10;
            
            if (typeof gsap !== 'undefined') {
                gsap.to(wrapper, {
                    rotateX: rotateX,
                    rotateY: rotateY,
                    duration: 0.5,
                    ease: 'power2.out'
                });
            }
        });
        
        container.addEventListener('mouseleave', () => {
            if (typeof gsap !== 'undefined') {
                gsap.to(wrapper, {
                    rotateX: 0,
                    rotateY: 0,
                    duration: 0.5,
                    ease: 'power2.out'
                });
            }
        });
    });
}


