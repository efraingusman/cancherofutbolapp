    }
}

window.toggleMobileMoreMenu = function() {
    const menu = document.getElementById('mobile-more-menu');
    if (!menu) return;
    menu.style.display = (menu.style.display === 'none' || menu.style.display === '') ? 'flex' : 'none';
}

window.switchDashboardTab = function(role, tabId, el) {
    const section = document.getElementById(`view-${role}`);
    if(!section) return;

    // Hide all tabs
    section.querySelectorAll('.dashboard-tab-content').forEach(tab => {
        tab.style.display = 'none';
    });

    // Show target tab
    const target = document.getElementById(`${role}-${tabId}`);
    if(target) target.style.display = 'block';

    // If el is not passed, find the item whose onclick contains tabId
    if (!el) {
        const sidebar = section.querySelector('.sidebar-menu');
        if (sidebar) {
            const items = Array.from(sidebar.querySelectorAll('.menu-item'));
            el = items.find(item => item.getAttribute('onclick')?.includes(`'${tabId}'`));
        }
    }

    // Sync active state for sidebar menu items
    section.querySelectorAll('.sidebar-menu .menu-item').forEach(item => {
        item.classList.remove('active');
    });
    if (el) {
        el.classList.add('active');
        const sidebar = el.closest('.sidebar-menu');
        if (sidebar) {
            const items = Array.from(sidebar.querySelectorAll('.menu-item'));
            const menuIndex = items.indexOf(el);
            localStorage.setItem('canchero_last_tab', JSON.stringify({dashboard: role, tab: tabId, menuIndex: menuIndex}));
        }
    } else {
        localStorage.setItem('canchero_last_tab', JSON.stringify({dashboard: role, tab: tabId, menuIndex: -1}));
    }

    // Sync active state for bottom nav items
    document.querySelectorAll('.mobile-nav-item').forEach(item => {
        item.classList.remove('active');
        if (item.onclick && item.onclick.toString().includes(tabId)) {
            item.classList.add('active');
        }
    });

    if (tabId === 'inicio') renderDashboardHome();
    if (tabId === 'ranking') renderRanking();
    if (tabId === 'buscar-clubes') renderBuscarClubes();
    if (tabId === 'amigos') populateSocialFeed();
    if (tabId === 'mis-clubes') renderMisClubes();
    if (tabId === 'buscar-canchas') { renderMap(); }
    if (tabId === 'perfil') renderUserPosts(role);

    if (tabId === 'recomendar') {
        const premiumBox = document.getElementById('premium-status-box');
        const isPremium = checkPremiumStatus();
        if (isPremium) {
            if (premiumBox) premiumBox.style.display = 'block';
            const expDate = new Date(userData.premiumUntil);
            const premiumTimer = document.getElementById('premium-timer');
            if (premiumTimer) premiumTimer.innerText = `Expira: ${expDate.toLocaleDateString()} ${expDate.toLocaleTimeString()}`;
        } else {
            if (premiumBox) premiumBox.style.display = 'none';
        }
    }
    if (tabId === 'reservas' && role === 'club') {
        const badge = document.getElementById('res-notif-badge');
        if (badge) badge.style.display = 'none';
        if (typeof renderComplexReservations === 'function') renderComplexReservations();
    }
    if (tabId === 'canchas' && role === 'club') {
        if (typeof renderComplexCourts === 'function') renderComplexCourts();
    }
    
    // Notification logic
    if (typeof checkNewNotifications === 'function') checkNewNotifications();
}

// Called when user clicks the final LISTO button
window.handleRegister = function() {
    const name = document.getElementById('reg-name').value?.trim();
    const email = document.getElementById('reg-email').value?.trim();
    const pass = document.getElementById('reg-pass').value?.trim();
    if (!name || !email || !pass) { alert('Completá nombre, email y contraseña.'); return; }

    const isPaid = ['club','profesional','organizacion','tienda','sponsor'].includes(regRole);
    if (isPaid) {
        showTermsModal(() => showPlanModal());
    } else {
        doFinalRegister();
    }
};

// The actual registration logic
function doFinalRegister() {
    const name = document.getElementById('reg-name')?.value?.trim() || (userData?.name || '');
    const email = document.getElementById('reg-email')?.value?.trim() || (userData?.email || '');
    const pass = document.getElementById('reg-pass')?.value?.trim() || '';

    const bDay = document.getElementById('reg-birth-day')?.value || '01';
    const bMonth = document.getElementById('reg-birth-month')?.value || '01';
    const bYear = document.getElementById('reg-birth-year')?.value || '2000';
    const birthDate = `${bYear}-${bMonth}-${bDay}`;

    localStorage.clear();
    allReservations = [];

    const isClub = regRole === 'club';
    const isPaid = ['club','profesional','organizacion','tienda','sponsor'].includes(regRole);
    const actualName = isClub ? (document.getElementById('reg-complex-name')?.value || name) : name;

    userData = {
        name: actualName,
        email: email,
        role: regRole,
        registeredRoles: [regRole],
        isComplexApproved: !isPaid,
        planSelected: isPaid ? selectedPlan : null,
        subType: regRole === 'profesional' ? regProfType : (regRole === 'organizacion' ? regOrgType : null),
        birth: birthDate,
        gender: regGender,
        phone: document.getElementById('reg-phone')?.value || '',
        pos: document.getElementById('reg-pos')?.value || 'Delantero',
        foot: document.getElementById('reg-foot')?.value || 'Derecha',
        nat: document.getElementById('reg-nat')?.value || 'Uruguay',
        city: document.getElementById('reg-city')?.value || 'Montevideo',
        fTypes: regFType,
        availability: regAvailability,
        isAvailable: true,
        photo: currentPhotoBase64 || `https://ui-avatars.com/api/?name=${encodeURIComponent(actualName)}&background=000&color=baff00`,
        photoStyle: {
            zoom: document.getElementById('adj-zoom')?.value || 100,
            x: document.getElementById('adj-x')?.value || 50,
            y: document.getElementById('adj-y')?.value || 50
        },
        stats: { goals: 0, assists: 0, matches: 0, mvp: 0, rating: 60, rit: 50, reg: 50, tir: 50, def: 50, pas: 50, fis: 50 },
        points: 100,
        level: 'Amateur',
        isCaptain: true,
        clubs: [],
        complexData: isClub ? {
            owner: document.getElementById('reg-complex-owner')?.value || '',
            complexName: document.getElementById('reg-complex-name')?.value || '',
            rut: document.getElementById('reg-complex-rut')?.value || '',
            address: document.getElementById('reg-complex-address')?.value || '',
            social: document.getElementById('reg-complex-social')?.value || '',
            fieldsCountF5: parseInt(document.getElementById('reg-complex-f5')?.value || '0'),
            fieldsCountF7: parseInt(document.getElementById('reg-complex-f7')?.value || '0'),
            fieldsCountF11: parseInt(document.getElementById('reg-complex-f11')?.value || '0'),
            services: {
                vestuario: document.getElementById('srv-vestuario')?.checked || false,
                cantina: document.getElementById('srv-cantina')?.checked || false,
                parking: document.getElementById('srv-parking')?.checked || false,
                parrillero: document.getElementById('srv-parrillero')?.checked || false
            }
        } : null,
        createdAt: Date.now()
    };

    localStorage.setItem('canchero_user', JSON.stringify(userData));

    if (isPaid) {
        // Save to Supabase (background)
        saveBusinessToSupabase({
            email: userData.email,
            name: userData.name,
            role: userData.role,
            plan: selectedPlan,
            subType: userData.subType,
            payload: userData
        });

        // Show pending modal
        const summary = document.getElementById('pending-summary');
        const roleNames = { club:'Complejo', profesional:'Profesional', organizacion:'Organización', tienda:'Tienda', sponsor:'Sponsor' };
        const planNames = { basico:'Básico ($9/mes)', pro:'Pro ($19/mes)', premium:'Premium ($39/mes)' };
        if (summary) {
            summary.innerHTML = `
                <div>👤 <strong>${userData.name}</strong></div>
                <div>📧 ${userData.email}</div>
                <div>🏷️ ${roleNames[userData.role] || userData.role}${userData.subType ? ' — ' + userData.subType : ''}</div>
                <div>💳 Plan ${planNames[selectedPlan] || selectedPlan}</div>
                <div style="color:#ffb400;">⏳ Estado: Pendiente de aprobación</div>
            `;
        }
        const pendingModal = document.getElementById('pending-modal');
        if (pendingModal) pendingModal.style.display = 'flex';

    } else {
        // Jugador: acceso inmediato
        // Save to global player directory
        try {
            const players = JSON.parse(localStorage.getItem('canchero_all_players') || '[]');
            const exists = players.findIndex(p => p.email === userData.email);
            const playerEntry = { name: userData.name, email: userData.email, photo: userData.photo, pos: userData.pos, city: userData.city, stats: userData.stats };
            if (exists >= 0) players[exists] = playerEntry; else players.push(playerEntry);
            localStorage.setItem('canchero_all_players', JSON.stringify(players));
        } catch(e) {}
        applyUserData();
        navigate('jugador');
    }

    // En paralelo: crear cuenta REAL en Supabase para que el login funcione cross-device
    if (supabase && email && pass) {
        supabase.auth.signUp({
            email: email,
            password: pass,
            options: { data: { name: actualName, role: regRole } }
        }).then(({ data, error }) => {
            if (error && !String(error.message).toLowerCase().includes('already')) {
                console.warn('Supabase signUp warning:', error.message);
            }
            // Insertar/actualizar fila en tabla users
            supabase.from('users').upsert({
                email: email.toLowerCase(),
                name: actualName,
                role: regRole,
                phone: userData.phone || null,
                avatar_url: userData.photo || null
            }, { onConflict: 'email' }).then(()=>{}).catch(e => console.warn('users upsert:', e.message));
        }).catch(e => console.warn('signUp error:', e.message));
    }
}

window.populateSocialFeed = async function() {
    await social.loadFeed('amigos-feed');
};

window.renderUserPosts = function(role) {
    const container = document.getElementById(role === 'jugador' ? 'jugador-feed' : 'club-posts');
    if (!container) return;
    
    // Check if the current user has any posts in local storage
    let posts = [];
    try {
        posts = JSON.parse(localStorage.getItem('canchero_posts') || '[]');
    } catch(e) {}
    
    // Filter posts for this user
    const username = (userData && userData.name || '').toLowerCase();
    const userPosts = posts.filter(p => p.username === username);
    
    if (userPosts.length === 0) {
        container.innerHTML = `
            <div class="panel" style="text-align:center; padding:30px; border: 1px solid rgba(255, 255, 255, 0.05); background: rgba(0, 0, 0, 0.4); border-radius: 8px;">
                <i class='bx bx-message-square-detail' style="font-size:32px; color:var(--accent); opacity:0.3; margin-bottom:10px; display:block; margin-left:auto; margin-right:auto;"></i>
                <p style="color:#888; font-size:12px; margin:0;">Aún no has realizado ninguna publicación.</p>
            </div>
        `;
    } else {
        container.innerHTML = userPosts.map(p => `
            <div class="post-card" style="margin-bottom:15px;">
                <div class="post-avatar" style="background-image:url('${(userData && userData.photo) || 'https://ui-avatars.com/api/?name=U'}')"></div>
                <div class="post-content">
                    <div class="post-header">
                        <span class="post-author">${((userData && userData.name) || 'JUGADOR').toUpperCase()}</span>
                        <span class="post-handle">@${((userData && userData.name) || '').toLowerCase().replace(/\s/g,'')}</span>
                        <span class="post-time">· ${timeAgo(p.id)}</span>
                    </div>
                    <div class="post-text">${p.text}</div>
                    ${p.media ? `
                        <div class="post-media" style="margin-top:10px; border-radius:8px; overflow:hidden; border: 1px solid rgba(255,255,255,0.1);">
                            <img src="${p.media}" style="width:100%; max-height:300px; object-fit:cover;">
                        </div>
                    ` : ''}
                    <div class="post-actions">
                        <div class="post-action" onclick="likePost(this)"><i class='bx bx-heart'></i> 0</div>
                        <div class="post-action"><i class='bx bx-message-rounded'></i> 0</div>
                        <div class="post-action"><i class='bx bx-repost'></i> 0</div>
                        <div class="post-action"><i class='bx bx-share-alt'></i></div>
                    </div>
                </div>
            </div>
        `).join('');
    }
};

window.openGlobalDirectory = async function(type) {
    // Si está en home (no logueado), abrir modal público
    const currentView = window.location.hash.replace('#','') || 'home';
    if (!userData || currentView === 'home' || currentView === 'login' || currentView === 'register') {
        openPublicDirectoryModal(type);
        return;
    }

    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const viewerId = `${dashboard}-global-viewer`;
    const viewer = document.getElementById(viewerId);
    const content = document.getElementById(`${dashboard}-global-viewer-content`);

    if(!viewer || !content) { openPublicDirectoryModal(type); return; }

    document.querySelectorAll('.dashboard-tab-content').forEach(t => t.style.display = 'none');
    viewer.style.display = 'block';

    const asyncTypes = ['tienda', 'servicios', 'eventos'];
    if (asyncTypes.includes(type)) {
        content.innerHTML = `<div style="text-align:center;padding:40px;color:#555;"><i class='bx bx-loader-alt bx-spin' style="font-size:28px;"></i></div>`;
        if (type === 'tienda') content.innerHTML = await generateTiendaHTML();
        else if (type === 'servicios') content.innerHTML = await generateBizItemsHTML('service', 'bx-briefcase', 'SERVICIOS PROFESIONALES', 'Árbitros, entrenadores, nutricionistas y más.');
        else if (type === 'eventos') content.innerHTML = await generateBizItemsHTML('event', 'bx-trophy', 'TORNEOS Y EVENTOS', 'Torneos, ligas y eventos deportivos.');
        return;
    }

    let html = '';
    if(type === 'torneos') html = generateTorneosFeedHTML();
    else if(type === 'complejos') html = generateComplejosFeedHTML();
    else if(type === 'clubes') html = generateClubesFeedHTML();
    else if(type === 'jugadores') html = generateJugadoresFeedHTML();

    content.innerHTML = html;
}

async function generateTiendaHTML() {
    let sb2 = null;
    try { sb2 = window.supabase ? window.supabase.createClient('https://dofbxgqzcvfjpnvcvdjb.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc') : null; } catch(e) {}
    if (!sb2) return emptyDirectoryHTML('bx-store', 'MARKETPLACE', 'Sin conexión.');

    const cats = ['Todos','Indumentaria','Calzado','Pelotas','Equipamiento','Accesorios','Suplementos','Otro'];
    let filterHTML = `<div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;margin-bottom:18px;scrollbar-width:none;">
        ${cats.map((c,i) => `<button onclick="filterProducts('${c}')" class="tienda-cat-btn ${i===0?'active':''}" data-cat="${c}" style="white-space:nowrap;padding:6px 14px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:1px solid ${i===0?'var(--accent)':'rgba(255,255,255,0.1)'};background:${i===0?'rgba(186,255,0,0.1)':'transparent'};color:${i===0?'var(--accent)':'#888'};transition:.15s;">${c}</button>`).join('')}
    </div>`;

    let products = [];
    try {
        const { data } = await sb2.from('products').select('*').eq('active', true).order('created_at', { ascending: false });
        products = data || [];
    } catch(e) {}

    if (!products.length) {
        return filterHTML + emptyDirectoryHTML('bx-store', 'MARKETPLACE', 'Las tiendas deportivas aparecerán aquí. ¡Pronto habrá productos disponibles!');
    }

    const grid = `<div id="products-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;">
        ${products.map(p => `
        <div class="tienda-product" data-cat="${p.category||'Otro'}" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;overflow:hidden;cursor:pointer;transition:.2s;" onmouseover="this.style.borderColor='rgba(186,255,0,0.3)'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
            <div style="height:130px;background:#111;overflow:hidden;">
                ${p.image_url ? `<img src="${p.image_url}" style="width:100%;height:100%;object-fit:cover;" onerror="this.parentElement.innerHTML='<i class=\\'bx bx-package\\' style=\\'font-size:36px;color:#333;margin:auto;display:flex;height:100%;align-items:center;justify-content:center;\\'></i>'">` : `<div style="height:100%;display:flex;align-items:center;justify-content:center;"><i class='bx bx-package' style="font-size:36px;color:#333;"></i></div>`}
            </div>
            <div style="padding:10px 12px;">
                <div style="font-weight:700;font-size:12px;margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${p.name||'Producto'}</div>
                <div style="font-size:11px;color:#888;margin-bottom:6px;">${p.seller_name||''}</div>
                <div style="font-weight:900;font-size:14px;color:var(--accent);margin-bottom:8px;">$${p.price||0} <span style="font-size:9px;color:#666;font-weight:400;">USD</span></div>
                ${p.buy_link ? `<a href="${p.buy_link}" target="_blank" rel="noopener" style="display:block;text-align:center;background:var(--accent);color:#000;padding:6px;border-radius:6px;font-size:10px;font-weight:900;text-decoration:none;text-transform:uppercase;">Consultar</a>` : ''}
            </div>
        </div>`).join('')}
    </div>`;

    return `<div style="padding-bottom:16px;">
        <h2 style="font-size:18px;font-weight:900;font-family:Outfit,sans-serif;margin-bottom:6px;">🛍 Marketplace</h2>
        <p style="font-size:12px;color:#888;margin-bottom:16px;">Productos deportivos de tiendas verificadas en Canchero.</p>
        ${filterHTML}${grid}
    </div>`;
}

window.filterProducts = function(cat) {
    document.querySelectorAll('.tienda-cat-btn').forEach(b => {
        const active = b.dataset.cat === cat;
        b.style.borderColor = active ? 'var(--accent)' : 'rgba(255,255,255,0.1)';
        b.style.background = active ? 'rgba(186,255,0,0.1)' : 'transparent';
        b.style.color = active ? 'var(--accent)' : '#888';
    });
    document.querySelectorAll('.tienda-product').forEach(p => {
        p.style.display = (cat === 'Todos' || p.dataset.cat === cat) ? '' : 'none';
    });
};

async function generateBizItemsHTML(type, icon, title, subtitle) {
    const SB_URL = 'https://dofbxgqzcvfjpnvcvdjb.supabase.co';
    const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc';
    let sb2 = null;
    try { sb2 = window.supabase ? window.supabase.createClient(SB_URL, SB_KEY) : null; } catch(e) {}
    if (!sb2) return emptyDirectoryHTML(icon, title, 'Sin conexión a Supabase.');

    try {
        const { data, error } = await sb2.from('biz_items').select('*').eq('type', type).eq('active', true).order('created_at', { ascending: false }).limit(40);
        const isEmpty = !data || data.length === 0;
        const catMap = { service: ['Todos','Árbitro','Entrenador','Preparador','Nutricionista','Kinesiólogo','Fotógrafo','Otro'], event: ['Todos','Torneo','Liga','Escuela','Otro'] };
        const cats = catMap[type] || [];
        return `
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; flex-wrap:wrap; gap:10px;">
            <div><h2 style="font-family:var(--font-display);font-size:22px;font-weight:900;color:var(--accent);">${title}</h2><p style="color:#888;font-size:12px;margin-top:4px;">${subtitle}</p></div>
        </div>
        ${cats.length ? `<div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">${cats.map((c,i) => `<button class="biz-cat-btn" onclick="filterBizItems(this,'${c}')" style="background:${i===0?'var(--accent)':'rgba(255,255,255,0.07)'};color:${i===0?'#000':'#fff'};border:none;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;">${c.toUpperCase()}</button>`).join('')}</div>` : ''}
        <div id="biz-items-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;">
        ${isEmpty ? `<div style="grid-column:1/-1;text-align:center;padding:48px;color:#555;"><i class='bx ${icon}' style="font-size:40px;display:block;margin-bottom:12px;opacity:0.3;"></i><p>Aún no hay ${type==='service'?'servicios':'eventos'} publicados.</p></div>` :
            data.map(item => {
                const p = item.payload || {};
                let badge = '';
                if (type === 'service' && p.categoria) badge = `<span style="background:rgba(79,195,247,0.15);color:#4fc3f7;font-size:9px;font-weight:800;padding:2px 7px;border-radius:10px;text-transform:uppercase;">${p.categoria}</span>`;
                if (type === 'event' && p.fecha) badge = `<span style="background:rgba(186,255,0,0.12);color:var(--accent);font-size:9px;font-weight:800;padding:2px 7px;border-radius:10px;">${p.fecha}</span>`;
                return `
                <div class="biz-item-card" data-cat="${(p.categoria||p.tipo||'otro').toLowerCase()}" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:14px;overflow:hidden;">
                    ${item.image_url ? `<div style="height:140px;background-image:url('${item.image_url}');background-size:cover;background-position:center;"></div>` : `<div style="height:100px;background:rgba(255,255,255,0.03);display:flex;align-items:center;justify-content:center;"><i class='bx ${icon}' style="font-size:36px;color:#333;"></i></div>`}
                    <div style="padding:14px;">
                        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;">
                            <div style="font-weight:700;font-size:14px;line-height:1.3;">${item.title}</div>
                            ${badge}
                        </div>
                        ${item.description ? `<p style="font-size:12px;color:#888;margin:0 0 10px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">${item.description}</p>` : ''}
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:13px;font-weight:900;color:var(--accent);">${item.price ? '$'+item.price+' USD' : 'Gratis'}</span>
                            ${type==='event'&&p.cupos ? `<span style="font-size:11px;color:#666;"><i class='bx bx-group'></i> ${p.cupos} cupos</span>` : ''}
                            ${type==='event'&&p.lugar ? `<span style="font-size:11px;color:#666;"><i class='bx bx-map'></i> ${p.lugar}</span>` : ''}
                        </div>
                        ${type==='service'&&p.whatsapp ? `<a href="${p.whatsapp}" target="_blank" style="display:block;margin-top:10px;text-align:center;background:rgba(37,211,102,0.15);color:#25d366;border:1px solid rgba(37,211,102,0.3);padding:7px;border-radius:10px;font-size:12px;font-weight:700;text-decoration:none;"><i class='bx bxl-whatsapp'></i> CONTACTAR</a>` : ''}
                    </div>
                </div>`;
            }).join('')}
        </div>`;
    } catch(e) {
        return emptyDirectoryHTML(icon, title, 'Error cargando datos: ' + e.message);
    }
}

// ── MODAL PÚBLICO DE DIRECTORIOS (funciona sin login) ──────────────────────────
window.openPublicDirectoryModal = async function(type) {
    let modal = document.getElementById('public-dir-modal');
    if (!modal) {
        modal = document.createElement('div');
        modal.id = 'public-dir-modal';
        modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:99999;overflow-y:auto;';
        modal.innerHTML = `
          <div style="max-width:900px;margin:0 auto;padding:24px 16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
              <img src="logo-oficial.png" style="height:44px;object-fit:contain;" onerror="this.src='logo.png'">
              <button onclick="document.getElementById('public-dir-modal').remove()" style="background:rgba(255,255,255,0.08);border:1px solid #333;color:#fff;padding:8px 18px;border-radius:10px;cursor:pointer;font-weight:700;font-size:13px;">✕ CERRAR</button>
            </div>
            <div id="public-dir-content" style="min-height:200px;"></div>
          </div>`;
        document.body.appendChild(modal);
        modal.addEventListener('click', e => { if (e.target === modal) modal.remove(); });
    }
    const content = document.getElementById('public-dir-content');
    content.innerHTML = `<div style="text-align:center;padding:40px;color:#555;"><i class='bx bx-loader-alt bx-spin' style="font-size:28px;"></i></div>`;
    const asyncTypes = ['tienda','servicios','eventos'];
    if (asyncTypes.includes(type)) {
        if (type === 'tienda') content.innerHTML = await generateTiendaHTML();
        else if (type === 'servicios') content.innerHTML = await generateBizItemsHTML('service','bx-briefcase','SERVICIOS PROFESIONALES','Árbitros, entrenadores, nutricionistas y más.');
        else if (type === 'eventos') content.innerHTML = await generateBizItemsHTML('event','bx-trophy','TORNEOS Y EVENTOS','Torneos, ligas y eventos deportivos.');
    } else {
        let html = '';
        if (type === 'jugadores') html = generateJugadoresFeedHTML();
        else if (type === 'complejos') html = generateComplejosFeedHTML();
        else if (type === 'clubes') html = generateClubesFeedHTML();
        else if (type === 'torneos') html = generateTorneosFeedHTML();
        content.innerHTML = html;
    }
};

// ── CLOUDINARY UPLOAD ──────────────────────────────────────────────────────────
// Configurar: crear cuenta en cloudinary.com, ir a Settings > Upload > Upload presets
// Crear un preset sin firma (unsigned) y completar estos datos:
window.CLOUDINARY_CLOUD_NAME = 'dpgvigyc3';
window.CLOUDINARY_UPLOAD_PRESET = 'canchero_upload';

window.uploadToCloudinary = async function(file, onProgress) {
    if (!file) return null;
    const cloudName = window.CLOUDINARY_CLOUD_NAME;
    const preset = window.CLOUDINARY_UPLOAD_PRESET;
    if (cloudName === 'TU_CLOUD_NAME') {
        // Fallback a Supabase Storage si Cloudinary no está configurado
        return null;
    }
    const formData = new FormData();
    formData.append('file', file);
    formData.append('upload_preset', preset);
    formData.append('folder', 'canchero');
    try {
        const xhr = new XMLHttpRequest();
        return await new Promise((resolve, reject) => {
            xhr.upload.onprogress = e => { if (onProgress && e.lengthComputable) onProgress(Math.round(e.loaded/e.total*100)); };
            xhr.onload = () => {
                const res = JSON.parse(xhr.responseText);
                resolve(res.secure_url || null);
            };
            xhr.onerror = () => reject(new Error('Error subiendo imagen'));
            xhr.open('POST', `https://api.cloudinary.com/v1_1/${cloudName}/upload`);
            xhr.send(formData);
        });
    } catch(e) { console.warn('Cloudinary error:', e); return null; }
};

// ── ANALYTICS TRACKING ────────────────────────────────────────────────────────
(function() {
    const SB_URL = 'https://dofbxgqzcvfjpnvcvdjb.supabase.co';
    const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvZmJ4Z3F6Y3ZmanBudmN2ZGpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDgwMDA5NTEsImV4cCI6MjA2MzU3Njk1MX0.v7XPPbmRDdHMTd7wECH_6h8smOSGSZDfp_-Q-7GxJzc';
    let anSb = null;
    try { anSb = window.supabase ? window.supabase.createClient(SB_URL, SB_KEY) : null; } catch(e) {}

    window.trackEvent = async function(eventType, metadata = {}) {
        if (!anSb) return;
        const userEmail = (window.userData && window.userData.email) || localStorage.getItem('canchero_email') || null;
        try {
            await anSb.from('analytics').insert({ event_type: eventType, user_email: userEmail, metadata });
        } catch(e) { /* tabla analytics puede no existir */ }
    };

    // Auto-track page views
    const _origNavigate = window.navigate;
    window.navigate = function(viewId) {
        if (_origNavigate) _origNavigate(viewId);
        window.trackEvent('page_view', { page: viewId });
    };
})();

window.filterBizItems = function(btn, cat) {
    document.querySelectorAll('.biz-cat-btn').forEach(b => { b.style.background='rgba(255,255,255,0.07)'; b.style.color='#fff'; });
    btn.style.background = 'var(--accent)'; btn.style.color = '#000';
    document.querySelectorAll('.biz-item-card').forEach(card => {
        card.style.display = (cat === 'Todos' || card.dataset.cat === cat.toLowerCase()) ? '' : 'none';
    });
};

function emptyDirectoryHTML(icon, title, subtitle) {
    return `<div style="text-align:center; padding:50px 20px;">
        <i class='bx ${icon}' style="font-size:52px; color:rgba(186,255,0,0.2); display:block; margin-bottom:15px;"></i>
        <h3 style="font-family:var(--font-display); color:rgba(255,255,255,0.3); font-size:16px; margin-bottom:8px;">${title}</h3>
        <p style="font-size:12px; color:#444; max-width:260px; margin:0 auto; line-height:1.6;">${subtitle}</p>
    </div>`;
}

function generateTorneosFeedHTML() {
    const stored = [];
    try { const d = JSON.parse(localStorage.getItem('canchero_torneos') || '[]'); stored.push(...d); } catch(e) {}
    if (stored.length === 0) return emptyDirectoryHTML('bx-trophy', 'SIN TORNEOS AÚN', 'Cuando se creen torneos en la plataforma aparecerán aquí.');
    return `<div class="social-feed-grid">${stored.map(t => `
        <div class="post-card" style="cursor:pointer;">
            <div style="height:100px; background:#111; border-radius:8px; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">
                <i class='bx bx-trophy' style="font-size:40px; color:var(--accent);"></i>
            </div>
            <h4 style="color:var(--accent); font-size:13px;">${(t.name||'TORNEO').toUpperCase()}</h4>
            <p style="font-size:11px; color:#888;">${t.city || 'Uruguay'}</p>
        </div>
    `).join('')}</div>`;
}

function generateComplejosFeedHTML() {
    const stored = [];
    try { const d = JSON.parse(localStorage.getItem('canchero_complexes') || '[]'); stored.push(...d); } catch(e) {}
    // Include current user if they are an approved complex
    const savedUser = (() => { try { return JSON.parse(localStorage.getItem('canchero_user') || 'null'); } catch(e) { return null; } })();
    if (savedUser && savedUser.role === 'club' && savedUser.isComplexApproved && savedUser.complexData) {
        stored.unshift(savedUser);
    }
    if (stored.length === 0) return emptyDirectoryHTML('bx-building-house', 'SIN COMPLEJOS REGISTRADOS', 'Los complejos aprobados aparecerán aquí. Registrá el tuyo.');
    return `<div class="social-feed-grid">${stored.slice(0,20).map(c => {
        const cd = c.complexData || c;
        const cName = (cd.complexName || c.name || 'Complejo').toUpperCase();
        const cCity = c.city || (cd.address ? cd.address.split(' ')[0] : 'Uruguay');
        return `<div class="post-card" style="cursor:pointer;">
            <div style="width:100%;height:80px;background:#111;border-radius:8px;margin-bottom:10px;display:flex;align-items:center;justify-content:center;border:1px solid #222;">
                <i class='bx bx-building-house' style="font-size:34px;color:var(--accent);"></i>
            </div>
            <h4 style="font-size:13px;margin-bottom:4px;">${cName}</h4>
            <p style="font-size:11px;color:#888;margin:0;">${cCity}</p>
        </div>`;
    }).join('')}</div>`;
}

function generateClubesFeedHTML() {
    const stored = JSON.parse(localStorage.getItem('canchero_mis_clubes') || '[]');
    if (stored.length === 0) return emptyDirectoryHTML('bx-shield', 'SIN EQUIPOS REGISTRADOS', 'Los equipos creados por los jugadores aparecerán aquí.');
    return `<div class="social-feed-grid">${stored.slice(0,20).map(c => `
        <div class="post-card" style="cursor:pointer;">
            <div style="width:70px;height:70px;background:#000;border:2px solid var(--accent);border-radius:10px;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;">
                ${c.logo ? `<img src="${c.logo}" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">` : `<i class='bx bxs-shield' style="font-size:34px;color:var(--accent);"></i>`}
            </div>
            <h4 style="text-align:center;font-size:13px;">${(c.name||'EQUIPO').toUpperCase()}</h4>
            <p style="font-size:11px;color:#888;text-align:center;margin:0;">${c.city || 'Uruguay'} · ${c.members || 1} jugador${(c.members||1)===1?'':'es'}</p>
        </div>
    `).join('')}</div>`;
}

function generateJugadoresFeedHTML() {
    const allUsers = [];
    try {
        const u = JSON.parse(localStorage.getItem('canchero_user') || 'null');
        if (u && u.role === 'jugador') allUsers.push(u);
        const others = JSON.parse(localStorage.getItem('canchero_all_players') || '[]');
        allUsers.push(...others);
    } catch(e) {}
    if (allUsers.length === 0) return emptyDirectoryHTML('bx-run', 'SIN JUGADORES REGISTRADOS', 'Los jugadores que se registren en Canchero aparecerán aquí.');
    return `<div class="social-feed-grid">${allUsers.slice(0,20).map(p => `
        <div class="post-card" style="cursor:pointer;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:50px;height:50px;border-radius:50%;background:var(--accent);color:#000;font-weight:900;font-size:18px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
                    ${p.photo && !p.photo.includes('ui-avatars') ? `<img src="${p.photo}" style="width:100%;height:100%;object-fit:cover;">` : (p.name||'?')[0]}
                </div>
                <div>
                    <h4 style="margin:0;font-size:13px;">${(p.name||'JUGADOR').toUpperCase()}</h4>
                    <p style="font-size:11px;color:var(--accent);margin:2px 0 0;">${p.pos||'Jugador'} · Rating ${p.stats?.rating || 60}</p>
                    <p style="font-size:10px;color:#666;margin:0;">${p.city||'Uruguay'}</p>
                </div>
            </div>
        </div>
    `).join('')}</div>`;
}

window.viewComplexProfile = function(id) {
    const all = UY.flatMap((_, di) => genComplexes(di));
    const c = all.find(x => x.id === id) || {};
    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
    const content = document.getElementById(dashboard + '-global-viewer-content');
    if (!content) return;
    if(typeof switchDashboardTab === 'function') switchDashboardTab(dashboard, 'global-viewer');
    content.innerHTML = `
        <button class="btn btn-outline" style="margin-bottom:15px;" onclick="openGlobalDirectory('complejos')"><i class='bx bx-left-arrow-alt'></i> VOLVER</button>
        <div class="social-profile">
            <div class="cover-photo" style="background:linear-gradient(135deg,#111,#1c1c1c);display:flex;align-items:center;justify-content:center;">
                <i class='bx bx-building-house' style="font-size:80px;color:var(--accent);opacity:0.5;"></i>
            </div>
            <div style="padding:20px;">
                <h2 style="color:var(--accent);">${(c.name||'Complejo').toUpperCase()}</h2>
                <p style="color:#888;font-size:13px;">${c.city || 'Uruguay'} · Piso ${c.piso || 'Sintético'}</p>
                <div class="grid-3" style="margin:20px 0;">
                    <div class="stat-box"><h4>${c.canchas||2}</h4><p>Canchas</p></div>
                    <div class="stat-box"><h4>$${c.precio||400}/h</h4><p>Precio</p></div>
                    <div class="stat-box"><h4>⭐ ${c.rating||4.2}</h4><p>Rating</p></div>
                </div>
                <button class="btn btn-primary" style="width:100%;" onclick="alert('Reserva enviada. El complejo te contactará pronto.')">RESERVAR CANCHA</button>
            </div>
        </div>
    `;
};

window.viewTorneoProfile = function(id) {
    const dashboard = userData && userData.role === 'club' ? 'club' : 'jugador';
