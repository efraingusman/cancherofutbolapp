// ============================================================
// GOOGLE AUTH
// ============================================================
window.handleGoogleAuth = async function() {
    if (!supabase) { showToast('Error de conexión con el servidor.', 'error'); return; }
    try {
        const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
                redirectTo: window.location.origin + window.location.pathname,
                queryParams: { access_type: 'offline', prompt: 'consent' }
            }
        });
        if (error) throw error;
    } catch(e) {
        const msg = e.message || '';
        if (msg.toLowerCase().includes('provider is not enabled') || msg.toLowerCase().includes('unsupported provider')) {
            showToast('Google login no está activado en Supabase. Mientras tanto, usá email/contraseña.', 'warning');
        } else {
            showToast('Error con Google: ' + (msg || 'Intentá con email/contraseña.'), 'error');
        }
    }
};

// Handle OAuth redirect callback
if (supabase) {
    supabase.auth.onAuthStateChange(async (event, session) => {
        if (event === 'SIGNED_IN' && session?.user) {
            const user = session.user;
            const saved = localStorage.getItem('canchero_user');
            if (saved) {
                const u = JSON.parse(saved);
                if (u.email === user.email) {
                    userData = u;
                    applyUserData();
                    navigate(userData.role || 'jugador');
                    return;
                }
            }
            // Admin check — Google login con cuenta admin → panel admin directo
            if (user.email === 'neurovidstudioia@gmail.com') {
                userData = { name: 'SUPER ADMIN', email: user.email, role: 'admin' };
                localStorage.setItem('canchero_user', JSON.stringify(userData));
                applyUserData();
                navigate('admin');
                return;
            }
            // New Google user — show role selection
            showGoogleRoleModal(user);
        }
    });
}

let googleAuthUser = null;
let googleSelectedRole = 'jugador';

function showGoogleRoleModal(user) {
    googleAuthUser = user;
    const modal = document.getElementById('google-role-modal');
    if (modal) {
        modal.style.display = 'flex';
        // Reset selection
        modal.querySelectorAll('.type-card').forEach(c => c.classList.remove('active'));
        const first = modal.querySelector('[data-role="jugador"], .type-card');
        if (first) first.classList.add('active');
        googleSelectedRole = 'jugador';
    }
}

window.selectGoogleRole = function(role, el) {
    googleSelectedRole = role;
    const grid = document.getElementById('google-role-grid');
    if (grid) grid.querySelectorAll('.type-card').forEach(c => c.classList.remove('active'));
    if (el) el.classList.add('active');
};

window.confirmGoogleRole = function() {
    if (!googleAuthUser) return;
    const modal = document.getElementById('google-role-modal');
    if (modal) modal.style.display = 'none';

    const isPaid = ['club','profesional','organizacion','tienda','sponsor'].includes(googleSelectedRole);

    userData = {
        name: googleAuthUser.user_metadata?.full_name || googleAuthUser.email.split('@')[0],
        email: googleAuthUser.email,
        photo: googleAuthUser.user_metadata?.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(googleAuthUser.email)}&background=000&color=baff00`,
        role: googleSelectedRole,
        registeredRoles: [googleSelectedRole],
        isComplexApproved: !isPaid,
        stats: { goals: 0, assists: 0, matches: 0, mvp: 0, rating: 60 },
        points: 100,
        level: 'Amateur',
        clubs: [],
        createdAt: Date.now()
    };
    localStorage.setItem('canchero_user', JSON.stringify(userData));

    if (isPaid) {
        showTermsModal(() => showPlanModal());
    } else {
        applyUserData();
        navigate('jugador');
    }
};

